---
// Page-style header layout
import Search from "@pelagornis/page/overrides/Search.astro";
import ChatButton from "./ChatButton.astro";
import SocialIcons from "@pelagornis/page/overrides/SocialIcons.astro";

const showChat = true; // docChat is enabled via pagePlugin config
import MobileMenuToggle from "@pelagornis/page/overrides/MobileMenuToggle.astro";
import LanguageSelect from "@pelagornis/page/overrides/LanguageSelect.astro";
import ThemeSelect from "@pelagornis/page/overrides/ThemeSelect.astro";
import config from "virtual:starlight/user-config";
import { hasCurriculumSidebar } from "../lib/route";

// Build path considering locale
function localizedPath(path: string): string {
  const currentLocale = Astro.locals.starlightRoute?.locale;

  // If no currentLocale or 'en', return path without locale
  if (!currentLocale || currentLocale === config.defaultLocale.locale) {
    return path;
  }

  // For other locales, return path with locale prefix
  return `/${currentLocale}${path}`;
}

// Navigation comes from src/config/navigation.json, the same file that feeds
// Starlight's sidebar — not from process.env.PAGE_NAVIGATION, which this
// component used to read. That variable is never set anywhere in the repo, so
// the parse always yielded undefined and the whole <nav> was skipped: the
// header has been rendering a logo, a void, and four icons on every page.
import navigationConfig from "../config/navigation.json";

const { primary, menus } = navigationConfig.header;

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

// Only curriculum routes get the left rail (see src/lib/route.ts), and only
// they need the mobile hamburger that opens it. The site title is no longer
// conditional on this: the rail starts below the header now, so it never
// covers this corner and the title simply always renders here.
const hasSidebar = hasCurriculumSidebar(Astro.url.pathname);
const CHEVRON = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 4.5 6 7.5 9 4.5"/></svg>`;
const ARROW = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" y1="7" x2="11" y2="7"/><polyline points="7.5 3.5 11 7 7.5 10.5"/></svg>`;
---

<div class="page-header">
  <div class="page-header-container">
    <div class="page-header-left">
      <!-- Page-style site title -->
      <a href={siteTitleHref} class="page-site-title">
        <svg
          class="logo-size logo-cell"
          viewBox="0 0 108 108"
          width="32"
          height="32"
          role="img"
          aria-label={siteTitle}
        >
          <rect class="logo-cell-bg" x="0" y="0" width="108" height="108" rx="24" ry="24" />
          <text class="logo-cell-fg" x="31" y="40" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="8">01</text>
          <text class="logo-cell-fg" x="54" y="67" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="33">De</text>
          <text class="logo-cell-fg" x="54" y="79.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="5.6" letter-spacing="0.8">DATA ENG</text>
        </svg>
        <span class="page-title-text">{siteTitle}</span>
      </a>

      <!-- Top-level navigation. The two sections with more than a handful of
           destinations (50 roadmaps, 29 question topics) open a panel rather
           than trying to fit in the bar or hiding in a 320px accordion. -->
      <nav class="page-nav" aria-label="Main">
        {
          primary.map((item) => {
            const menu = item.menu ? menus[item.menu as keyof typeof menus] : null;
            const match = item.match.join(",");
            if (!menu) {
              return (
                <a href={localizedPath(item.href)} class="page-nav-link" data-match={match}>
                  {item.label}
                </a>
              );
            }
            return (
              <div class="nav-group" data-menu={item.menu}>
                <a
                  href={localizedPath(item.href)}
                  class="page-nav-link nav-group-trigger"
                  data-match={match}
                  aria-haspopup="true"
                >
                  {item.label}
                  <span class="nav-group-chevron" set:html={CHEVRON} />
                </a>

                <div class="nav-panel" data-panel={item.menu}>
                  <div class="nav-panel-inner">
                    {"featured" in menu && menu.featured && (
                      <a class="nav-featured" href={localizedPath(menu.featured.href)}>
                        <span class="nav-featured-meta">{menu.featured.meta}</span>
                        <span class="nav-featured-title">{menu.featured.label}</span>
                        <span class="nav-featured-blurb">{menu.featured.blurb}</span>
                        <span class="nav-featured-go" set:html={ARROW} />
                      </a>
                    )}

                    <div class="nav-cols">
                      {menu.groups.map((group) => (
                        <div class="nav-col">
                          <p class="nav-col-head">
                            {"id" in group && group.id && (
                              <span class="nav-col-id">{group.id}</span>
                            )}
                            {"href" in group && group.href ? (
                              <a class="nav-col-label" href={localizedPath(group.href)}>
                                {group.label}
                              </a>
                            ) : (
                              <span class="nav-col-label">{group.label}</span>
                            )}
                          </p>
                          <ul class="nav-col-list">
                            {group.items.map((link) => (
                              <li>
                                <a class="nav-link" href={localizedPath(link.href)}>
                                  {link.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>

                  {"more" in menu && menu.more && (
                    <a class="nav-panel-more" href={localizedPath(menu.more.href)}>
                      {menu.more.label}
                      <span set:html={ARROW} />
                    </a>
                  )}
                </div>
              </div>
            );
          })
        }
      </nav>
    </div>

    <div class="page-header-right">
      <!-- Page-style search -->
      <div class="page-search-wrapper">
        <Search />
      </div>
      {showChat && <ChatButton />}

      <!-- Page-style theme toggle -->
      <ThemeSelect />

      <!-- Page-style language select -->
      <LanguageSelect />

      <!-- Page-style social links -->
      <SocialIcons />

      <!-- Page-style mobile menu toggle -->
      {hasSidebar && <MobileMenuToggle />}
    </div>
  </div>
</div>

<script>
  // Store event listener refs in module scope
  let isInitialized = false;
  let themeToggleHandler: (() => void) | null = null;
  let astroPageLoadHandler: (() => void) | null = null;

  // Page-style theme toggle (replaced by ThemeSelect component)
  function initpageThemeToggle() {
    // ThemeSelect handles theme toggle; here we only run init
    // Add extra logic here if needed
  }

  /* Active section, matched against the prefixes a nav item owns (data-match,
     from navigation.json) rather than against its own href.

     Those differ on purpose. "Questions" links to /level-1-foundations/sql/,
     because a leaf topic is the sensible place to land someone — but the
     section it stands for is four separate level-* trees. Testing
     currentPath.startsWith(href), as this did, lit the tab on exactly one of
     the 29 question topics and left it dark on the other 28. */
  function setpageActiveNavLink() {
    const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";

    document.querySelectorAll(".page-nav-link").forEach((link) => {
      link.classList.remove("active");

      const raw = link.getAttribute("data-match");
      if (!raw) return;

      const isActive = raw.split(",").some((prefix) => {
        const p = prefix.replace(/\/+$/, "");
        if (!p) return false;
        // Guard with "/" so /projects can't claim /projects-archive.
        return currentPath === p || currentPath.startsWith(`${p}/`);
      });

      if (isActive) link.classList.add("active");
    });
  }

  /* @pelagornis/page stamps data-theme onto elements inside the document —
     <body>, .page-header, .page-footer-container, .page-mobile-menu-overlay,
     its <page-select> — and never updates them again. Starlight's theme
     toggle only ever writes to <html>, so switching themes left those stale:
     <html data-theme="light"> above <body data-theme="dark">, with the
     vendor's own `[data-theme="dark"] body { ... !important }` rules still
     matching and painting dark-mode background and text under a light-mode
     page. Mirroring the root's value onto every carrier makes the vendor's
     rules agree with the theme actually in effect instead of contradicting
     it. See src/styles/theme.css for the token-level half of this. */
  function syncThemeCarriers() {
    const theme = document.documentElement.getAttribute("data-theme");
    if (!theme) return;
    document.querySelectorAll("[data-theme]").forEach((el) => {
      if (el === document.documentElement) return;
      // Guard the write: setAttribute fires the observer below even when the
      // value is unchanged, which would loop.
      if (el.getAttribute("data-theme") !== theme) {
        el.setAttribute("data-theme", theme);
      }
    });
  }

  // Logo theme change
  function updateLogo() {
    const logo = document.querySelector(".page-logo") as HTMLImageElement;
    if (!logo) return;

    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    const logoLight = logo.dataset.logoLight;
    const logoDark = logo.dataset.logoDark;

    if (logoDark && isDark) {
      logo.src = logoDark;
    } else if (logoLight && !isDark) {
      logo.src = logoLight;
    }
  }

  // Init function
  function initializeHeader() {
    // Prevent duplicate initialization
    if (isInitialized) {
      return;
    }

    initpageThemeToggle();
    setpageActiveNavLink();
    updateLogo();
    syncThemeCarriers();

    // Listen for theme change. Watching the whole subtree (filtered to the one
    // attribute) rather than just documentElement, because the vendor stamps
    // its carriers during its own init — which can land after this runs, and
    // would otherwise stay stale until the next toggle.
    const observer = new MutationObserver((mutations) => {
      let rootChanged = false;
      let carrierChanged = false;
      mutations.forEach((mutation) => {
        if (mutation.type !== "attributes" || mutation.attributeName !== "data-theme") return;
        if (mutation.target === document.documentElement) rootChanged = true;
        else carrierChanged = true;
      });
      if (rootChanged) updateLogo();
      if (rootChanged || carrierChanged) syncThemeCarriers();
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
      subtree: true,
    });

    isInitialized = true;
  }

  // Cleanup function
  function cleanup() {
    const toggleButton = document.getElementById(
      "page-theme-toggle",
    ) as HTMLButtonElement;

    if (toggleButton && themeToggleHandler) {
      toggleButton.removeEventListener("click", themeToggleHandler);
      themeToggleHandler = null;
    }

    if (astroPageLoadHandler) {
      document.removeEventListener("astro:page-load", astroPageLoadHandler);
      astroPageLoadHandler = null;
    }

    isInitialized = false;
  }

  // Initialize
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeHeader);
  } else {
    initializeHeader();
  }

  // Run on Astro page change too (after cleaning existing listeners)
  if (!astroPageLoadHandler) {
    astroPageLoadHandler = () => {
      cleanup();
      initializeHeader();
    };
    document.addEventListener("astro:page-load", astroPageLoadHandler);
  }

  // Cleanup on page unload
  window.addEventListener("beforeunload", cleanup);
</script>

<style>
  /* Page-style header — same flat, hairline-bordered surface as the sidebar
     and TOC (.ds-panel's recipe), not a glass/blur treatment found nowhere
     else in the app. */
  .page-header {
    position: relative;
    top: 0;
    left: 0;
    right: 0;
    height: var(--page-header-height);
    background: var(--page-bg-secondary);
    border-bottom: var(--ds-border-w) solid var(--page-border);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-header-container {
    max-width: 1440px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--page-space-8);
  }

  .page-header-left {
    display: flex;
    align-items: center;
    gap: var(--page-space-10);
  }

  .page-header-right {
    display: flex;
    align-items: center;
    gap: var(--page-space-2);
    /* Never give up width to the nav — on mobile the nav is a scrolling
       strip, and a shrinking icon cluster let it slide underneath. */
    flex-shrink: 0;
  }

  /* Nav icon buttons: same 40x40 as SocialIcons (Slack etc), icon 20px */
  .page-header-right .page-search-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-header-right page-select,
  .page-header-right .page-language-select {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-header-right .page-theme-toggle-button,
  .page-header-right .page-search-button,
  .page-header-right .page-chat-button,
  .page-header-right .page-language-select-button,
  .page-header-right .page-mobile-menu-toggle {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    min-height: 40px !important;
    padding: var(--page-space-3) !important;
    border: none !important;
    border-radius: var(--page-radius-lg) !important;
    background: var(--page-accent-light) !important;
    color: var(--page-text-secondary) !important;
    box-sizing: border-box !important;
  }

  .page-header-right .page-theme-toggle-button:hover,
  .page-header-right .page-search-button:hover,
  .page-header-right .page-chat-button:hover,
  .page-header-right .page-language-select-button:hover,
  .page-header-right .page-mobile-menu-toggle:hover {
    background: var(--page-text-reverse) !important;
    color: var(--page-text) !important;
    transform: translateY(-1px) !important;
    box-shadow: var(--page-shadow-sm) !important;
  }

  /* RefineUI (font icon) glyphs appear small; use 24px to match Slack (SVG) */
  .page-header-right .page-theme-toggle-button span,
  .page-header-right .page-theme-toggle-button .refineui-icon,
  .page-header-right .page-search-button span,
  .page-header-right .page-search-button .refineui-icon,
  .page-header-right .page-chat-button span,
  .page-header-right .page-chat-button .refineui-icon,
  .page-header-right .page-language-select-button span,
  .page-header-right .page-language-select-button .refineui-icon,
  .page-header-right .page-mobile-menu-toggle span,
  .page-header-right .page-mobile-menu-toggle .refineui-icon {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    flex-shrink: 0;
    font-size: 24px !important;
    line-height: 1 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .page-header-right .page-search-button svg,
  .page-header-right .page-chat-button svg,
  .page-header-right .page-theme-toggle-button svg,
  .page-header-right .page-language-select-button svg,
  .page-header-right .page-mobile-menu-toggle svg {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    flex-shrink: 0;
  }

  /* SocialIcons (Slack, GitHub) SVG also 24px */
  .page-header-right a svg {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
  }

  /* Site title, on every route and at every width. It used to be hidden at
     ≥769px and re-rendered inside the sidebar, because the rail covered this
     corner of the header — two copies of one mark, kept in sync by hand,
     each with its own visibility rules. The rail now starts below the header
     (TwoColumnContent.astro), so there is one title in one place. */
  .page-site-title {
    display: flex;
    align-items: center;
    gap: var(--page-space-3);
    flex-shrink: 0;
    text-decoration: none;
    color: var(--page-text);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.15;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  /* Between 769px and 1180px the bar holds the title, five nav sections and
     four icon controls — past that point the wordmark is what gives, since
     the logo alone still gets you home and the nav does not degrade. */
  @media (min-width: 769px) and (max-width: 1180px) {
    .page-title-text {
      display: none;
    }
  }

  .page-site-title:hover {
    opacity: 0.7;
  }

  .page-logo {
    width: 32px;
    height: 32px;
    border-radius: var(--page-radius-sm);
  }

  /* Starlight logo-size class style */
  .logo-size {
    width: 32px;
    height: 32px;
    border-radius: var(--page-radius-sm);
  }

  /* Logo mark: one inline SVG instead of separate light/dark PNGs — the
     rounded-cell shape is self-contained in the SVG's own <rect>, so only
     its two fill colors need setting here. Orange stays orange regardless
     of site theme (it's a single per-page brand mark, not a repeated
     element), but --sl-color-accent already resolves to the correct
     light/dark shade on its own. */
  .logo-cell-bg {
    fill: var(--sl-color-accent);
  }

  .logo-cell-fg {
    fill: #fff;
  }

  .page-title-text {
    font-family: var(--page-font-family);
    letter-spacing: -0.02em;
  }

  /* Page-style navigation */
  .page-nav {
    display: flex;
    align-items: center;
    gap: var(--page-space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Section panels ────────────────────────────────────────────────────
     Roadmaps and Questions each have far too many destinations for a nav
     bar (50 and 29), and the 320px accordion they used to hide in made a
     50-item list something you scrolled rather than scanned. A panel gives
     them their real shape: grouped columns, all visible at once.

     Opened on hover and on :focus-within, so the whole thing is reachable
     by keyboard with no JS — and every trigger is a real link to a real
     landing page, so a tap on touch (where hover doesn't exist) navigates
     somewhere useful instead of doing nothing. */
  .nav-group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-group-trigger {
    gap: var(--page-space-1);
  }

  .nav-group-chevron {
    display: flex;
    color: var(--page-text-muted);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .nav-group:hover .nav-group-chevron,
  .nav-group:focus-within .nav-group-chevron {
    color: inherit;
    transform: rotate(180deg);
  }

  .nav-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 200;
    width: max-content;
    max-width: min(64rem, calc(100vw - 3rem));
    background: var(--page-bg-elevated);
    border: var(--ds-border-w) solid var(--page-border);
    border-radius: var(--page-radius-lg);
    box-shadow: var(--page-shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }

  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* The trigger and its panel are separated by a 0.5rem gap; without
     something spanning it the pointer leaves both on the way down and the
     panel closes mid-travel. */
  .nav-panel::before {
    content: "";
    position: absolute;
    inset: -0.5rem 0 auto 0;
    height: 0.5rem;
  }

  .nav-panel-inner {
    display: flex;
    gap: var(--page-space-8);
    padding: var(--page-space-6);
  }

  .nav-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(9.5rem, 1fr));
    gap: var(--page-space-6) var(--page-space-8);
  }

  /* Column heads carry the curriculum's stage number where the content
     genuinely is a sequence (Questions: 01 Foundations → 04 Advanced) and
     omit it where it isn't (Roadmaps, which are peers you pick between). */
  .nav-col-head {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0 0 var(--page-space-3);
    padding-bottom: var(--page-space-2);
    border-bottom: var(--ds-border-w) solid var(--page-border);
  }

  .nav-col-id {
    font-family: var(--brand-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--sl-color-accent);
  }

  .nav-col-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--page-text-muted);
    text-decoration: none;
  }

  a.nav-col-label:hover {
    color: var(--page-text);
  }

  .nav-col-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-panel .nav-link {
    display: block;
    padding: 0.3rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--page-radius-md);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--page-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.12s ease, background 0.12s ease;
  }

  .nav-panel .nav-link:hover {
    color: var(--page-text);
    background: var(--page-accent-light);
  }

  /* The master roadmap is the site's front door — 123 nodes, all but five
     linked to real questions — so it gets picked out of the list rather
     than sorted alphabetically into it. */
  .nav-featured {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 15rem;
    flex-shrink: 0;
    padding: var(--page-space-5);
    border: var(--ds-border-w) solid var(--page-border);
    border-left: var(--ds-accent-edge-w) solid var(--sl-color-accent);
    border-radius: var(--page-radius-lg);
    background: var(--page-bg-secondary);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .nav-featured:hover {
    border-color: var(--sl-color-accent);
  }

  .nav-featured-meta {
    font-family: var(--brand-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }

  .nav-featured-title {
    font-family: var(--brand-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--page-text);
  }

  .nav-featured-blurb {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--page-text-muted);
  }

  .nav-featured-go {
    display: flex;
    margin-top: auto;
    padding-top: var(--page-space-3);
    color: var(--sl-color-accent);
  }

  .nav-panel-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: var(--page-space-3);
    border-top: var(--ds-border-w) solid var(--page-border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--page-text-secondary);
    text-decoration: none;
    transition: color 0.12s ease, background 0.12s ease;
  }

  .nav-panel-more:hover {
    color: var(--sl-color-accent);
    background: var(--page-accent-light);
  }

