---
import SidebarSublist from "./SidebarSublist.astro";

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="page-sidebar">
  <div class="page-sidebar-container">
    <SidebarSublist sublist={sidebar} />
  </div>
</div>

<style>
  /* Just the scrolling nav list now. This panel used to carry its own header
     row with a second copy of the site title, because the rail spanned the
     full viewport height and covered the real header's left column — so the
     title had to be re-rendered here to stay visible. The rail now starts
     below the header (see TwoColumnContent.astro), which leaves the header
     an unbroken bar for the site title and the nav, and leaves this panel
     one job. */
  .page-sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--page-bg-secondary);
  }

  .page-sidebar-container {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    padding: var(--page-space-6);
    gap: var(--page-space-8);
    flex-direction: column;
    display: flex;
  }

  .page-sidebar-container::-webkit-scrollbar {
    width: 0 !important;
    height: 0 !important;
    display: none !important;
  }

  .page-sidebar-container::-webkit-scrollbar-track {
    display: none !important;
    background: transparent !important;
  }

  .page-sidebar-container::-webkit-scrollbar-thumb {
    display: none !important;
    background: transparent !important;
  }

  .page-sidebar-container::-webkit-scrollbar-corner {
    display: none !important;
    background: transparent !important;
  }
</style>
