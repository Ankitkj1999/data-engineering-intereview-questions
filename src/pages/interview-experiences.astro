---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import data from "../data/interview-resources.json";

type Resource = {
  id: string; kind: string; medium: string; title: string; author: string;
  url: string; company: string | null; topics: string[]; count?: number; note?: string;
};

const resources = data.resources as Resource[];
const companies = data.companies as { slug: string; name: string; rounds: unknown[]; commonTopics: string[]; summaryStatus: string }[];
const creators = data.creators as { name: string; url: string; bio: string }[];

// Videos before articles — video is the more engaging format, so it leads.
const MEDIUM_ORDER: Record<string, number> = { video: 0, playlist: 1, article: 2 };
const byMedium = (a: Resource, b: Resource) =>
  (MEDIUM_ORDER[a.medium] ?? 9) - (MEDIUM_ORDER[b.medium] ?? 9) || a.title.localeCompare(b.title);

const byCompany = companies
  .map((c) => ({ ...c, items: resources.filter((r) => r.company === c.slug).sort(byMedium) }))
  .filter((c) => c.items.length > 0)
  .sort((a, b) => b.items.length - a.items.length);

const mocks = resources.filter((r) => r.kind === "mock" && !r.company).sort(byMedium);
const guides = resources.filter((r) => r.kind === "guide" && !r.company).sort(byMedium);

// topic slug -> where that topic lives on this site
const TOPIC_LINKS: Record<string, { label: string; href: string }> = {
  sql: { label: "SQL", href: "/level-1-foundations/sql/theory/" },
  spark: { label: "Spark", href: "/level-3-technologies/batch-processing/spark/" },
  kafka: { label: "Kafka", href: "/level-3-technologies/streaming/kafka/" },
  aws: { label: "AWS", href: "/level-3-technologies/cloud/aws/" },
  "system-design": { label: "System Design", href: "/level-4-advanced/system-design/" },
  "data-structures": { label: "Data Structures", href: "/level-1-foundations/data-structure/" },
};

const allTopics = [...new Set(resources.flatMap((r) => r.topics))].filter((t) => TOPIC_LINKS[t]).sort();
const counts = {
  total: resources.length,
  experience: resources.filter((r) => r.kind === "experience").length,
  mock: mocks.length,
  guide: guides.length,
};
---

<StarlightPage frontmatter={{ title: "Interview Experiences", description: "Curated recorded interview experiences, mock interviews and preparation guides for data engineering roles." }}>
  <div class="ie-root">
    <p class="ie-lede">
      Recorded interviews and preparation material, curated rather than scraped.
      <strong>{counts.total}</strong> resources — {counts.experience} company experiences,
      {counts.mock} mock interviews, {counts.guide} guides.
    </p>

    {allTopics.length > 0 && (
      <div class="ie-topics">
        <span class="ie-topics-label">Topics covered</span>
        {allTopics.map((t) => (
          <a class="ie-chip" href={TOPIC_LINKS[t].href}>{TOPIC_LINKS[t].label}</a>
        ))}
      </div>
    )}

    <h2 id="by-company">By company</h2>
    <p class="ie-note">
      Company tagging is manual and still thin — most recorded material is unbranded mock
      interviews, which are in the next section. Companies appear here only when a source
      names them.
    </p>

    <div class="ie-companies">
      {byCompany.map((c) => (
        <section class="ie-company">
          <header class="ie-company-head">
            <h3 id={`company-${c.slug}`}>{c.name}</h3>
            <span class="ie-count">{c.items.length} {c.items.length === 1 ? "source" : "sources"}</span>
          </header>

          {c.rounds.length === 0 && (
            <p class="ie-empty">
              No round-by-round breakdown written yet — that needs someone to watch the
              sources and summarise the loop.
            </p>
          )}

          <ul class="ie-list">
            {c.items.map((r) => (
              <li class="ie-item">
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  <span class="ie-medium" data-medium={r.medium}>{r.medium === "article" ? "Read" : "Watch"}</span>
                  <span class="ie-title">{r.title}</span>
                </a>
                <span class="ie-meta">
                  {r.author && <span>{r.author}</span>}
                  {r.count && <span>{r.count} videos</span>}
                  {r.topics.filter((t) => TOPIC_LINKS[t]).map((t) => (
                    <a class="ie-chip ie-chip-sm" href={TOPIC_LINKS[t].href}>{TOPIC_LINKS[t].label}</a>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <h2 id="mock-interviews">Mock interviews</h2>
    <p class="ie-note">Full and partial loops recorded end to end — the closest thing to sitting in one.</p>
    <ul class="ie-list ie-list-lg">
      {mocks.map((r) => (
        <li class="ie-item">
          <a href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="ie-medium" data-medium={r.medium}>{r.medium === "playlist" ? "Playlist" : "Watch"}</span>
            <span class="ie-title">{r.title}</span>
          </a>
          <span class="ie-meta">
            {r.author && <span>{r.author}</span>}
            {r.count && <span><strong>{r.count} videos</strong></span>}
            {r.topics.filter((t) => TOPIC_LINKS[t]).map((t) => (
              <a class="ie-chip ie-chip-sm" href={TOPIC_LINKS[t].href}>{TOPIC_LINKS[t].label}</a>
            ))}
          </span>
          {r.note && <p class="ie-item-note">{r.note}</p>}
        </li>
      ))}
    </ul>

    <h2 id="guides">Guides & question compilations</h2>
    <p class="ie-note">Preparation strategy, round breakdowns and worked question sets.</p>
    <ul class="ie-list ie-list-lg">
      {guides.map((r) => (
        <li class="ie-item">
          <a href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="ie-medium" data-medium={r.medium}>{r.medium === "playlist" ? "Playlist" : "Watch"}</span>
            <span class="ie-title">{r.title}</span>
          </a>
          <span class="ie-meta">
            {r.author && <span>{r.author}</span>}
            {r.count && <span><strong>{r.count} videos</strong></span>}
            {r.topics.filter((t) => TOPIC_LINKS[t]).map((t) => (
              <a class="ie-chip ie-chip-sm" href={TOPIC_LINKS[t].href}>{TOPIC_LINKS[t].label}</a>
            ))}
          </span>
          {r.note && <p class="ie-item-note">{r.note}</p>}
        </li>
      ))}
    </ul>

    <h2 id="creators">Creators worth following</h2>
    <ul class="ie-creators">
      {creators.map((c) => (
        <li>
          <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
          <span>{c.bio}</span>
        </li>
      ))}
    </ul>
  </div>
</StarlightPage>

<style>
  .ie-lede { font-size: 1.05rem; }
  .ie-note { color: var(--sl-color-gray-3); font-size: 0.9rem; margin-top: -0.4rem; }
  .ie-empty {
    color: var(--sl-color-gray-3); font-size: 0.85rem; font-style: italic;
    margin: 0 0 0.6rem; padding-left: 0.7rem; border-left: 2px solid var(--sl-color-gray-5);
  }

  .ie-topics { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin: 1rem 0 1.5rem; }
  .ie-topics-label { font-size: 0.8rem; color: var(--sl-color-gray-3); margin-right: 0.2rem; }
  .ie-chip {
    display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5);
    font-size: 0.78rem; text-decoration: none; color: var(--sl-color-text);
  }
  .ie-chip:hover { background: var(--sl-color-accent-low); border-color: var(--sl-color-accent); }
  .ie-chip-sm { font-size: 0.72rem; padding: 0.05rem 0.45rem; }

  .ie-companies { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .ie-company {
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem;
    padding: 0.9rem 1rem; background: var(--sl-color-black);
  }
  .ie-company-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .ie-company-head h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
  .ie-count { font-size: 0.78rem; color: var(--sl-color-gray-3); white-space: nowrap; }

  .ie-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .ie-list-lg { margin-bottom: 2rem; }
  .ie-item > a { display: flex; gap: 0.5rem; align-items: baseline; text-decoration: none; }
  .ie-item > a:hover .ie-title { text-decoration: underline; }
  .ie-title { color: var(--sl-color-white); font-weight: 500; }
  .ie-medium {
    flex: none; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem; border-radius: 0.25rem; border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  .ie-medium[data-medium="video"], .ie-medium[data-medium="playlist"] {
    border-color: var(--sl-color-accent); color: var(--sl-color-accent-high);
  }
  .ie-meta {
    display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;
    font-size: 0.78rem; color: var(--sl-color-gray-3); margin-top: 0.15rem;
  }
  .ie-item-note { font-size: 0.78rem; color: var(--sl-color-gray-3); margin: 0.25rem 0 0; }

  .ie-creators { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .ie-creators li { display: flex; flex-direction: column; }
  .ie-creators span { font-size: 0.82rem; color: var(--sl-color-gray-3); }

  @media (max-width: 50rem) { .ie-companies { grid-template-columns: 1fr; } }
</style>
