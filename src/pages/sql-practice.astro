---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import SqlPlayground from "../components/sql-practice/SqlPlayground.astro";
import type { ExerciseData } from "../lib/endless-sql/core/types";
import rawData from "../../data/sql-practice/exercises.json";

const DATA = rawData as unknown as ExerciseData;
---

<StarlightPage
  frontmatter={{
    title: "SQL Practice",
    description:
      "Practice SQL in your browser against real Postgres. Filter, join, aggregate, and window-function drills with instant feedback and answer checking.",
  }}
>
  <SqlPlayground data={DATA} />
</StarlightPage>
