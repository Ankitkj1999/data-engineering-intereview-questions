---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Button from "../components/ui/Button.astro";
import DATA from "../../data/sql-practice/exercises.json";
---

<StarlightPage
  frontmatter={{
    title: "SQL Practice",
    description:
      "Practice SQL in your browser against real Postgres. Filter, join, aggregate, and window-function drills with instant feedback and answer checking.",
  }}
>
  <div id="sqlp-root" class="not-content">
    <div class="sqlp-header">
      <div class="sqlp-header-left">
        <span class="sqlp-badge">POC · Endless SQL</span>
        <h1 class="sqlp-title">Endless SQL</h1>
        <p class="sqlp-subtitle">{DATA.subtitle}</p>
      </div>
      <div class="sqlp-header-right">
        <span class="sqlp-engine" id="sqlp-engine"><span class="sqlp-dot"></span><span id="sqlp-engine-label">Loading engine…</span></span>
        <div class="sqlp-progress-summary">
          <span class="sqlp-prog-label">Solved</span>
          <div class="sqlp-prog-bar-wrap ds-progress-track"><div class="ds-progress-fill" id="sqlp-prog-fill" style="width:0%"></div></div>
          <span class="sqlp-prog-pct" id="sqlp-prog-pct">0/0</span>
        </div>
      </div>
    </div>

    <div class="sqlp-layout">
      <aside class="sqlp-list" id="sqlp-list" aria-label="Exercises">
        <span class="sqlp-list-title">Exercises</span>
      </aside>

      <section class="sqlp-center">
        <div class="sqlp-statement">
          <div class="sqlp-statement-top">
            <span class="sqlp-statement-title" id="sqlp-title">…</span>
            <span class="ds-pill ds-pill--neutral" id="sqlp-topic-pill">…</span>
            <span class="ds-pill ds-pill--neutral" id="sqlp-diff-pill">…</span>
          </div>
          <p class="sqlp-question" id="sqlp-question">…</p>
          <div class="sqlp-schema" id="sqlp-schema"></div>
        </div>

        <div class="sqlp-editor-card">
          <div class="sqlp-editor-toolbar">
            <Button id="sqlp-run" class="sqlp-run-btn">Run</Button>
            <Button id="sqlp-check" variant="secondary">Check answer</Button>
            <Button id="sqlp-reset" variant="ghost">Reset data</Button>
            <span class="sqlp-toolbar-hint"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> to run</span>
          </div>
          <div class="sqlp-editor" id="sqlp-editor"></div>
        </div>

        <div class="sqlp-aux-row">
          <Button id="sqlp-hint-btn" variant="ghost">Hint</Button>
          <Button id="sqlp-solution-btn" variant="ghost">Show solution</Button>
          <Button id="sqlp-next-btn" variant="primary" style="display:none">Next exercise →</Button>
        </div>

        <p class="sqlp-hint" id="sqlp-hint" hidden></p>
        <pre class="sqlp-solution" id="sqlp-solution" hidden></pre>
      </section>

      <section class="sqlp-results" aria-label="Query results">
        <div class="sqlp-results-head">
          <span class="sqlp-results-title">Results</span>
          <span class="sqlp-results-meta" id="sqlp-meta"></span>
        </div>
        <div class="sqlp-verdict is-pass" id="sqlp-verdict" hidden></div>
        <pre class="sqlp-error" id="sqlp-error" hidden></pre>
        <div class="sqlp-table-wrap" id="sqlp-table-wrap">
          <div class="sqlp-empty" id="sqlp-empty">Run a query to see results here.</div>
        </div>
        <details class="sqlp-expected" id="sqlp-expected" hidden>
          <summary>Expected output</summary>
          <div class="sqlp-table-wrap" id="sqlp-expected-wrap"></div>
        </details>
      </section>
    </div>
  </div>

  <script type="application/json" id="sqlp-data" set:html={JSON.stringify(DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/sql-practice.css";
</style>

<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLine, drawSelection } from "@codemirror/view";
  import { Compartment } from "@codemirror/state";
  import { defaultKeymap, history, historyKeymap, indentWithTab } from "@codemirror/commands";
  import { sql, PostgreSQL } from "@codemirror/lang-sql";
  import { HighlightStyle, syntaxHighlighting, bracketMatching } from "@codemirror/language";
  import { autocompletion, closeBrackets } from "@codemirror/autocomplete";
  import { tags as t } from "@lezer/highlight";

  // ── Exercise data ─────────────────────────────────────────────────────────
  type Exercise = {
    id: string; topic: string; difficulty: "easy" | "medium" | "hard";
    title: string; question: string; dataset: string; orderMatters: boolean;
    hint: string; solution: string;
  };
  const DATA = JSON.parse((document.getElementById("sqlp-data") as HTMLScriptElement).textContent!) as {
    datasets: Record<string, { schemaSql: string; seedSql: string }>;
    exercises: Exercise[];
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // ── Engine client (worker owns the PGlite instance) ───────────────────────
  type Req =
    | { type: "load"; schemaSql: string; seedSql: string }
    | { type: "exec"; sql: string }
    | { type: "reset" }
    | { type: "check"; userSql: string; solutionSql: string; orderMatters: boolean };
  type TableMeta = { name: string; columns: { name: string; type: string }[] };

  const pending = new Map<number, (v: any) => void>();
  let seq = 0;
  const worker = new Worker(new URL("../workers/pglite.worker.ts", import.meta.url), { type: "module" });
  worker.onmessage = (e: MessageEvent) => {
    const cb = pending.get(e.data.id);
    if (cb) { pending.delete(e.data.id); cb(e.data); }
  };
  function send(msg: Req): Promise<any> {
    return new Promise((resolve) => {
      const id = ++seq;
      pending.set(id, resolve);
      worker.postMessage({ ...msg, id });
    });
  }

  // ── Progress (same q_<id> localStorage scheme as QuestionCard) ────────────
  const done = new Set<string>(
    DATA.exercises
      .filter((ex) => {
        try { return JSON.parse(localStorage.getItem(`q_${ex.id}`) || "{}").done; }
        catch { return false; }
      })
      .map((ex) => ex.id),
  );
  function markDone(id: string) {
    done.add(id);
    try { localStorage.setItem(`q_${id}`, JSON.stringify({ done: true })); } catch {}
  }
  function refreshProgress() {
    $("sqlp-prog-fill").style.width = `${(done.size / DATA.exercises.length) * 100}%`;
    $("sqlp-prog-pct").textContent = `${done.size}/${DATA.exercises.length}`;
  }

  // ── Editor ────────────────────────────────────────────────────────────────
  // Highlight colors resolve through CSS vars declared on #sqlp-root, so the
  // same highlight style works in both themes without a CM theme swap.
  const hl = syntaxHighlighting(HighlightStyle.define([
    { tag: [t.keyword, t.control], color: "var(--sqlp-hl-keyword)" },
    { tag: [t.string, t.special(t.string)], color: "var(--sqlp-hl-string)" },
    { tag: t.number, color: "var(--sqlp-hl-number)" },
    { tag: t.comment, color: "var(--sqlp-hl-comment)", fontStyle: "italic" },
    { tag: [t.operator, t.punctuation], color: "var(--page-text-secondary)" },
  ]));
  const langComp = new Compartment();
  let view = new EditorView({
    parent: $("sqlp-editor"),
    extensions: [
      lineNumbers(),
      history(),
      drawSelection(),
      bracketMatching(),
      closeBrackets(),
      autocompletion(),
      EditorView.lineWrapping,
      hl,
      langComp.of([]),
      keymap.of([
        { key: "Mod-Enter", run: () => { void runQuery(); return true; } },
        ...defaultKeymap, ...historyKeymap, indentWithTab,
      ]),
    ],
  });

  // ── Exercise switching ────────────────────────────────────────────────────
  let currentIdx = 0;
  const drafts = new Map<string, string>();

  const DIFF_TONE = { easy: "success", medium: "neutral", hard: "danger" } as const;

  function mdBold(s: string): string {
    const esc = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    return esc.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  }

  function buildList() {
    const list = $("sqlp-list");
    list.querySelectorAll(".sqlp-ex").forEach((n) => n.remove());
    DATA.exercises.forEach((ex, i) => {
      const btn = document.createElement("button");
      btn.className = `sqlp-ex${i === currentIdx ? " is-active" : ""}${done.has(ex.id) ? " is-done" : ""}`;
      btn.innerHTML = `<span class="sqlp-ex-num">${done.has(ex.id) ? "✓" : i + 1}</span>
        <span class="sqlp-ex-label"><span class="sqlp-ex-name">${ex.title}</span><span class="sqlp-ex-topic">${ex.topic}</span></span>`;
      btn.addEventListener("click", () => selectExercise(i));
      list.appendChild(btn);
    });
  }

  async function selectExercise(i: number) {
    if (DATA.exercises[currentIdx]) drafts.set(DATA.exercises[currentIdx].id, view.state.doc.toString());
    currentIdx = i;
    const ex = DATA.exercises[i];
    const ds = DATA.datasets[ex.dataset];

    $("sqlp-title").textContent = ex.title;
    $("sqlp-topic-pill").textContent = ex.topic;
    const diff = $("sqlp-diff-pill");
    diff.textContent = ex.difficulty;
    diff.className = `ds-pill ds-pill--${DIFF_TONE[ex.difficulty]}`;
    $("sqlp-question").innerHTML = mdBold(ex.question);
    $("sqlp-hint").textContent = ex.hint;
    $("sqlp-hint").hidden = true;
    $("sqlp-solution").textContent = ex.solution;
    $("sqlp-solution").hidden = true;
    $("sqlp-next-btn").style.display = "none";
    hideVerdict(); hideError();

    view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: drafts.get(ex.id) ?? "" } });

    const res = await send({ type: "load", schemaSql: ds.schemaSql, seedSql: ds.seedSql });
    if (!res.ok) { setEngine("error", res.error); return; }

    // Schema chips + editor completion fed from the live catalog
    const schemaEl = $("sqlp-schema");
    schemaEl.innerHTML = "";
    const completion: Record<string, Record<string, string>> = {};
    (res.tables as TableMeta[]).forEach((tbl) => {
      completion[tbl.name] = Object.fromEntries(tbl.columns.map((c) => [c.name, c.type]));
      const chip = document.createElement("span");
      chip.className = "sqlp-table-chip";
      chip.innerHTML = `<span class="sqlp-chip-table">${tbl.name}</span><span>·</span><span>${tbl.columns.length} cols</span>`;
      chip.title = tbl.columns.map((c) => `${c.name}  ${c.type}`).join("\n");
      schemaEl.appendChild(chip);
    });
    view.dispatch({ effects: langComp.reconfigure(sql({ dialect: PostgreSQL, schema: completion })) });

    $("sqlp-meta").textContent = "fresh instance seeded";
    $("sqlp-table-wrap").innerHTML = `<div class="sqlp-empty">Run a query to see results here.</div>`;
    setEngine("ready", `${res.version.split(" ").slice(0, 2).join(" ")} · PGlite WASM`);
    buildList();
  }

  function setEngine(state: "loading" | "ready" | "error", label: string) {
    const el = $("sqlp-engine");
    el.className = `sqlp-engine${state === "ready" ? " is-ready" : state === "error" ? " is-error" : ""}`;
    $("sqlp-engine-label").textContent = label;
  }

  // ── Result rendering ──────────────────────────────────────────────────────
  function renderTable(container: HTMLElement, fields: { name: string }[], rows: Record<string, unknown>[]) {
    if (!fields.length || !rows.length) {
      container.innerHTML = `<div class="sqlp-empty">No rows returned.</div>`;
      return;
    }
    const table = document.createElement("table");
    table.className = "sqlp-table";
    table.innerHTML =
      `<thead><tr>${fields.map((f) => `<th>${f.name}</th>`).join("")}</tr></thead>` +
      `<tbody>${rows
        .map((r) => `<tr>${fields.map((f) => {
          const v = r[f.name];
          return `<td${v === null ? ' class="is-null"' : ""}>${v === null ? "null" : String(v)}</td>`;
        }).join("")}</tr>`)
        .join("")}</tbody>`;
    container.innerHTML = "";
    container.appendChild(table);
  }

  function hideVerdict() { $("sqlp-verdict").hidden = true; }
  function hideError() { $("sqlp-error").hidden = true; $("sqlp-expected").hidden = true; }

  // ── Actions ───────────────────────────────────────────────────────────────
  async function runQuery() {
    const sqlText = view.state.doc.toString().trim();
    if (!sqlText) return;
    hideVerdict(); hideError();
    $("sqlp-meta").textContent = "running…";
    const t0 = performance.now();
    const res = await send({ type: "exec", sql: sqlText });
    const ms = Math.max(1, Math.round(performance.now() - t0));
    if (!res.ok) {
      $("sqlp-error").textContent = res.error;
      $("sqlp-error").hidden = false;
      $("sqlp-meta").textContent = `error · ${ms} ms`;
      return;
    }
    renderTable($("sqlp-table-wrap"), res.fields, res.rows);
    const n = res.rows.length || res.rowCount || 0;
    $("sqlp-meta").textContent = `${res.command || "OK"} · ${n} row${n === 1 ? "" : "s"} · ${ms} ms`;
  }

  async function checkAnswer() {
    const ex = DATA.exercises[currentIdx];
    const sqlText = view.state.doc.toString().trim();
    if (!sqlText) return;
    hideVerdict(); hideError();
    $("sqlp-meta").textContent = "checking…";
    const res = await send({ type: "check", userSql: sqlText, solutionSql: ex.solution, orderMatters: ex.orderMatters });
    if (!res.ok) {
      $("sqlp-error").textContent = res.error;
      $("sqlp-error").hidden = false;
      $("sqlp-meta").textContent = "error";
      return;
    }
    const verdict = $("sqlp-verdict");
    if (res.pass) {
      verdict.className = "sqlp-verdict is-pass";
      verdict.textContent = `✓ Correct — ${ex.title} solved.`;
      markDone(ex.id);
      refreshProgress();
      buildList();
      if (currentIdx < DATA.exercises.length - 1) $("sqlp-next-btn").style.display = "";
    } else {
      verdict.className = "sqlp-verdict is-fail";
      verdict.textContent = "✗ Not quite — your output doesn't match. Compare below.";
      const exp = $("sqlp-expected");
      exp.hidden = false;
      exp.open = true;
      renderTable($("sqlp-expected-wrap"), Object.keys(res.expected[0] ?? {}).map((name) => ({ name })), res.expected);
    }
    verdict.hidden = false;
    $("sqlp-meta").textContent = res.pass ? "passed" : "failed";
  }

  async function resetData() {
    const ex = DATA.exercises[currentIdx];
    const ds = DATA.datasets[ex.dataset];
    const res = await send({ type: "load", schemaSql: ds.schemaSql, seedSql: ds.seedSql });
    if (res.ok) {
      $("sqlp-meta").textContent = "data reset";
      $("sqlp-table-wrap").innerHTML = `<div class="sqlp-empty">Run a query to see results here.</div>`;
    }
  }

  $("sqlp-run").addEventListener("click", () => void runQuery());
  $("sqlp-check").addEventListener("click", () => void checkAnswer());
  $("sqlp-reset").addEventListener("click", () => void resetData());
  $("sqlp-hint-btn").addEventListener("click", () => { $("sqlp-hint").hidden = !$("sqlp-hint").hidden; });
  $("sqlp-solution-btn").addEventListener("click", () => { $("sqlp-solution").hidden = !$("sqlp-solution").hidden; });
  $("sqlp-next-btn").addEventListener("click", () => void selectExercise(currentIdx + 1));

  // ── Init ──────────────────────────────────────────────────────────────────
  refreshProgress();
  buildList();
  void selectExercise(0);
</script>
