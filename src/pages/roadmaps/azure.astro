    { id:"azure-ai-language",      label:"Azure AI Language",                  desc:"NLP service for sentiment analysis, key phrase extraction, entity recognition, and language detection over text." },
    { id:"azure-ai-vision",        label:"Azure AI Vision",                    desc:"Computer vision service for image analysis, OCR, spatial analysis, and image tagging." },
    { id:"azure-ai-translator",    label:"Azure AI Translator",                desc:"Neural machine translation service supporting real-time text translation across 100+ languages." },
    { id:"azure-ai-search",        label:"Azure AI Search",                    desc:"AI-powered search-as-a-service with vector search, semantic ranking, and integrated cognitive skills for enriching content." },
    { id:"azure-ai-video-indexer", label:"Azure AI Video Indexer",             desc:"Extracts insights from video and audio — transcription, face detection, object labels, and sentiment — using AI models." },
    { id:"azure-ai-speech",        label:"Azure AI Speech",                    desc:"Speech-to-text, text-to-speech, and speech translation service for building voice-enabled applications." },
    { id:"azure-ai-bot-service",   label:"Azure AI Bot Service",               desc:"Managed platform for building, testing, and deploying conversational bots that integrate with Azure AI Language and multiple channels." },
    { id:"azure-openai",           label:"Azure OpenAI",                       desc:"Provides API access to OpenAI's GPT, embeddings, and DALL-E models with Azure's enterprise security, compliance, and regional availability." },
    { id:"microsoft-365-copilot",  label:"Microsoft 365 Copilot",              desc:"Generative AI assistant embedded across Microsoft 365 apps (Word, Excel, Teams) grounded in an organization's own data via Microsoft Graph." },
  ]},
  { id:"comparisons", label:"Comparison of Azure Services", desc:"Head-to-head breakdowns of similar Azure services — the decisions that come up most often in interviews and architecture reviews.", subs:[
