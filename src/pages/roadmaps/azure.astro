  ]},
  { id:"compute", label:"Azure Compute Services", desc:"Services for running application code and containers — from fully managed PaaS to full control over virtual machines.", subs:[
    { id:"azure-app-service",      label:"Azure App Service",                  desc:"Fully managed PaaS for hosting web apps, REST APIs, and mobile back ends, with built-in auto-scaling, deployment slots, and CI/CD integration." },
    { id:"azure-batch",            label:"Azure Batch",                        desc:"Managed service for running large-scale parallel and batch compute jobs across a pool of auto-scaling virtual machines.", de:true },
    { id:"azure-container-instances", label:"Azure Container Instances",       desc:"Serverless container hosting that runs a single container or container group without provisioning or managing VMs.", de:true },
    { id:"azure-container-registry", label:"Azure Container Registry",         desc:"Private, managed Docker registry for storing and managing container images and Helm charts across your Azure deployments." },
    { id:"azure-cyclecloud",       label:"Azure CycleCloud",                   desc:"Tool for orchestrating and managing HPC clusters on Azure, provisioning infrastructure and scheduler software for workload-managed clusters." },
    { id:"azure-aks",              label:"Azure Kubernetes Service (AKS)",     desc:"Managed Kubernetes service that offloads control-plane operations, letting you deploy and scale containerized applications with native Azure integration.", de:true },
    { id:"azure-service-fabric",   label:"Azure Service Fabric",               desc:"Distributed systems platform for building and managing scalable microservices and containers across a cluster of machines." },
    { id:"azure-virtual-machines", label:"Azure Virtual Machines",             desc:"On-demand, scalable IaaS compute — full control over the OS and configuration, available in a wide range of sizes and pricing tiers.", de:true },
  ]},
  { id:"storage", label:"Azure Storage Services", desc:"Object, block, file, and table storage services covering every durability, access-pattern, and cost tier.", subs:[
    { id:"azure-archive-storage",  label:"Azure Archive Storage",              desc:"Lowest-cost Blob Storage access tier for rarely accessed data with hours-long retrieval latency, ideal for long-term archival.", de:true },
    { id:"azure-blob-storage",     label:"Azure Blob Storage",                 desc:"Massively scalable object storage for unstructured data — Hot, Cool, and Archive tiers trade access latency for cost.", de:true },
    { id:"azure-disk-storage",     label:"Azure Disk Storage",                 desc:"Persistent, high-performance block storage (HDD, SSD, Premium SSD, Ultra Disk) attached to Azure Virtual Machines.", de:true },
    { id:"azure-file-storage",     label:"Azure File Storage",                 desc:"Fully managed SMB and NFS file shares in the cloud, mountable concurrently by on-premises and cloud VMs.", de:true },
    { id:"azure-queue-storage",    label:"Azure Queue Storage",                desc:"Simple, durable message queuing service for asynchronous communication between application components.", de:true },
    { id:"azure-storage-overview", label:"Azure Storage Overview",             desc:"Umbrella service covering Blob, File, Queue, Table, and Disk storage, unified under a single storage account with shared redundancy options.", de:true },
    { id:"azure-table-storage",    label:"Azure Table Storage",                desc:"NoSQL key-value store for large amounts of structured, non-relational data, now largely superseded by Azure Cosmos DB's Table API.", de:true },
