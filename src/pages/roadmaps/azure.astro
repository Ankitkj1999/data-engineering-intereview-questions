    { id:"microsoft-defender-for-cloud", label:"Microsoft Defender for Cloud", desc:"Cloud security posture management and workload protection platform providing security recommendations and threat detection across Azure and hybrid resources." },
    { id:"microsoft-defender-for-identity", label:"Microsoft Defender for Identity", desc:"Monitors on-premises Active Directory signals to identify, detect, and investigate advanced threats and compromised identities." },
