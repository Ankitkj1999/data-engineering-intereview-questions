  ]},
  { id:"ai", label:"Azure AI Services", desc:"Managed machine learning platforms, generative AI, and pre-trained AI services for vision, language, and speech.", subs:[
    { id:"azure-ai-vision-nlp",    label:"Azure Applied AI Services: Vision & NLP", desc:"Pre-built AI services combining computer vision and natural language processing for common business scenarios like document processing and form recognition." },
    { id:"azure-responsible-ai",   label:"Azure Responsible AI",                desc:"Microsoft's framework and toolset for building AI responsibly — fairness, reliability, privacy, inclusiveness, transparency, and accountability." },
