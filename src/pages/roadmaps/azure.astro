    { id:"microsoft-copilot-for-security", label:"Microsoft Copilot for Security", desc:"Generative AI assistant for security teams that summarizes incidents, analyzes scripts, and speeds up investigation and response." },
  ]},
  { id:"management", label:"Azure Monitoring and Management Tools", desc:"Tools for provisioning infrastructure as code, monitoring, governance, and operating Azure environments at scale.", subs:[
    { id:"azure-advisor",          label:"Azure Advisor",                      desc:"Personalized recommendation engine for optimizing Azure resources across cost, security, reliability, and performance." },
    { id:"azure-arc",              label:"Azure Arc",                          desc:"Extends Azure management and services to on-premises, multi-cloud, and edge infrastructure through a single control plane." },
    { id:"azure-blueprints",       label:"Azure Blueprints",                   desc:"Defines a repeatable set of Azure resources, policies, and role assignments that implement organizational standards for new environments." },
    { id:"azure-compliance-manager", label:"Azure Compliance Manager",         desc:"Risk assessment tool that helps track, assign, and verify compliance activities against regulatory standards." },
    { id:"azure-monitor",          label:"Azure Monitor",                      desc:"Full-stack monitoring service collecting metrics, logs, and traces across applications, infrastructure, and networks." },
    { id:"azure-policy",           label:"Azure Policy",                       desc:"Enforces organizational standards and assesses compliance at scale by evaluating resources against defined policy rules." },
    { id:"azure-arm",              label:"Azure Resource Manager (ARM)",       desc:"Deployment and management layer for Azure — groups resources logically and enables declarative, template-based infrastructure as code." },
    { id:"azure-rbac",             label:"Azure Role-Based Access Control (RBAC)", desc:"Fine-grained access management for Azure resources, assigning roles to users, groups, and applications at different scopes." },
    { id:"azure-service-health",   label:"Azure Service Health",               desc:"Personalized dashboard tracking the health of Azure services and planned maintenance that could affect your resources." },
  ]},
  { id:"solutions", label:"Azure Solutions", desc:"Higher-level platforms and reference architectures built by combining core Azure services for common business scenarios.", subs:[
    { id:"azure-big-data",         label:"Azure Big Data",                     desc:"Reference architectures and services (Synapse Analytics, HDInsight, Databricks) for large-scale batch and streaming data processing on Azure.", de:true },
    { id:"azure-devops",           label:"Azure DevOps",                       desc:"Suite of development tools — Boards, Repos, Pipelines, Test Plans, Artifacts — for planning, building, and shipping software." },
    { id:"azure-iot",              label:"Azure Internet of Things (IoT)",     desc:"Platform of services (IoT Hub, IoT Central, Digital Twins) for connecting, monitoring, and managing IoT devices at scale." },
    { id:"azure-machine-learning", label:"Azure Machine Learning",             desc:"End-to-end platform for building, training, deploying, and managing machine learning models and MLOps pipelines." },
