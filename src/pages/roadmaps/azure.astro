---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Azure Services Roadmap",
    description: "A complete, interactive map of every Azure service across all categories — compute, storage, databases, networking, security, AI, and more — with progress tracking.",
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Azure Services</h1>
        <p class="rm-subtitle">Complete map of every Azure service across all categories — track what you've learned or used in production</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-filter-row">
          <div class="rm-filter-toggle" id="rm-filter-toggle">
            <button type="button" class="rm-filter-btn" data-mode="de">Data Engineering</button>
            <button type="button" class="rm-filter-btn" data-mode="all">All services</button>
          </div>
          <span class="rm-filter-count" id="rm-filter-count"></span>
        </div>
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"overview", label:"Azure Overview", desc:"Foundational Azure concepts, cost models, and account-level basics every cloud practitioner should know before diving into individual services.", subs:[
    { id:"azure-capex-vs-opex",    label:"Azure CAPEX vs OPEX",                desc:"Contrasts traditional capital expenditure (buying hardware upfront) with Azure's operating expenditure (pay-as-you-go) cost model that shifts IT spend from CapEx to OpEx." },
    { id:"azure-cloud-concepts",   label:"Azure Cloud Concepts",               desc:"Foundational cloud computing concepts — scalability, elasticity, agility, and high availability — as implemented across Azure's platform." },
    { id:"azure-cloud-architecture-models", label:"Azure Cloud Architecture Models", desc:"Public, private, and hybrid cloud architecture models, and how Azure supports each through services like Azure Arc and Azure Stack." },
    { id:"azure-cloud-service-models", label:"Azure Cloud Service Models",     desc:"IaaS, PaaS, and SaaS service models and the corresponding Azure services (Virtual Machines, App Service, Microsoft 365) that fit each." },
    { id:"azure-global-infrastructure", label:"Azure Global Infrastructure",   desc:"Regions, Availability Zones, and Region Pairs — the physical and logical structure Azure uses to deliver resilient, low-latency services worldwide." },
    { id:"azure-user-tools",       label:"Azure User Tools",                   desc:"Interfaces for interacting with Azure — the Azure Portal, Azure CLI, Azure PowerShell, and Cloud Shell — each suited to different workflows." },
  ]},
  { id:"pricing", label:"Azure Pricing", desc:"How Azure charges for usage and the tools available to estimate and control cloud spend.", subs:[
