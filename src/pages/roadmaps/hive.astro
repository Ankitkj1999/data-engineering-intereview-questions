---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Apache Hive Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Hive</h1>
        <p class="rm-subtitle">Step-by-step guide to SQL on Hadoop</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"hiveql-fundamentals-architecture", label:"HiveQL Fundamentals & Architecture", desc:"15 interview questions covering Fundamentals, Architecture, SerDe, Ecosystem and more.", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture", subs:[
    { id:"hiveql-fundamentals-architecture-fundamentals", label:"Fundamentals", desc:"Hive gives users a SQL-like interface for organizing and querying data that lives in Hadoop, so teams can access and analyze big data using familiar SQL syntax…", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture" },
    { id:"hiveql-fundamentals-architecture-architecture", label:"Architecture", desc:"Hive Driver — receives queries from users, manages sessions, and exposes execute/fetch APIs similar to JDBC/ODBC.", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture" },
    { id:"hiveql-fundamentals-architecture-serde", label:"SerDe", desc:"Hive's built-in SerDes don't cover every possible data format.", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture" },
    { id:"hiveql-fundamentals-architecture-ecosystem", label:"Ecosystem", desc:"HCatalog is Hadoop's table and storage management layer.", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture" },
    { id:"hiveql-fundamentals-architecture-performance", label:"Performance", desc:"Setting hive.exec.mode.local.auto to true tells Hive to try fetching query results locally instead of launching a MapReduce job, which is useful for small…", link:"/level-3-technologies/batch-processing/hive/#hiveql-fundamentals--architecture" },
  ]},
  { id:"metastore-data-types-data-model", label:"Metastore, Data Types & Data Model", desc:"7 interview questions covering Metastore, Data Types.", link:"/level-3-technologies/batch-processing/hive/#metastore-data-types--data-model", subs:[
    { id:"metastore-data-types-data-model-metastore", label:"Metastore", desc:"The metastore is a relational database that stores Hive's metadata: table definitions, column mappings, partitions, databases, and other schema information.", link:"/level-3-technologies/batch-processing/hive/#metastore-data-types--data-model" },
    { id:"metastore-data-types-data-model-data-types", label:"Data Types", desc:"Map — a collection of key-value pairs; access a value with [key].", link:"/level-3-technologies/batch-processing/hive/#metastore-data-types--data-model" },
  ]},
  { id:"ddl-tables-views-partitioning", label:"DDL, Tables, Views & Partitioning", desc:"21 interview questions covering DDL, Views, Bucketing, Performance and more.", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning", subs:[
    { id:"ddl-tables-views-partitioning-ddl", label:"DDL", desc:"Use the ALTER TABLE ... REPLACE COLUMNS statement: ALTER TABLE tableName REPLACE COLUMNS (columnName newDataType);", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
    { id:"ddl-tables-views-partitioning-views", label:"Views", desc:"No. A view's name must be unique across all tables and views in the same database, so you can't reuse a table name for a view (or vice versa).", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
    { id:"ddl-tables-views-partitioning-bucketing", label:"Bucketing", desc:"Bucketing divides a dataset into a fixed, manageable number of parts based on the hash of a column — conceptually similar to hashing.", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
    { id:"ddl-tables-views-partitioning-performance", label:"Performance", desc:"A skewed table is a table where some values in a column occur far more often than others, producing a skewed distribution.", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
    { id:"ddl-tables-views-partitioning-tables", label:"Tables", desc:"A managed table is one whose files, metadata, and statistics are all controlled by Hive's internal processes — this is the default table type Hive creates.", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
    { id:"ddl-tables-views-partitioning-partitioning", label:"Partitioning", desc:"ALTER TABLE table_name ENABLE NO_DROP — prevents the partition from being dropped.", link:"/level-3-technologies/batch-processing/hive/#ddl-tables-views--partitioning" },
  ]},
  { id:"hiveql-queries-functions-joins", label:"HiveQL Queries, Functions & Joins", desc:"12 interview questions covering Query Syntax, Functions, Optimization, Joins.", link:"/level-3-technologies/batch-processing/hive/#hiveql-queries-functions--joins", subs:[
    { id:"hiveql-queries-functions-joins-query-syntax", label:"Query Syntax", desc:"SORT BY — sorts data within each reducer; multiple reducers can be used, so the result is only locally sorted per reducer, not globally.", link:"/level-3-technologies/batch-processing/hive/#hiveql-queries-functions--joins" },
    { id:"hiveql-queries-functions-joins-functions", label:"Functions", desc:"CONCAT concatenates a comma-separated list of input strings.", link:"/level-3-technologies/batch-processing/hive/#hiveql-queries-functions--joins" },
    { id:"hiveql-queries-functions-joins-optimization", label:"Optimization", desc:"STREAMTABLE is a query hint used with JOIN to control which table is streamed (rather than fully buffered) during the map/reduce stage of the join — a query…", link:"/level-3-technologies/batch-processing/hive/#hiveql-queries-functions--joins" },
    { id:"hiveql-queries-functions-joins-joins", label:"Joins", desc:"No — a Cartesian (cross) join isn't supported in this context because it can't be implemented efficiently in a MapReduce-style execution model.", link:"/level-3-technologies/batch-processing/hive/#hiveql-queries-functions--joins" },
  ]},
  { id:"configuration-sessions-operations", label:"Configuration, Sessions & Operations", desc:"17 interview questions covering Configuration, Operations, Performance, File Formats and more.", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations", subs:[
    { id:"configuration-sessions-operations-configuration", label:"Configuration", desc:".hiverc is Hive's initialization file — it's loaded automatically whenever the Hive CLI starts, and it's the natural place to set initial parameter values or…", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
    { id:"configuration-sessions-operations-operations", label:"Operations", desc:"4 interview questions on operations, in the Configuration, Sessions & Operations section.", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
    { id:"configuration-sessions-operations-performance", label:"Performance", desc:"Strict mode guards against accidentally running a full table scan against a very large table.", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
    { id:"configuration-sessions-operations-file-formats", label:"File Formats", desc:"ORC (Optimized Row Columnar) is a file format built for efficient storage, reading, writing, and processing in Hive.", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
    { id:"configuration-sessions-operations-data-types", label:"Data Types", desc:"Yes — the TIMESTAMP data type stores date/time values, backed by java.sql.Timestamp format.", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
    { id:"configuration-sessions-operations-architecture", label:"Architecture", desc:"Input (reading records that make up a table) — org.apache.hadoop.mapred.TextInputFormat - Output (writing records that result from Hive queries) —…", link:"/level-3-technologies/batch-processing/hive/#configuration-sessions--operations" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "hive_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
