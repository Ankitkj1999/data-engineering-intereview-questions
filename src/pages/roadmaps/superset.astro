---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/superset.json";
---

<StarlightPage
  frontmatter={{
    title: "Apache Superset Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root" class="not-content">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Superset</h1>
        <p class="rm-subtitle">Step-by-step guide to open-source BI</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index not-content" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Fundamentals, Architecture &amp; Connectivity</a></h3>
        <p class="rm-index-desc">18 interview questions covering Fundamentals, Architecture, Connectivity, Installation and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Fundamentals</a></span> <span class="rm-index-sub-desc">Apache Superset is an open-source business intelligence (BI) and data visualization tool that lets users explore and analyze large datasets through interactive visualizations, dashboards, and SQL-based queries.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Architecture</a></span> <span class="rm-index-sub-desc">The web server, the database backend for the data being visualized, the metadata database that stores Superset's own dashboards/charts/connections, and the visualization engine that renders charts.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Connectivity</a></span> <span class="rm-index-sub-desc">What databases does Superset support? Can you explain the process of connecting a database to Superset?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Installation</a></span> <span class="rm-index-sub-desc">The simplest path is pip install apache-superset, though production deployments typically use Docker or Docker Compose for a more reproducible setup.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#fundamentals-architecture--connectivity">Ecosystem</a></span> <span class="rm-index-sub-desc">Can you integrate Superset with other BI tools or data platforms? Can you integrate Superset with version control systems?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/bi/superset/#sql-lab--query-engine">SQL Lab &amp; Query Engine</a></h3>
        <p class="rm-index-desc">11 interview questions covering SQL Lab, Streaming.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#sql-lab--query-engine">SQL Lab</a></span> <span class="rm-index-sub-desc">SQL Lab is Superset's built-in feature for writing and executing SQL queries directly against connected databases — a full-featured SQL IDE inside the BI tool.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#sql-lab--query-engine">Streaming</a></span> <span class="rm-index-sub-desc">Superset's support here is limited — while it can connect to streaming platforms like Apache Kafka, its exploration capabilities are typically focused on visualizing historical snapshots rather than true real-time analysis.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/bi/superset/#visualization-dashboards--reporting">Visualization, Dashboards &amp; Reporting</a></h3>
        <p class="rm-index-desc">19 interview questions covering Visualization, Dashboards, Data Modeling, Reporting.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#visualization-dashboards--reporting">Visualization</a></span> <span class="rm-index-sub-desc">Yes — Superset lets you build custom visualizations using the rich set of visualization libraries available in the Python/JavaScript ecosystem, beyond the built-in chart types.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#visualization-dashboards--reporting">Dashboards</a></span> <span class="rm-index-sub-desc">Yes — Superset provides embed codes or URLs that can be integrated into web pages or portals, letting dashboards live inside another application's UI.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#visualization-dashboards--reporting">Data Modeling</a></span> <span class="rm-index-sub-desc">Yes — Superset lets you define metrics (aggregations) and dimensions (groupings) at the dataset level to build complex analytical queries and visualizations without rewriting SQL each time.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#visualization-dashboards--reporting">Reporting</a></span> <span class="rm-index-sub-desc">Can you schedule and automate reports in Superset?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/bi/superset/#performance-caching--scale">Performance, Caching &amp; Scale</a></h3>
        <p class="rm-index-desc">9 interview questions covering Performance, Caching, Deployment, Alerting.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#performance-caching--scale">Performance</a></span> <span class="rm-index-sub-desc">Using monitoring agents, log analyzers, and performance tracking tools — analyzing server logs, watching resource usage, and tracking query performance to identify and resolve bottlenecks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#performance-caching--scale">Caching</a></span> <span class="rm-index-sub-desc">Superset caches query results to improve performance and reduce load on the underlying databases — subsequent identical requests are served from the cache instead of re-executing the query.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#performance-caching--scale">Deployment</a></span> <span class="rm-index-sub-desc">Yes — Superset supports multi-tenancy by letting you configure and manage multiple instances or workspaces within a single deployment, each with its own users, databases, and resources.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#performance-caching--scale">Alerting</a></span> <span class="rm-index-sub-desc">What are Superset's alerting capabilities?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/bi/superset/#security-governance--lineage">Security, Governance &amp; Lineage</a></h3>
        <p class="rm-index-desc">15 interview questions covering Security, Governance, Ecosystem.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#security-governance--lineage">Security</a></span> <span class="rm-index-sub-desc">Superset provides access control through role-based permissions — you define roles and assign them specific permissions governing who can access and modify datasets, slices, dashboards, and other resources.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#security-governance--lineage">Governance</a></span> <span class="rm-index-sub-desc">Yes — by capturing and displaying metadata information, Superset lets users trace the origin and transformations of data used across multiple dashboards and slices, not just within a single one.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/bi/superset/#security-governance--lineage">Ecosystem</a></span> <span class="rm-index-sub-desc">What is Superset's integration with Apache Airflow? How can you extend Superset's functionality?</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "superset_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
