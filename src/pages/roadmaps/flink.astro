---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/flink.json";
---

<StarlightPage
  frontmatter={{
    title: "Apache Flink Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Flink</h1>
        <p class="rm-subtitle">Step-by-step guide to stateful stream processing</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Fundamentals, Architecture &amp; Deployment</a></h3>
        <p class="rm-index-desc">19 interview questions covering Fundamentals, Comparison, Architecture, Ecosystem and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Fundamentals</a></span> <span class="rm-index-sub-desc">Apache Flink is an open-source, unified stream- and batch-processing framework created by the Apache Software Foundation.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Comparison</a></span> <span class="rm-index-sub-desc">Flink's long-term goal is to fully unify batch and streaming, since a bounded dataset can be understood as just a finite stream.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Architecture</a></span> <span class="rm-index-sub-desc">At its core, Flink is a robust, distributed dataflow engine that executes programs as a stream, using cyclic dataflow execution.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Ecosystem</a></span> <span class="rm-index-sub-desc">Does Flink need to depend on Hadoop?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Use Cases</a></span> <span class="rm-index-sub-desc">What are the use cases of Apache Flink? What are the most common types of applications that use Apache Flink?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Deployment</a></span> <span class="rm-index-sub-desc">What are the different ways to deploy and use Apache Flink? How would you size a Flink cluster for production?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fundamentals-architecture--deployment">Tooling</a></span> <span class="rm-index-sub-desc">What are the different types of tools supported by Apache Flink?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Programming Model, APIs &amp; Tooling</a></h3>
        <p class="rm-index-desc">18 interview questions covering Programming Model, Architecture, APIs, Libraries and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Programming Model</a></span> <span class="rm-index-sub-desc">What is the Flink programming model? What are the commonly used operators in Flink?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Architecture</a></span> <span class="rm-index-sub-desc">A slot is a TaskManager-level concept — it determines how many slots a given TaskManager offers, which caps how much parallelism it can support.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">APIs</a></span> <span class="rm-index-sub-desc">The DataStream API handles data as a continuous stream, supporting operations like filtering, routing, windowing, and aggregation.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Libraries</a></span> <span class="rm-index-sub-desc">FlinkML is Flink's machine learning library — a growing initiative with an expanding set of algorithms and contributors.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Ecosystem</a></span> <span class="rm-index-sub-desc">What storage systems and streaming sources/sinks does Apache Flink integrate with? What filesystems does Apache Flink support?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#programming-model-apis--tooling">Tooling</a></span> <span class="rm-index-sub-desc">The Flink SQL client provides a command-line interface for running SQL operations — creating and dropping tables, creating and dropping views, and other SQL commands.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">State, Time, Windowing &amp; Watermarks</a></h3>
        <p class="rm-index-desc">16 interview questions covering Fundamentals, Streams, Time Semantics, Windowing and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">Fundamentals</a></span> <span class="rm-index-sub-desc">In batch processing, the data is a bounded set with a defined start and end point, so processing only begins once the entire dataset has been ingested.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">Streams</a></span> <span class="rm-index-sub-desc">What are unbounded streams in Apache Flink? What are bounded streams in Apache Flink, and what is bounded vs. unbounded data?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">Time Semantics</a></span> <span class="rm-index-sub-desc">A watermark is Flink's mechanism for handling out-of-order data when working with event time.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">Windowing</a></span> <span class="rm-index-sub-desc">Flink supports dividing a stream into windows based on time or count (a session window is also, conceptually, time-based).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">State</a></span> <span class="rm-index-sub-desc">Flink often needs to store intermediate state during a computation to avoid data loss and support recovery from failure.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#state-time-windowing--watermarks">CEP</a></span> <span class="rm-index-sub-desc">A brief introduction to CEP and state programming in Flink.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/streaming/flink/#fault-tolerance-checkpointing--operations">Fault Tolerance, Checkpointing &amp; Operations</a></h3>
        <p class="rm-index-desc">13 interview questions covering Fault Tolerance, Comparison, Performance, Data Quality.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fault-tolerance-checkpointing--operations">Fault Tolerance</a></span> <span class="rm-index-sub-desc">For streaming applications, Flink manages fault tolerance by periodically capturing a snapshot of the streaming dataflow's state; if a failure occurs, that snapshot is used to recover.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fault-tolerance-checkpointing--operations">Comparison</a></span> <span class="rm-index-sub-desc">How do Spark Streaming and Flink differ in their checkpoint behavior? What is the difference between Spark and Flink serialization?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fault-tolerance-checkpointing--operations">Performance</a></span> <span class="rm-index-sub-desc">First, confirm the skew: the Flink web UI shows the amount of data each subtask processes, and a serious skew looks like most subtasks handling, say, 100 MB while one handles only 1 MB (or vice versa).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/streaming/flink/#fault-tolerance-checkpointing--operations">Data Quality</a></span> <span class="rm-index-sub-desc">How do you handle abnormal (bad) data in Flink?</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "flink_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
