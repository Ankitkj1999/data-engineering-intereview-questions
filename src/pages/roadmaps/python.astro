---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/python.json";
---

<StarlightPage
  frontmatter={{
    title: "Python Roadmap",
    description: "",
  }}
>
  <div id="rm-root">
    <!-- Header -->
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Python</h1>
        <p class="rm-subtitle">Step-by-step guide to learning Python for data engineering</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>

    <!-- Roadmap flow — populated by JS -->
    <div class="rm-flow" id="rm-flow"></div>

    <!-- Drawer -->
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/basics/">Learn the Basics</a></h3>
        <p class="rm-index-desc">The foundation of Python — syntax, data types, control flow, and built-in structures.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#syntax--variables">Basic Syntax</a></span> <span class="rm-index-sub-desc">Indentation rules, comments, print statements, and the Python REPL.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#data-types--casting">Variables &amp; Data Types</a></span> <span class="rm-index-sub-desc">int, float, str, bool, None — and dynamic typing in Python.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#conditionals--loops">Conditionals</a></span> <span class="rm-index-sub-desc">if / elif / else, ternary expressions, and truthy/falsy values.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#conditionals--loops">Loops</a></span> <span class="rm-index-sub-desc">for loops, while loops, break, continue, and range().</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#data-types--casting">Type Casting</a></span> <span class="rm-index-sub-desc">Converting between types: int(), str(), float(), list(), etc.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#exceptions">Exceptions</a></span> <span class="rm-index-sub-desc">try/except/finally, raising exceptions, and custom exception classes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#built-in-functions">Functions &amp; Builtins</a></span> <span class="rm-index-sub-desc">Defining functions, *args, **kwargs, and useful builtins like map(), filter(), zip().</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#lists--tuples">Lists</a></span> <span class="rm-index-sub-desc">Mutable ordered sequences — indexing, slicing, list methods.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#lists--tuples">Tuples</a></span> <span class="rm-index-sub-desc">Immutable sequences — packing, unpacking, named tuples.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#sets--dictionaries">Sets</a></span> <span class="rm-index-sub-desc">Unordered unique collections — set operations, frozenset.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/basics/#sets--dictionaries">Dictionaries</a></span> <span class="rm-index-sub-desc">Key-value stores — dict comprehensions, .get(), .items(), .update().</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/data-structures-algorithms/">Data Structures &amp; Algorithms</a></h3>
        <p class="rm-index-desc">Classic CS concepts implemented in Python — essential for technical interviews.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#arrays--linked-lists">Arrays and Linked Lists</a></span> <span class="rm-index-sub-desc">Python lists as arrays, implementing singly/doubly linked lists.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#hash-tables">Hash Tables</a></span> <span class="rm-index-sub-desc">Dictionaries under the hood — hashing and collision handling.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#heaps--priority-queues">Heaps, Stacks &amp; Queues</a></span> <span class="rm-index-sub-desc">heapq module, collections.deque, and stack patterns with lists.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#trees--binary-search">Binary Search Tree</a></span> <span class="rm-index-sub-desc">BST properties, insertion, search, and traversal algorithms.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#recursion">Recursion</a></span> <span class="rm-index-sub-desc">Base cases, call stacks, memoization, and tail recursion patterns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/data-structures-algorithms/#sorting--searching">Sorting Algorithms</a></span> <span class="rm-index-sub-desc">Built-in sort(), Timsort, and implementing merge/quick sort.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/modules-packaging/">Modules</a></h3>
        <p class="rm-index-desc">Organising code with modules, packages, and the Python import system.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#modules--imports">Builtin Modules</a></span> <span class="rm-index-sub-desc">os, sys, math, datetime, json, pathlib, collections, itertools.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#packages">Custom Modules</a></span> <span class="rm-index-sub-desc">Creating __init__.py, relative vs absolute imports, __all__.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/functions/#lambdas">Lambdas</a></h3>
        <p class="rm-index-desc">Anonymous functions with lambda — usage with map(), filter(), sorted(), and functional patterns.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/decorators-context-managers/#decorator-fundamentals">Decorators</a></h3>
        <p class="rm-index-desc">Higher-order functions that wrap other functions — functools.wraps, class decorators, stacking decorators.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/comprehensions-generators/#the-iterator-protocol">Iterators</a></h3>
        <p class="rm-index-desc">__iter__ and __next__ protocols, itertools module, lazy evaluation.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/regular-expressions/">Regular Expressions</a></h3>
        <p class="rm-index-desc">Pattern matching with the re module — compile, match, search, findall, groups.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/oop/">Object Oriented Programming</a></h3>
        <p class="rm-index-desc">Python's OOP model — classes, inheritance, magic methods, and encapsulation.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/oop/#classes--instances">Classes</a></span> <span class="rm-index-sub-desc">__init__, instance vs class attributes, @classmethod, @staticmethod, @property.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/oop/#inheritance">Inheritance</a></span> <span class="rm-index-sub-desc">Single/multiple inheritance, super(), MRO (Method Resolution Order).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/oop/#dunder-methods">Methods &amp; Dunder</a></span> <span class="rm-index-sub-desc">__str__, __repr__, __len__, __eq__, __hash__, and operator overloading.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/modules-packaging/#package-managers">Package Managers</a></h3>
        <p class="rm-index-desc">Tools for installing, managing, and isolating Python dependencies.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">pip</a></span> <span class="rm-index-sub-desc">The standard Python package installer — pip install, requirements.txt, pip freeze.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">PyPI</a></span> <span class="rm-index-sub-desc">The Python Package Index — finding, publishing, and versioning packages.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">Poetry</a></span> <span class="rm-index-sub-desc">Modern dependency management with pyproject.toml, lock files, and virtual envs.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#virtual-environments">Conda</a></span> <span class="rm-index-sub-desc">Package and environment manager from Anaconda — great for data science.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">uv</a></span> <span class="rm-index-sub-desc">Ultra-fast Python package and project manager written in Rust.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">Pipenv</a></span> <span class="rm-index-sub-desc">Combines pip and virtualenv — Pipfile and Pipfile.lock.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#virtual-environments">virtualenv</a></span> <span class="rm-index-sub-desc">Creating isolated Python environments.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#virtual-environments">pyenv</a></span> <span class="rm-index-sub-desc">Managing multiple Python versions on the same machine.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/modules-packaging/#package-managers">pyproject.toml</a></span> <span class="rm-index-sub-desc">The modern Python project configuration standard (PEP 517/518).</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/comprehensions-generators/#comprehensions">List Comprehensions</a></h3>
        <p class="rm-index-desc">Concise syntax for building lists — [expr for x in iterable if condition].</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/comprehensions-generators/#generators">Generator Expressions</a></h3>
        <p class="rm-index-desc">Lazy evaluation with (expr for x in iterable) — memory-efficient alternative to list comprehensions.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/functions/#functional-programming">Paradigms</a></h3>
        <p class="rm-index-desc">Python as a multi-paradigm language — functional, procedural, and OOP patterns.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/decorators-context-managers/#context-manager-fundamentals">Context Manager</a></h3>
        <p class="rm-index-desc">The with statement, __enter__/__exit__, contextlib, and resource management patterns.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/web-frameworks/">Learn a Framework</a></h3>
        <p class="rm-index-desc">Web and async frameworks for building APIs, dashboards, and services with Python.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#fastapi">FastAPI</a></span> <span class="rm-index-sub-desc">Modern, high-performance web API framework with automatic docs and type hints.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Django</a></span> <span class="rm-index-sub-desc">Batteries-included web framework — ORM, admin, auth, templates.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Flask</a></span> <span class="rm-index-sub-desc">Lightweight WSGI microframework — great for small APIs and services.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">aiohttp</a></span> <span class="rm-index-sub-desc">Async HTTP client/server framework built on asyncio.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Tornado</a></span> <span class="rm-index-sub-desc">Non-blocking network I/O and web framework.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Sanic</a></span> <span class="rm-index-sub-desc">Fast async web server and framework, built for speed.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Plotly Dash</a></span> <span class="rm-index-sub-desc">Build interactive analytical web apps in pure Python.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">Pyramid</a></span> <span class="rm-index-sub-desc">Flexible web framework — scales from simple to complex apps.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/web-frameworks/#framework-comparison">gevent</a></span> <span class="rm-index-sub-desc">Coroutine-based networking library using greenlets.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/concurrency/">Concurrency</a></h3>
        <p class="rm-index-desc">Running tasks simultaneously in Python — threads, processes, and async.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/concurrency/#the-gil">GIL</a></span> <span class="rm-index-sub-desc">The Global Interpreter Lock — what it is, why it exists, and its impact on threading.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/concurrency/#threading">Threading</a></span> <span class="rm-index-sub-desc">Thread-based parallelism with the threading module — I/O-bound tasks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/concurrency/#multiprocessing">Multiprocessing</a></span> <span class="rm-index-sub-desc">Process-based parallelism — bypassing the GIL for CPU-bound tasks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/concurrency/#asyncio">Asynchrony (asyncio)</a></span> <span class="rm-index-sub-desc">Cooperative multitasking with async/await, event loops, and coroutines.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/static-typing/">Static Typing</a></h3>
        <p class="rm-index-desc">Adding type annotations to Python — improving code quality and IDE support.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/static-typing/#the-typing-module">typing module</a></span> <span class="rm-index-sub-desc">List, Dict, Optional, Union, Callable, TypeVar, and Protocol.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/static-typing/#pydantic--runtime-validation">Pydantic</a></span> <span class="rm-index-sub-desc">Data validation using Python type hints — widely used in FastAPI.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/static-typing/#type-checkers">mypy</a></span> <span class="rm-index-sub-desc">Static type checker for Python — catches type errors before runtime.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/static-typing/#type-checkers">pyright</a></span> <span class="rm-index-sub-desc">Fast type checker from Microsoft — powers Pylance in VS Code.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/static-typing/#type-checkers">pyre</a></span> <span class="rm-index-sub-desc">Type checker from Meta — designed for large codebases.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/code-quality/">Code Formatting</a></h3>
        <p class="rm-index-desc">Keeping Python code consistent, readable, and style-guide compliant.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/code-quality/#formatting">ruff</a></span> <span class="rm-index-sub-desc">Extremely fast Python linter and formatter written in Rust — replaces flake8 + isort.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/code-quality/#formatting">black</a></span> <span class="rm-index-sub-desc">The uncompromising code formatter — opinionated, zero-config formatting.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/code-quality/#formatting">yapf</a></span> <span class="rm-index-sub-desc">Yet Another Python Formatter from Google — highly configurable.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/code-quality/#documentation">Sphinx</a></span> <span class="rm-index-sub-desc">Documentation generator — reStructuredText, autodoc, and Read the Docs.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/data-libraries/">Common Packages</a></h3>
        <p class="rm-index-desc">Essential Python packages for data engineering: NumPy, Pandas, requests, SQLAlchemy, and more.</p>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/python/testing/">Testing</a></h3>
        <p class="rm-index-desc">Writing tests to verify correctness — unit, integration, and property-based testing.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/testing/#pytest-fundamentals">pytest</a></span> <span class="rm-index-sub-desc">The most popular Python testing framework — fixtures, parametrize, plugins.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/testing/#other-testing-tools">unittest / pyUnit</a></span> <span class="rm-index-sub-desc">Python's built-in testing framework based on xUnit patterns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/testing/#other-testing-tools">doctest</a></span> <span class="rm-index-sub-desc">Tests embedded in docstrings — simple and self-documenting.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/testing/#other-testing-tools">tox</a></span> <span class="rm-index-sub-desc">Automate testing across multiple Python versions and environments.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/python/testing/#other-testing-tools">nose</a></span> <span class="rm-index-sub-desc">Test runner extending unittest — largely superseded by pytest.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

// ── Icons ─────────────────────────────────────────────────────────────────────
const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 5 7 9 11 5"/></svg>`;

function iconFor(s: string) {
  if (s === "done") return ICON_DONE;
  if (s === "inprogress") return ICON_INPROGRESS;
  return ICON_PENDING;
}

// ── State ─────────────────────────────────────────────────────────────────────
const KEY = "py_roadmap_v2";
function load(): Record<string, string> {
  try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; }
}
function save(s: Record<string, string>) {
  localStorage.setItem(KEY, JSON.stringify(s));
}

let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id] || "pending"; }

// ── Progress ──────────────────────────────────────────────────────────────────
function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id) === "done").length;
  const pct  = ids.length ? Math.round((done / ids.length) * 100) : 0;
  const bar  = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar)   bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

// ── Build flow ────────────────────────────────────────────────────────────────
function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";

  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);

    // Topic node
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s !== "pending" ? ` is-${s}` : ""}${isCollapsed ? " is-collapsed" : ""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `
      <span class="rm-topic-icon">${iconFor(s)}</span>
      <span class="rm-topic-label">${topic.label}</span>
      ${topic.subs.length ? `<span class="rm-count-badge">${topic.subs.length}</span>` : ""}
      <span class="rm-chevron">${ICON_CHEVRON}</span>
    `;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);

    // Subtopics
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      group.dataset.parent = topic.id;

      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss !== "pending" ? ` is-${ss}` : ""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `
          <span class="rm-sub-icon">${iconFor(ss)}</span>
          <span class="rm-sub-label">${sub.label}</span>
        `;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }

    // Arrow between sections
    if (ti < ROADMAP.length - 1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

// ── Panel (drawer) ────────────────────────────────────────────────────────────
let activeId: string | null = null;
let activeParent: string | null = null;

function findItem(id: string): any {
  for (const t of ROADMAP) {
    if (t.id === id) return { ...t, type: "topic" };
    for (const s of t.subs) { if (s.id === id) return { ...s, type: "subtopic" }; }
  }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId     = id;
  activeParent = parentId ?? null;

  const item = findItem(id);
  if (!item) return;

  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;

  badge.textContent = type === "topic" ? "Topic" : "Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");

  if (type === "topic" && item.subs?.length > 0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss !== "pending" ? ` is-${ss}` : ""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `
        <span class="rm-panel-subitem-icon">${iconFor(ss)}</span>
        <span class="rm-panel-subitem-label">${sub.label}</span>
        <span class="rm-panel-subitem-tag">${ss}</span>
      `;
      row.addEventListener("click", (e) => {
        e.stopPropagation();
        openPanel(sub.id, "subtopic", id);
      });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }

  syncStatusBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncStatusBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s;
  save(state);
  buildFlow();
  refreshProgress();
  syncStatusBtns();
  // Refresh subitem row if panel is showing a topic
  if (activeParent) {
    const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
    if (row) {
      row.className = `rm-panel-subitem${s !== "pending" ? ` is-${s}` : ""}`;
      row.dataset.subId = id;
      const icon = row.querySelector(".rm-panel-subitem-icon");
      const tag  = row.querySelector(".rm-panel-subitem-tag");
      if (icon) icon.innerHTML = iconFor(s);
      if (tag)  tag.textContent = s;
    }
  }
}

// ── Wire up ───────────────────────────────────────────────────────────────────
buildFlow();
refreshProgress();

document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key === "Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});

document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (!activeId) return;
  setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
