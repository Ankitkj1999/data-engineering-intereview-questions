---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "System Design Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">System Design</h1>
        <p class="rm-subtitle">Step-by-step guide to designing data systems at scale</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"pipeline-architecture-reliability-fundamentals", label:"Pipeline Architecture & Reliability Fundamentals", desc:"11 interview questions covering Batch Design, Streaming, Reliability, Data Quality and more.", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals", subs:[
    { id:"pipeline-architecture-reliability-fundamentals-batch-design", label:"Batch Design", desc:"How would you design a batch analytics pipeline?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-streaming", label:"Streaming", desc:"How would you design a near-real-time ingestion pipeline?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-reliability", label:"Reliability", desc:"How do you ensure idempotency in data pipelines? What reliability patterns do you use for production data pipelines?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-data-quality", label:"Data Quality", desc:"How do you handle late-arriving events and backfills?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-architecture", label:"Architecture", desc:"Streaming is chosen for low latency and continuous updates, but it adds real complexity — state management, ordering, exactly-once semantics.", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-data-modeling", label:"Data Modeling", desc:"What is the raw/silver/gold layering pattern, and why use it?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-platform-design", label:"Platform Design", desc:"How do you design a multi-tenant data platform?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-schema", label:"Schema", desc:"How do you handle schema evolution in a data platform?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-observability", label:"Observability", desc:"What does platform observability look like for a data system?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
    { id:"pipeline-architecture-reliability-fundamentals-cost", label:"Cost", desc:"How do you manage cost vs. SLA trade-offs in system design?", link:"/level-4-advanced/system-design/#pipeline-architecture--reliability-fundamentals" },
  ]},
  { id:"distributed-systems-fundamentals", label:"Distributed Systems Fundamentals", desc:"8 interview questions covering CAP Theorem, Consistency Models, Replication, Partitioning and more.", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals", subs:[
    { id:"distributed-systems-fundamentals-cap-theorem", label:"CAP Theorem", desc:"What is the CAP theorem, and how does it shape data platform design?", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-consistency-models", label:"Consistency Models", desc:"Strong consistency guarantees every read sees the latest write, at the cost of latency and availability under partition — appropriate for something like a ledger balance or a feature store used for real-time decisions.", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-replication", label:"Replication", desc:"Leader-follower (single-leader) replication routes all writes through one node and fans reads out to followers — simple to reason about, but the leader is a write bottleneck and failover involves promoting a follower.", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-partitioning", label:"Partitioning", desc:"How do you partition or shard a large dataset, and what causes hot partitions?", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-consensus", label:"Consensus", desc:"At a high level, why do distributed systems need consensus algorithms like Paxos or Raft?", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-distributed-transactions", label:"Distributed Transactions", desc:"How do two-phase commit (2PC) and the Saga pattern differ for handling cross-system transactions?", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-event-ordering", label:"Event Ordering", desc:"Clocks on different machines drift and aren't perfectly synchronized even with NTP, so two events in true causal order can end up with out-of-order or identical timestamps once they cross machines.", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
    { id:"distributed-systems-fundamentals-quorum-systems", label:"Quorum Systems", desc:"In an N-replica system, a quorum requires W (write) and R (read) nodes to acknowledge an operation such that W + R &gt; N, guaranteeing overlap between any write set and any read set — that overlap is what lets a read see the latest write.", link:"/level-4-advanced/system-design/#distributed-systems-fundamentals" },
  ]},
  { id:"storage-database-selection", label:"Storage & Database Selection", desc:"8 interview questions covering Database Selection, Storage Architecture, OLTP vs OLAP, Storage Formats and more.", link:"/level-4-advanced/system-design/#storage--database-selection", subs:[
    { id:"storage-database-selection-database-selection", label:"Database Selection", desc:"How do you decide between a SQL and a NoSQL database for a given system?", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-storage-architecture", label:"Storage Architecture", desc:"A data warehouse is the right choice when consumers are BI/analytics workloads that need fast, structured, governed SQL access and you're willing to pay for schema-on-write and warehouse compute.", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-oltp-vs-olap", label:"OLTP vs OLAP", desc:"OLTP systems are optimized for many small, concurrent read/write transactions against a normalized schema — a single row insert/update, sub-millisecond latency, ACID guarantees.", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-storage-formats", label:"Storage Formats", desc:"Row-oriented storage keeps all columns of a record together on disk, which is efficient when you read or write whole records — the OLTP pattern.", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-indexing", label:"Indexing", desc:"Index the columns your queries actually filter, join, or sort on — every index speeds up reads but slows down writes and costs storage, so indexing everything \"just in case\" is a common anti-pattern.", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-caching", label:"Caching", desc:"What are the main caching strategies, and how do you keep a cache consistent with its source of truth?", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-messaging-systems", label:"Messaging Systems", desc:"How do you choose between Kafka, a cloud pub/sub service, and a traditional message queue for ingestion?", link:"/level-4-advanced/system-design/#storage--database-selection" },
    { id:"storage-database-selection-time-series-design", label:"Time-Series Design", desc:"How do you design storage for high-volume time-series or IoT sensor data?", link:"/level-4-advanced/system-design/#storage--database-selection" },
  ]},
  { id:"scalability-capacity-planning", label:"Scalability & Capacity Planning", desc:"6 interview questions covering Scalability, Capacity Estimation, Hot Partitions, Backpressure and more.", link:"/level-4-advanced/system-design/#scalability--capacity-planning", subs:[
    { id:"scalability-capacity-planning-scalability", label:"Scalability", desc:"Vertical scaling means adding more CPU/RAM/disk to a single node — simple, no distributed-systems complexity, but bounded by the biggest machine you can buy and creates a single point of failure.", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
    { id:"scalability-capacity-planning-capacity-estimation", label:"Capacity Estimation", desc:"How would you approach a back-of-the-envelope capacity estimation question in a system design interview?", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
    { id:"scalability-capacity-planning-hot-partitions", label:"Hot Partitions", desc:"How do you detect and fix a hot key or hot partition once a system is already in production?", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
    { id:"scalability-capacity-planning-backpressure", label:"Backpressure", desc:"Backpressure is what happens when a downstream consumer processes events slower than an upstream producer sends them — without handling it, the gap fills a buffer until it overflows and you either drop data or crash.", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
    { id:"scalability-capacity-planning-load-balancing", label:"Load Balancing", desc:"Round-robin is simplest and works well when requests are roughly uniform in cost, but breaks down if some requests are much more expensive than others.", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
    { id:"scalability-capacity-planning-auto-scaling", label:"Auto-Scaling", desc:"How do you design auto-scaling for variable data pipeline load, like a batch cluster or a streaming consumer group?", link:"/level-4-advanced/system-design/#scalability--capacity-planning" },
  ]},
  { id:"fault-tolerance-dr-high-availability", label:"Fault Tolerance, DR & High Availability", desc:"6 interview questions covering Disaster Recovery, Multi-Region Design, Failover Design, Backup Strategy and more.", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability", subs:[
    { id:"fault-tolerance-dr-high-availability-disaster-recovery", label:"Disaster Recovery", desc:"RPO (Recovery Point Objective) is how much data you can afford to lose, measured in time — an RPO of 15 minutes means your backup/replication cadence must guarantee you never lose more than 15 minutes of data.", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
    { id:"fault-tolerance-dr-high-availability-multi-region-design", label:"Multi-Region Design", desc:"What's the difference between active-active and active-passive multi-region architecture, and what does each cost you?", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
    { id:"fault-tolerance-dr-high-availability-failover-design", label:"Failover Design", desc:"How do you design failover to avoid a split-brain scenario?", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
    { id:"fault-tolerance-dr-high-availability-backup-strategy", label:"Backup Strategy", desc:"What backup strategies would you use for a data platform, and how do you validate they actually work?", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
    { id:"fault-tolerance-dr-high-availability-graceful-degradation", label:"Graceful Degradation", desc:"How do circuit breakers and graceful degradation apply to data pipeline design?", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
    { id:"fault-tolerance-dr-high-availability-chaos-engineering", label:"Chaos Engineering", desc:"What is chaos engineering, and how would you apply it to a data pipeline?", link:"/level-4-advanced/system-design/#fault-tolerance-dr--high-availability" },
  ]},
  { id:"data-contracts-governance-security-by-design", label:"Data Contracts, Governance & Security by Design", desc:"7 interview questions covering Access Control, PII & Masking, Data Lineage, Audit Logging and more.", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design", subs:[
    { id:"data-contracts-governance-security-by-design-access-control", label:"Access Control", desc:"Role-based access control (RBAC) grants permissions to roles rather than individuals, which scales better as headcount grows — you manage a handful of roles instead of per-person grants.", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-pii-masking", label:"PII & Masking", desc:"How do you design PII handling and data masking into a platform, rather than bolting it on afterward?", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-data-lineage", label:"Data Lineage", desc:"How would you design data lineage tracking into a platform?", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-audit-logging", label:"Audit Logging", desc:"How would you design audit logging for a data platform that needs to support a compliance investigation?", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-data-contracts", label:"Data Contracts", desc:"What is a data contract, and how do you design one between a producer and consumer team?", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-encryption-design", label:"Encryption Design", desc:"Encryption in transit (TLS between every service-to-service and client-to-service hop) protects data from network interception and is close to table-stakes today.", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
    { id:"data-contracts-governance-security-by-design-self-serve-platform", label:"Self-Serve Platform", desc:"How would you design a self-serve data platform that lets other teams build pipelines without your team as a bottleneck?", link:"/level-4-advanced/system-design/#data-contracts-governance--security-by-design" },
  ]},
  { id:"applied-system-design-case-studies", label:"Applied System Design Case Studies", desc:"11 interview questions covering Case Study: Analytics Dashboard, Case Study: Log Aggregation, Case Study: Ride-Sharing, Case Study: Fraud Detection and more.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies", subs:[
    { id:"applied-system-design-case-studies-case-study-analytics-dashboard", label:"Case Study: Analytics Dashboard", desc:"Events (page views, clicks) are produced from client SDKs into a durable log (Kafka/Kinesis), partitioned by a key like session or user ID so related events land on the same partition and preserve order.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-log-aggregation", label:"Case Study: Log Aggregation", desc:"Design a log aggregation and search platform, similar to the ELK stack or Splunk.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-ride-sharing", label:"Case Study: Ride-Sharing", desc:"Design the data pipeline for a ride-sharing platform (trip events, driver location, surge pricing).", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-fraud-detection", label:"Case Study: Fraud Detection", desc:"Design a real-time fraud detection pipeline for financial transactions.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-recommendations", label:"Case Study: Recommendations", desc:"Design the offline/online data pipeline for a recommendation system.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-feature-store", label:"Case Study: Feature Store", desc:"Design a feature store for machine learning.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-notifications", label:"Case Study: Notifications", desc:"Design a notification/alert delivery pipeline that needs to reach users across email, SMS, and push.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-metrics-platform", label:"Case Study: Metrics Platform", desc:"Design a metrics and monitoring platform, similar to Datadog or Prometheus, for ingesting time-series data at scale.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-data-catalog", label:"Case Study: Data Catalog", desc:"Design a data catalog / metadata discovery platform for an organization with hundreds of datasets.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-payments-reconciliation", label:"Case Study: Payments Reconciliation", desc:"Design a reconciliation pipeline to catch discrepancies between a payments system and its downstream ledger.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
    { id:"applied-system-design-case-studies-case-study-gdpr-deletion", label:"Case Study: GDPR Deletion", desc:"Design a data pipeline that can fulfill GDPR 'right to be forgotten' deletion requests across a data platform.", link:"/level-4-advanced/system-design/#applied-system-design-case-studies" },
  ]},
  { id:"slas-delivery-cost-at-scale", label:"SLAs, Delivery & Cost at Scale", desc:"6 interview questions covering SLAs & Error Budgets, Freshness Monitoring, Cost Attribution, Deployment Strategy and more.", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale", subs:[
    { id:"slas-delivery-cost-at-scale-slas-error-budgets", label:"SLAs & Error Budgets", desc:"An SLA is the external commitment, often with a consequence attached — \"the daily sales table is available by 8am, 99.5% of the time.\" An SLO is the internal target you actually engineer to, usually stricter than the SLA to leave margin.", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
    { id:"slas-delivery-cost-at-scale-freshness-monitoring", label:"Freshness Monitoring", desc:"How would you design end-to-end data freshness monitoring across a multi-stage pipeline?", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
    { id:"slas-delivery-cost-at-scale-cost-attribution", label:"Cost Attribution", desc:"How do you design cost attribution or chargeback for a shared, multi-tenant data platform?", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
    { id:"slas-delivery-cost-at-scale-deployment-strategy", label:"Deployment Strategy", desc:"How would you design a safe deployment strategy (blue-green or canary) for changes to a production data pipeline?", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
    { id:"slas-delivery-cost-at-scale-testing-strategy", label:"Testing Strategy", desc:"What testing strategy would you design for a data platform, beyond unit tests for transformation code?", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
    { id:"slas-delivery-cost-at-scale-internal-data-apis", label:"Internal Data APIs", desc:"How would you design an internal data API or service layer to serve derived data to other teams, instead of giving them direct table access?", link:"/level-4-advanced/system-design/#slas-delivery--cost-at-scale" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "system_design_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
