---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Apache Iceberg Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Iceberg</h1>
        <p class="rm-subtitle">Step-by-step guide to open table format design</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"core-concepts", label:"Core Concepts", desc:"15 interview questions covering Fundamentals, Snapshots, Time Travel, Concurrency and more.", link:"/level-3-technologies/formats/iceberg/#interview-questions", subs:[
    { id:"core-concepts-fundamentals", label:"Fundamentals", desc:"Apache Iceberg is an open table format for large analytics datasets.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-snapshots", label:"Snapshots", desc:"1 interview question on snapshots, in the Core Concepts section.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-time-travel", label:"Time Travel", desc:"Time travel means querying the table \"as of\" a previous snapshot (or timestamp).", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-concurrency", label:"Concurrency", desc:"Iceberg typically uses optimistic concurrency control.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-partitioning", label:"Partitioning", desc:"Hidden partitioning means partitioning is defined at the table metadata level (for example day(ts)), not as user-managed folder paths.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-schema", label:"Schema", desc:"Iceberg tracks columns by unique field IDs, enabling safe add/drop/rename operations without breaking readers.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-deletes", label:"Deletes", desc:"Deletes in Iceberg can be represented as separate delete files: - Equality deletes — delete rows matching a key predicate (for example id = 123).", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-dml", label:"DML", desc:"Upserts are usually implemented by engines (Spark, Flink, Trino) using MERGE INTO semantics, which may create new data files and delete files.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-maintenance", label:"Maintenance", desc:"Small files appear when many writers write tiny batches, or when streaming jobs checkpoint frequently.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-catalogs", label:"Catalogs", desc:"A catalog stores table metadata pointers and namespace information.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-migration", label:"Migration", desc:"You typically create an Iceberg table schema and then either: - Register existing files in place (where supported), if they already conform to the expected layout.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
    { id:"core-concepts-comparison", label:"Comparison", desc:"Iceberg is a strong choice when you need an open, engine-agnostic table format with robust metadata, time travel, and evolution features.", link:"/level-3-technologies/formats/iceberg/#interview-questions" },
  ]},
  { id:"advanced-iceberg-features", label:"Advanced Iceberg Features", desc:"5 interview questions covering DML, Branching, Optimization, Metadata.", link:"/level-3-technologies/formats/iceberg/#advanced-iceberg-features", subs:[
    { id:"advanced-iceberg-features-dml", label:"DML", desc:"Copy-on-write rewrites entire affected data files immediately when a row changes — reads stay simple and fast (no delete files to reconcile), but writes are…", link:"/level-3-technologies/formats/iceberg/#advanced-iceberg-features" },
    { id:"advanced-iceberg-features-branching", label:"Branching", desc:"Branches and tags are named references to specific snapshots — a branch can keep advancing (like a git branch), while a tag pins one snapshot permanently (for a monthly archive, say).", link:"/level-3-technologies/formats/iceberg/#advanced-iceberg-features" },
    { id:"advanced-iceberg-features-optimization", label:"Optimization", desc:"Partitioning determines which files a query needs to scan at all (coarse-grained pruning); sort order determines how rows are physically ordered within those…", link:"/level-3-technologies/formats/iceberg/#advanced-iceberg-features" },
    { id:"advanced-iceberg-features-metadata", label:"Metadata", desc:"A manifest lists a set of data (or delete) files along with per-file statistics (partition values, row counts, column bounds) used for pruning.", link:"/level-3-technologies/formats/iceberg/#advanced-iceberg-features" },
  ]},
  { id:"catalogs-governance-multi-engine-operations", label:"Catalogs, Governance & Multi-Engine Operations", desc:"4 interview questions covering Catalogs, Transactions, Views, Spec Versions.", link:"/level-3-technologies/formats/iceberg/#catalogs-governance--multi-engine-operations", subs:[
    { id:"catalogs-governance-multi-engine-operations-catalogs", label:"Catalogs", desc:"The REST catalog exposes catalog operations (list tables, load metadata, commit changes) over a standard HTTP API instead of requiring every engine to speak a…", link:"/level-3-technologies/formats/iceberg/#catalogs-governance--multi-engine-operations" },
    { id:"catalogs-governance-multi-engine-operations-transactions", label:"Transactions", desc:"Yes — multi-table transactions let several tables' changes commit together atomically (all succeed or none do), useful when a logical unit of work spans more…", link:"/level-3-technologies/formats/iceberg/#catalogs-governance--multi-engine-operations" },
    { id:"catalogs-governance-multi-engine-operations-views", label:"Views", desc:"Yes — the Iceberg view specification defines views with engine-specific SQL dialect variants stored in the same metadata/catalog system as tables, so a view…", link:"/level-3-technologies/formats/iceberg/#catalogs-governance--multi-engine-operations" },
    { id:"catalogs-governance-multi-engine-operations-spec-versions", label:"Spec Versions", desc:"V1 supports append-only and copy-on-write style tables without row-level delete files.", link:"/level-3-technologies/formats/iceberg/#catalogs-governance--multi-engine-operations" },
  ]},
  { id:"operational-patterns", label:"Operational Patterns", desc:"3 interview questions covering Streaming, Configuration, Migration.", link:"/level-3-technologies/formats/iceberg/#operational-patterns", subs:[
    { id:"operational-patterns-streaming", label:"Streaming", desc:"A streaming sink batches incoming records over a checkpoint interval and commits them as a new Iceberg snapshot at each checkpoint, rather than committing…", link:"/level-3-technologies/formats/iceberg/#operational-patterns" },
    { id:"operational-patterns-configuration", label:"Configuration", desc:"Target file size (write.target-file-size-bytes) to control how large compacted files end up, the delete file mode (copy-on-write vs.", link:"/level-3-technologies/formats/iceberg/#operational-patterns" },
    { id:"operational-patterns-migration", label:"Migration", desc:"Because readers always query against a specific snapshot, you can write the entire rewritten dataset as new data files and commit it as a new snapshot —…", link:"/level-3-technologies/formats/iceberg/#operational-patterns" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "iceberg_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
