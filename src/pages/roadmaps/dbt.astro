---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "dbt Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">dbt</h1>
        <p class="rm-subtitle">Step-by-step guide to analytics engineering with dbt</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"core-concepts", label:"Core Concepts", desc:"15 interview questions covering Fundamentals, Orchestration, Models, Project Structure and more.", link:"/level-3-technologies/transformation/dbt/#interview-questions", subs:[
    { id:"core-concepts-fundamentals", label:"Fundamentals", desc:"1 interview question on fundamentals, in the Core Concepts section.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-orchestration", label:"Orchestration", desc:"Airflow is an orchestration system that schedules and coordinates tasks of any kind.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-models", label:"Models", desc:"A dbt model is a select query stored as a .sql file in the models/ directory.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-project-structure", label:"Project Structure", desc:"A common pattern is: - staging — light cleaning and renaming, close to sources - intermediate — reusable transformations and joins - marts — business-facing…", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-materializations", label:"Materializations", desc:"A materialization defines how dbt builds a model in the warehouse (for example, as a view, table, or incremental table).", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-incremental-models", label:"Incremental Models", desc:"An incremental model only processes new or changed data instead of rebuilding the entire table each run.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-testing", label:"Testing", desc:"2 interview questions on testing, in the Core Concepts section.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-snapshots", label:"Snapshots", desc:"Snapshots capture slowly changing dimension history by tracking changes in source records over time.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-macros", label:"Macros", desc:"1 interview question on macros, in the Core Concepts section.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
    { id:"core-concepts-ci-cd", label:"CI/CD", desc:"State selection runs only models that changed (and their dependents) compared to a previous artifact state.", link:"/level-3-technologies/transformation/dbt/#interview-questions" },
  ]},
  { id:"seeds-sources-project-configuration", label:"Seeds, Sources & Project Configuration", desc:"5 interview questions covering Seeds, Configuration, Documentation.", link:"/level-3-technologies/transformation/dbt/#seeds-sources--project-configuration", subs:[
    { id:"seeds-sources-project-configuration-seeds", label:"Seeds", desc:"A seed is a CSV file in the seeds/ directory that dbt loads into the warehouse as a table via dbt seed.", link:"/level-3-technologies/transformation/dbt/#seeds-sources--project-configuration" },
    { id:"seeds-sources-project-configuration-configuration", label:"Configuration", desc:"A target in profiles.yml defines a specific connection (dev, staging, prod) — its warehouse, schema, and credentials — and dbt commands run against whichever target is active.", link:"/level-3-technologies/transformation/dbt/#seeds-sources--project-configuration" },
    { id:"seeds-sources-project-configuration-documentation", label:"Documentation", desc:"An exposure declares a downstream consumer of dbt models — a BI dashboard, an ML pipeline, a reverse-ETL sync — as a first-class object in dbt docs, linked to the specific models it depends on.", link:"/level-3-technologies/transformation/dbt/#seeds-sources--project-configuration" },
  ]},
  { id:"materializations-incremental-strategies", label:"Materializations & Incremental Strategies", desc:"5 interview questions covering Materializations, Incremental Models, Contracts, Hooks.", link:"/level-3-technologies/transformation/dbt/#materializations--incremental-strategies", subs:[
    { id:"materializations-incremental-strategies-materializations", label:"Materializations", desc:"An ephemeral model isn't built as its own view or table in the warehouse at all — it's inlined as a CTE into every model that references it via ref().", link:"/level-3-technologies/transformation/dbt/#materializations--incremental-strategies" },
    { id:"materializations-incremental-strategies-incremental-models", label:"Incremental Models", desc:"2 interview questions on incremental models, in the Materializations & Incremental Strategies section.", link:"/level-3-technologies/transformation/dbt/#materializations--incremental-strategies" },
    { id:"materializations-incremental-strategies-contracts", label:"Contracts", desc:"1 interview question on contracts, in the Materializations & Incremental Strategies section.", link:"/level-3-technologies/transformation/dbt/#materializations--incremental-strategies" },
    { id:"materializations-incremental-strategies-hooks", label:"Hooks", desc:"{{ config( pre_hook=\"INSERT INTO audit_log (model, started_at) VALUES ('{{ this }}', current_timestamp)\", post_hook=\"GRANT SELECT ON {{ this }} TO ROLE…", link:"/level-3-technologies/transformation/dbt/#materializations--incremental-strategies" },
  ]},
  { id:"jinja-packages", label:"Jinja & Packages", desc:"4 interview questions covering Jinja, Packages, Testing.", link:"/level-3-technologies/transformation/dbt/#jinja--packages", subs:[
    { id:"jinja-packages-jinja", label:"Jinja", desc:"SELECT order_id, {% for status in [\"pending\", \"shipped\", \"cancelled\"] %} SUM(CASE WHEN status = '{{ status }}' THEN 1 ELSE 0 END) AS {{ status }}_count{{ \",\"…", link:"/level-3-technologies/transformation/dbt/#jinja--packages" },
    { id:"jinja-packages-packages", label:"Packages", desc:"2 interview questions on packages, in the Jinja & Packages section.", link:"/level-3-technologies/transformation/dbt/#jinja--packages" },
    { id:"jinja-packages-testing", label:"Testing", desc:"- macros/test_is_positive.sql {% test is_positive(model, column_name) %} SELECT  FROM {{ model }} WHERE {{ column_name }} <= 0 {% endtest %} columns: - name:…", link:"/level-3-technologies/transformation/dbt/#jinja--packages" },
  ]},
  { id:"documentation-governance-ecosystem", label:"Documentation, Governance & Ecosystem", desc:"6 interview questions covering Documentation, Testing, Governance, Ecosystem and more.", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem", subs:[
    { id:"documentation-governance-ecosystem-documentation", label:"Documentation", desc:"1 interview question on documentation, in the Documentation, Governance & Ecosystem section.", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
    { id:"documentation-governance-ecosystem-testing", label:"Testing", desc:"1 interview question on testing, in the Documentation, Governance & Ecosystem section.", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
    { id:"documentation-governance-ecosystem-governance", label:"Governance", desc:"1 interview question on governance, in the Documentation, Governance & Ecosystem section.", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
    { id:"documentation-governance-ecosystem-ecosystem", label:"Ecosystem", desc:"1 interview question on ecosystem, in the Documentation, Governance & Ecosystem section.", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
    { id:"documentation-governance-ecosystem-python-models", label:"Python Models", desc:"On warehouses that support it (Snowflake, Databricks, BigQuery), a dbt model can be a .py file returning a DataFrame instead of a .sql file — it still…", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
    { id:"documentation-governance-ecosystem-semantic-layer", label:"Semantic Layer", desc:"The Semantic Layer lets you define metrics (revenue, active users) once in code, with their aggregation logic and dimensions, and have every BI tool and query…", link:"/level-3-technologies/transformation/dbt/#documentation-governance--ecosystem" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "dbt_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
