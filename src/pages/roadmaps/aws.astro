---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/aws.json";
---

<StarlightPage
  frontmatter={{
    title: "AWS Services Roadmap",
    description: "A complete, interactive map of every AWS service across all 17 categories — compute, storage, databases, networking, security, analytics, ML/AI, and more — with progress tracking.",
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">AWS Services</h1>
        <p class="rm-subtitle">Complete map of every AWS service across all categories — track what you've learned or used in production</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-filter-row">
          <div class="rm-filter-toggle" id="rm-filter-toggle">
            <button type="button" class="rm-filter-btn" data-mode="de">Data Engineering</button>
            <button type="button" class="rm-filter-btn" data-mode="all">All services</button>
          </div>
          <span class="rm-filter-count" id="rm-filter-count"></span>
        </div>
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading">AWS Overview</h3>
        <p class="rm-index-desc">Foundational AWS concepts, frameworks, and account-level basics every cloud practitioner should know before diving into individual services.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label">AWS Cloud Adoption Framework (CAF)</span> <span class="rm-index-sub-desc">A framework of guidance and best practices across six perspectives (business, people, governance, platform, security, operations) for planning and executing cloud transformation.</span></li>
          <li><span class="rm-index-sub-label">AWS Design Principles</span> <span class="rm-index-sub-desc">Core architectural principles — scalability, disposable resources, automation, loose coupling, and designing for failure — that underpin the Well-Architected Framework.</span></li>
          <li><span class="rm-index-sub-label">AWS Disaster Recovery</span> <span class="rm-index-sub-desc">Strategies for recovering workloads after failure: Backup &amp; Restore, Pilot Light, Warm Standby, and Multi-Site active/active, trading cost against RTO/RPO.</span></li>
          <li><span class="rm-index-sub-label">AWS Global Infrastructure</span> <span class="rm-index-sub-desc">Regions, Availability Zones, Edge Locations, and Local Zones — the physical footprint AWS uses to deliver low-latency, fault-tolerant services worldwide.</span></li>
          <li><span class="rm-index-sub-label">AWS Pricing</span> <span class="rm-index-sub-desc">Pay-as-you-go pricing models — On-Demand, Reserved, Spot, and Savings Plans — plus free tier and pricing calculator tools for cost estimation.</span></li>
          <li><span class="rm-index-sub-label">AWS Support Plans</span> <span class="rm-index-sub-desc">Basic, Developer, Business, and Enterprise support tiers — differ in response times, Technical Account Manager access, and architectural guidance.</span></li>
          <li><span class="rm-index-sub-label">Six Pillars of Well-Architected Framework</span> <span class="rm-index-sub-desc">Operational Excellence, Security, Reliability, Performance Efficiency, Cost Optimization, and Sustainability — the lenses AWS uses to review workload architectures.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/cloud/aws-compute/">AWS Compute Services</a></h3>
        <p class="rm-index-desc">Services for running application code and containers — from fully managed serverless functions to full control over virtual machines.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#containers-ecs-eks--fargate">Amazon EKS</a></span> <span class="rm-index-sub-desc">Managed Kubernetes control plane — runs upstream Kubernetes so you can use standard tooling without managing master nodes yourself.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#ec2">Amazon EC2</a></span> <span class="rm-index-sub-desc">Resizable virtual servers in the cloud — the foundational compute building block, with dozens of instance families and purchasing options.</span></li>
          <li><span class="rm-index-sub-label">Amazon ECR</span> <span class="rm-index-sub-desc">Fully managed Docker/OCI container registry — integrates with ECS, EKS, and Lambda for storing and deploying container images.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#containers-ecs-eks--fargate">Amazon ECS</a></span> <span class="rm-index-sub-desc">AWS's native container orchestration service — runs containers on EC2 or Fargate with deep integration into the AWS ecosystem.</span></li>
          <li><span class="rm-index-sub-label">Amazon Lightsail</span> <span class="rm-index-sub-desc">Simplified virtual private servers with predictable pricing — bundles compute, storage, and networking for simple web apps and small projects.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#aws-batch">AWS Batch</a></span> <span class="rm-index-sub-desc">Fully managed batch computing — dynamically provisions the optimal compute resources based on the volume and requirements of submitted jobs.</span></li>
          <li><span class="rm-index-sub-label">AWS Elastic Beanstalk</span> <span class="rm-index-sub-desc">PaaS that automates deployment — upload code and Beanstalk handles capacity provisioning, load balancing, scaling, and health monitoring.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#containers-ecs-eks--fargate">AWS Fargate</a></span> <span class="rm-index-sub-desc">Serverless compute engine for containers — run ECS or EKS tasks without provisioning or managing the underlying EC2 instances.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-compute/#aws-lambda">AWS Lambda</a></span> <span class="rm-index-sub-desc">Event-driven, serverless compute — run code in response to triggers without provisioning servers, billed per invocation and duration.</span></li>
          <li><span class="rm-index-sub-label">AWS ParallelCluster</span> <span class="rm-index-sub-desc">Open-source cluster management tool for deploying and managing HPC clusters on AWS, built on top of AWS Batch or Slurm.</span></li>
          <li><span class="rm-index-sub-label">AWS Serverless Application Model (SAM)</span> <span class="rm-index-sub-desc">Open-source framework with a shorthand CloudFormation syntax for defining, building, and deploying serverless applications (Lambda, API Gateway, DynamoDB).</span></li>
          <li><span class="rm-index-sub-label">AWS Serverless Application Repository</span> <span class="rm-index-sub-desc">Managed repository for discovering, deploying, and publishing reusable serverless applications packaged with AWS SAM.</span></li>
          <li><span class="rm-index-sub-label">AWS Savings Plan</span> <span class="rm-index-sub-desc">Flexible pricing model offering lower rates in exchange for a committed hourly spend on compute usage over a 1 or 3 year term.</span></li>
          <li><span class="rm-index-sub-label">AWS Wavelength</span> <span class="rm-index-sub-desc">Embeds AWS compute and storage at the edge of 5G telecom networks to deliver ultra-low-latency applications to mobile devices.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/cloud/aws-storage/">AWS Storage Services</a></h3>
        <p class="rm-index-desc">Object, block, file, and archival storage services covering every durability, access-pattern, and cost tier.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#block--file-storage">Amazon EBS</a></span> <span class="rm-index-sub-desc">Persistent block storage volumes for EC2 instances — gp3/gp2 SSD, io2/io1 provisioned IOPS, and st1/sc1 HDD volume types.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#block--file-storage">Amazon EFS</a></span> <span class="rm-index-sub-desc">Fully managed elastic NFS file system — scales automatically and can be mounted concurrently across thousands of EC2 instances.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#block--file-storage">Amazon FSx</a></span> <span class="rm-index-sub-desc">Managed third-party file systems — FSx for Windows File Server, Lustre, NetApp ONTAP, and OpenZFS, each optimized for different workloads.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#s3-storage-classes--lifecycle">Amazon S3 Glacier</a></span> <span class="rm-index-sub-desc">Low-cost archival storage class with retrieval tiers (Expedited, Standard, Bulk) ranging from minutes to hours for rarely accessed data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#amazon-s3">Amazon S3</a></span> <span class="rm-index-sub-desc">Object storage with virtually unlimited scale, 11 nines of durability, and storage classes spanning frequent access to deep archive.</span></li>
          <li><span class="rm-index-sub-label">AWS Backup</span> <span class="rm-index-sub-desc">Centralized, policy-based backup service that manages backups across EBS, RDS, DynamoDB, EFS, and other AWS services from one place.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#data-transfer--hybrid-storage">AWS Snowball Edge</a></span> <span class="rm-index-sub-desc">Physical, ruggedized device for offline bulk data transfer and edge compute in disconnected or bandwidth-constrained environments.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#data-transfer--hybrid-storage">AWS Snowmobile</a></span> <span class="rm-index-sub-desc">Exabyte-scale data transfer service using a shipping container on a truck — for migrations too large for Snowball devices.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#data-transfer--hybrid-storage">AWS Storage Gateway</a></span> <span class="rm-index-sub-desc">Hybrid storage service connecting on-premises environments to AWS storage — File, Volume, and Tape Gateway modes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-storage/#data-transfer--hybrid-storage">AWS Transfer Family</a></span> <span class="rm-index-sub-desc">Fully managed SFTP, FTPS, and FTP file transfer directly into and out of Amazon S3 or EFS.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/cloud/aws-databases/">AWS Database Services</a></h3>
        <p class="rm-index-desc">Purpose-built managed database engines spanning relational, key-value, document, in-memory, graph, and ledger workloads.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#rds--aurora">Amazon Aurora</a></span> <span class="rm-index-sub-desc">MySQL- and PostgreSQL-compatible relational engine built for the cloud — up to 5x MySQL throughput with storage that auto-scales to 128TB.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#purpose-built-databases">Amazon DocumentDB</a></span> <span class="rm-index-sub-desc">Managed, MongoDB-compatible document database designed for JSON workloads with the scalability and durability of AWS-managed infrastructure.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#dynamodb">Amazon DynamoDB</a></span> <span class="rm-index-sub-desc">Fully managed, serverless key-value and document database delivering single-digit millisecond performance at any scale.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#caching-elasticache--memorydb">Amazon ElastiCache</a></span> <span class="rm-index-sub-desc">Managed in-memory data store supporting Redis and Memcached engines for caching, session storage, and real-time analytics.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#caching-elasticache--memorydb">Amazon MemoryDB for Redis</a></span> <span class="rm-index-sub-desc">Redis-compatible, durable in-memory database used as a primary database, not just a cache, with multi-AZ durability.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#purpose-built-databases">Amazon Neptune</a></span> <span class="rm-index-sub-desc">Managed graph database supporting Property Graph and RDF models, queried with Gremlin, openCypher, and SPARQL.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#purpose-built-databases">Amazon Quantum Ledger Database (QLDB)</a></span> <span class="rm-index-sub-desc">Fully managed ledger database providing a transparent, immutable, cryptographically verifiable transaction log; AWS has moved new customers toward Aurora PostgreSQL with QLDB extensions.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#rds--aurora">Amazon RDS</a></span> <span class="rm-index-sub-desc">Managed relational database service supporting MySQL, PostgreSQL, MariaDB, Oracle, SQL Server, and Aurora with automated backups and patching.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#redshift">Amazon Redshift</a></span> <span class="rm-index-sub-desc">Petabyte-scale, columnar data warehouse for OLAP workloads — uses massively parallel processing (MPP) across clustered nodes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-databases/#redshift">Amazon Redshift Serverless</a></span> <span class="rm-index-sub-desc">Runs and scales Redshift data warehouse capacity automatically based on workload demand, without managing clusters.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/cloud/aws-migration/">AWS Migration Services</a></h3>
        <p class="rm-index-desc">Tools for moving data, servers, and entire environments from on-premises or other clouds into AWS.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-migration/#database-migration-service">AWS Database Migration Service</a></span> <span class="rm-index-sub-desc">Migrates databases to AWS with minimal downtime, supporting homogeneous and heterogeneous migrations (e.g. Oracle to Aurora) plus ongoing replication.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-migration/#bulk--file-transfer">AWS DataSync</a></span> <span class="rm-index-sub-desc">Automates and accelerates online data transfer between on-premises storage, other clouds, and AWS storage services.</span></li>
          <li><span class="rm-index-sub-label">AWS Migration Strategies — The 6 R's</span> <span class="rm-index-sub-desc">Rehost, Replatform, Repurchase, Refactor, Retain, and Retire — the six strategies for deciding how to migrate each workload.</span></li>
          <li><span class="rm-index-sub-label">AWS Server Migration Service (SMS)</span> <span class="rm-index-sub-desc">Agentless service that migrates on-premises VMware, Hyper-V, and Azure VMs to AWS as incremental, automated replications.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-migration/#bulk--file-transfer">AWS Data Transfer Terminal</a></span> <span class="rm-index-sub-desc">Physical, secure facilities for high-volume data transfer onto AWS Snow Family devices without shipping them offsite.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-migration/">AWS Snowball Edge (Migration)</a></span> <span class="rm-index-sub-desc">Used in large-scale migrations to physically ship petabytes of data into AWS when network transfer would take too long.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/cloud/aws-migration/">AWS Snowmobile (Migration)</a></span> <span class="rm-index-sub-desc">Deployed for exabyte-scale, one-time data center migrations where even multiple Snowball devices aren't sufficient.</span></li>
          <li><span class="rm-index-sub-label">Migration Evaluator</span> <span class="rm-index-sub-desc">Free assessment service that analyzes on-premises environments to build a data-driven business case and right-sized AWS migration plan.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading">AWS Networking &amp; Content Delivery</h3>
        <p class="rm-index-desc">Services for connecting, routing, and delivering content across VPCs, on-premises networks, and the public internet.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label">Amazon API Gateway</span> <span class="rm-index-sub-desc">Fully managed service for creating, publishing, and securing REST, HTTP, and WebSocket APIs at any scale.</span></li>
          <li><span class="rm-index-sub-label">Amazon CloudFront</span> <span class="rm-index-sub-desc">Global content delivery network (CDN) that caches content at edge locations for low-latency delivery and DDoS protection.</span></li>
          <li><span class="rm-index-sub-label">Amazon Route 53</span> <span class="rm-index-sub-desc">Highly available DNS service with health checks and routing policies — latency, geolocation, geoproximity, weighted, and failover.</span></li>
          <li><span class="rm-index-sub-label">Amazon VPC</span> <span class="rm-index-sub-desc">Logically isolated virtual network within AWS — subnets, route tables, security groups, NACLs, and gateways for full network control.</span></li>
          <li><span class="rm-index-sub-label">AWS Direct Connect</span> <span class="rm-index-sub-desc">Dedicated private network connection from on-premises data centers to AWS, bypassing the public internet for consistent bandwidth.</span></li>
          <li><span class="rm-index-sub-label">AWS Elastic Load Balancing (ELB)</span> <span class="rm-index-sub-desc">Distributes incoming traffic across targets — Application (Layer 7), Network (Layer 4), Gateway, and Classic load balancers.</span></li>
          <li><span class="rm-index-sub-label">AWS Global Accelerator</span> <span class="rm-index-sub-desc">Uses the AWS global network and static anycast IPs to improve availability and performance for global applications.</span></li>
          <li><span class="rm-index-sub-label">AWS Transit Gateway</span> <span class="rm-index-sub-desc">Central hub that simplifies network topology by connecting VPCs and on-premises networks through a single gateway.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading">AWS Security &amp; Identity Services</h3>
        <p class="rm-index-desc">Identity, threat detection, encryption, and compliance services for securing accounts, workloads, and data.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label">Amazon Cognito</span> <span class="rm-index-sub-desc">User authentication, authorization, and user management for web and mobile apps — User Pools for sign-up/sign-in, Identity Pools for AWS credentials.</span></li>
          <li><span class="rm-index-sub-label">Amazon Detective</span> <span class="rm-index-sub-desc">Analyzes and visualizes security data to help investigate the root cause of findings from GuardDuty, Macie, and Security Hub.</span></li>
          <li><span class="rm-index-sub-label">Amazon GuardDuty</span> <span class="rm-index-sub-desc">Intelligent threat detection service that continuously monitors accounts and workloads for malicious activity using ML and threat intel feeds.</span></li>
          <li><span class="rm-index-sub-label">Amazon Inspector</span> <span class="rm-index-sub-desc">Automated vulnerability management that continuously scans EC2, ECR, and Lambda for software vulnerabilities and unintended network exposure.</span></li>
          <li><span class="rm-index-sub-label">Amazon Macie</span> <span class="rm-index-sub-desc">Uses ML and pattern matching to discover, classify, and protect sensitive data (like PII) stored in Amazon S3.</span></li>
          <li><span class="rm-index-sub-label">AWS Artifact</span> <span class="rm-index-sub-desc">Self-service portal for on-demand access to AWS compliance reports and agreements, such as SOC and PCI reports.</span></li>
          <li><span class="rm-index-sub-label">AWS Audit Manager</span> <span class="rm-index-sub-desc">Continuously audits AWS usage to simplify risk assessment and compliance with regulations and industry standards.</span></li>
          <li><span class="rm-index-sub-label">AWS Certificate Manager</span> <span class="rm-index-sub-desc">Provisions, manages, and deploys public and private SSL/TLS certificates for use with AWS services like CloudFront and ELB.</span></li>
          <li><span class="rm-index-sub-label">AWS CloudHSM</span> <span class="rm-index-sub-desc">Dedicated, single-tenant hardware security modules for generating and managing your own encryption keys in a FIPS-validated environment.</span></li>
          <li><span class="rm-index-sub-label">AWS Directory Service</span> <span class="rm-index-sub-desc">Managed Microsoft Active Directory in AWS, or a compatible directory, for identity management with AWS and Windows workloads.</span></li>
          <li><span class="rm-index-sub-label">AWS Firewall Manager</span> <span class="rm-index-sub-desc">Centrally configures and manages WAF rules, Shield Advanced, and security groups across multiple accounts and resources.</span></li>
          <li><span class="rm-index-sub-label">AWS Identity &amp; Access Management (IAM)</span> <span class="rm-index-sub-desc">Manages users, groups, roles, and fine-grained permission policies controlling who can do what across AWS resources.</span></li>
          <li><span class="rm-index-sub-label">AWS Key Management Service</span> <span class="rm-index-sub-desc">Managed service for creating and controlling symmetric and asymmetric encryption keys used across AWS services.</span></li>
          <li><span class="rm-index-sub-label">AWS Network Firewall</span> <span class="rm-index-sub-desc">Managed, stateful network firewall for VPCs, supporting intrusion detection/prevention and fine-grained traffic filtering rules.</span></li>
          <li><span class="rm-index-sub-label">AWS Organizations</span> <span class="rm-index-sub-desc">Centrally governs and manages multiple AWS accounts, including consolidated billing and Service Control Policies (SCPs).</span></li>
          <li><span class="rm-index-sub-label">AWS Resource Access Manager (RAM)</span> <span class="rm-index-sub-desc">Securely shares AWS resources — subnets, Transit Gateways, licenses — across accounts without duplicating them.</span></li>
          <li><span class="rm-index-sub-label">AWS Secrets Manager</span> <span class="rm-index-sub-desc">Stores, rotates, and retrieves database credentials, API keys, and other secrets, with built-in automatic rotation.</span></li>
          <li><span class="rm-index-sub-label">AWS Security Hub</span> <span class="rm-index-sub-desc">Aggregates, organizes, and prioritizes security findings from GuardDuty, Inspector, Macie, and third-party tools into one dashboard.</span></li>
          <li><span class="rm-index-sub-label">AWS Shield</span> <span class="rm-index-sub-desc">Managed DDoS protection — Standard is automatic and free; Advanced adds enhanced detection, mitigation, and cost protection.</span></li>
          <li><span class="rm-index-sub-label">AWS WAF</span> <span class="rm-index-sub-desc">Web application firewall that protects against common exploits like SQL injection and XSS by filtering HTTP/HTTPS requests.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading">AWS Management Tools</h3>
        <p class="rm-index-desc">Tools for provisioning infrastructure as code, monitoring, governance, and operating AWS environments at scale.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label">Amazon Managed Grafana</span> <span class="rm-index-sub-desc">Fully managed Grafana service for querying, visualizing, and alerting on metrics, logs, and traces from multiple data sources.</span></li>
          <li><span class="rm-index-sub-label">Amazon Managed Service for Prometheus</span> <span class="rm-index-sub-desc">Serverless, Prometheus-compatible monitoring service for storing and querying container and infrastructure metrics at scale.</span></li>
          <li><span class="rm-index-sub-label">Amazon CloudWatch</span> <span class="rm-index-sub-desc">Monitoring and observability service collecting metrics, logs, alarms, and dashboards across AWS resources and applications.</span></li>
