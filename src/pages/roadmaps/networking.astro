---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Networking Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Networking</h1>
        <p class="rm-subtitle">Step-by-step guide to the networking a data engineer actually hits</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"net-tcpip", label:"TCP/IP Fundamentals", desc:"Addressing, ports and the transport layer — plus the failure signatures that tell you what broke.", link:"/level-1-foundations/networking/#tcpip-fundamentals", subs:[
    { id:"net-tcp-udp", label:"TCP vs UDP", desc:"Reliable and ordered versus minimal overhead, and which your tools use.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
    { id:"net-handshake", label:"The Three-Way Handshake", desc:"Why connection setup costs a round trip — and why refused differs from timeout.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
    { id:"net-ports", label:"Ports", desc:"The numbers worth memorising, from 5432 and 9092 to 10000 and 5439.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
    { id:"net-cidr", label:"CIDR Notation", desc:"Reading a /16, sizing subnets, and why EKS exhausts a /24 faster than you expect.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
    { id:"net-private-public", label:"Private vs Public IPs", desc:"RFC 1918 ranges, NAT, and why a private instance needs a gateway to pip install.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
    { id:"net-diagnose", label:"Diagnosing Connectivity", desc:"Working up the layers with dig, traceroute, nc and curl, stopping at the first failure.", link:"/level-1-foundations/networking/#tcpip-fundamentals" },
  ]},
  { id:"net-dns-cat", label:"DNS", desc:"Name resolution, record types, caching — and why your change hasn't taken effect yet.", link:"/level-1-foundations/networking/#dns", subs:[
    { id:"net-resolution", label:"How Resolution Works", desc:"Resolver, root, TLD and authoritative servers, with caching at every step.", link:"/level-1-foundations/networking/#dns" },
    { id:"net-records", label:"Record Types", desc:"A, AAAA, CNAME, MX, TXT, NS, SRV and PTR, plus cloud-specific alias records.", link:"/level-1-foundations/networking/#dns" },
    { id:"net-dns-debug", label:"Troubleshooting DNS", desc:"dig against a specific resolver to separate a bad record from a stale cache.", link:"/level-1-foundations/networking/#dns" },
    { id:"net-ttl", label:"TTL & Propagation", desc:"Why changes take time, lowering TTL before a migration, and JVM caching.", link:"/level-1-foundations/networking/#dns" },
  ]},
  { id:"net-http-cat", label:"HTTP & TLS", desc:"Consuming APIs reliably — status codes, protocol versions, certificates and retry behaviour.", link:"/level-1-foundations/networking/#http--tls", subs:[
    { id:"net-status", label:"Status Codes", desc:"Retry 5xx and 429, fail fast on 4xx — the rule an ingestion job needs.", link:"/level-1-foundations/networking/#http--tls" },
    { id:"net-http-versions", label:"HTTP/1.1 vs 2 vs 3", desc:"Multiplexing, head-of-line blocking and QUIC — and where it matters for ingestion.", link:"/level-1-foundations/networking/#http--tls" },
    { id:"net-tls-how", label:"How TLS Works", desc:"The handshake, certificates, and what encryption, authentication and integrity mean.", link:"/level-1-foundations/networking/#http--tls" },
    { id:"net-cert-errors", label:"Certificate Errors", desc:"Expiry, hostname mismatch, missing intermediates, absent CA bundles and TLS proxies.", link:"/level-1-foundations/networking/#http--tls" },
    { id:"net-retries", label:"Retry Strategies", desc:"Exponential backoff with jitter, Retry-After, timeouts and idempotency keys.", link:"/level-1-foundations/networking/#http--tls" },
  ]},
  { id:"net-cloud", label:"Cloud Networking", desc:"VPCs, subnets and the policy controls that decide whether two machines can talk at all.", link:"/level-1-foundations/networking/#cloud-networking", subs:[
    { id:"net-vpc-subnets", label:"VPCs & Subnets", desc:"Public and private subnets as a routing distinction, and the standard data layout.", link:"/level-1-foundations/networking/#cloud-networking" },
    { id:"net-sg-nacl", label:"Security Groups vs NACLs", desc:"Stateful versus stateless, and the return-path rule people forget.", link:"/level-1-foundations/networking/#cloud-networking" },
    { id:"net-endpoints", label:"VPC Endpoints", desc:"Gateway and interface endpoints — cost, security and reachability for S3 traffic.", link:"/level-1-foundations/networking/#cloud-networking" },
    { id:"net-connect", label:"Connecting Networks", desc:"Peering, Transit Gateway, VPN, Direct Connect and PrivateLink.", link:"/level-1-foundations/networking/#cloud-networking" },
    { id:"net-nat", label:"NAT Gateways & Cost", desc:"Per-GB processing charges, and why S3 traffic through NAT is a billing mistake.", link:"/level-1-foundations/networking/#cloud-networking" },
  ]},
  { id:"net-lb-cat", label:"Load Balancing", desc:"Distributing traffic across backends, and knowing when a request should stop being sent to one.", link:"/level-1-foundations/networking/#load-balancing", subs:[
    { id:"net-l4-l7", label:"Layer 4 vs Layer 7", desc:"Connection forwarding versus content-aware routing and TLS termination.", link:"/level-1-foundations/networking/#load-balancing" },
    { id:"net-algorithms", label:"Balancing Algorithms", desc:"Round robin, least connections, consistent hashing and two-random-choices.", link:"/level-1-foundations/networking/#load-balancing" },
    { id:"net-health", label:"Health Checks", desc:"Checking real capability, tuning thresholds, and liveness versus readiness.", link:"/level-1-foundations/networking/#load-balancing" },
    { id:"net-proxy-gateway", label:"LB vs Reverse Proxy vs API Gateway", desc:"Overlapping tools distinguished by emphasis, not hard boundaries.", link:"/level-1-foundations/networking/#load-balancing" },
  ]},
  { id:"net-de", label:"Networking for Data Engineers", desc:"The networking problems that actually land on a data engineer: connectivity, cost and throughput.", link:"/level-1-foundations/networking/#networking-for-data-engineers", subs:[
    { id:"net-de-debug", label:"Debugging a Connection Failure", desc:"The layer-by-layer walkthrough from DNS to security groups to authentication.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
    { id:"net-de-cost", label:"Data Transfer Pricing", desc:"Cross-AZ, cross-region, internet and NAT charges — and how to cut each.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
    { id:"net-de-kafka", label:"Kafka advertised.listeners", desc:"Why bootstrap succeeds and everything after it fails — a config bug, not a network one.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
    { id:"net-de-placement", label:"Placement & Data Gravity", desc:"Moving compute to the data, AZ placement, and instance network tiers.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
    { id:"net-de-onprem", label:"On-Premises Connectivity", desc:"VPN, Direct Connect, bastions and agent-based pull for source databases.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
    { id:"net-de-throughput", label:"Throughput Bottlenecks", desc:"Bandwidth-delay product, small files, connection churn and server-side rate limits.", link:"/level-1-foundations/networking/#networking-for-data-engineers" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "networking_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
