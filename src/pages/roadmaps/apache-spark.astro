---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Apache Spark Roadmap",
    description: "Master Apache Spark end to end — distributed systems, RDDs, DataFrames, Spark SQL, streaming, performance tuning, deployment, and production ops.",
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Spark</h1>
        <p class="rm-subtitle">End-to-end guide to mastering Apache Spark for data engineering</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>

    <div class="rm-flow" id="rm-flow"></div>

    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  // ── Phase 1: Foundations ──────────────────────────────────────────────────
  { id:"distributed-computing-fundamentals", label:"Distributed Computing Fundamentals", desc:"The core building blocks of how Spark distributes work across a cluster.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/", subs:[
    { id:"driver-node-responsibilities", label:"Driver node responsibilities", desc:"The process that runs main(), builds the DAG, negotiates resources with the cluster manager, and schedules tasks onto executors.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#driver-node-responsibilities" },
    { id:"worker-node-architecture", label:"Worker node architecture", desc:"Physical or virtual machines that host executor processes, providing the CPU, memory, and disk resources tasks run on.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#worker-node-architecture" },
    { id:"executor-processes-and-task-slots", label:"Executor processes and task slots", desc:"JVM processes launched per application on worker nodes that run tasks in parallel across configurable core-based slots and cache data in memory.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#executor-processes-and-task-slots" },
    { id:"cluster-manager-concepts", label:"Cluster manager concepts (YARN, Mesos, Standalone, Kubernetes)", desc:"Pluggable systems that allocate cluster resources and launch executors on Spark's behalf.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#cluster-manager-concepts" },
    { id:"spark-master-and-worker-roles", label:"Spark master and worker roles", desc:"In Standalone mode, the master arbitrates resources across applications while workers register with it and spawn executors on request.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#spark-master-and-worker-roles" },
    { id:"resource-allocation-strategies", label:"Resource allocation strategies", desc:"Static allocation reserves a fixed set of executors up front, while dynamic and per-job configuration trade flexibility for predictability.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#resource-allocation-strategies" },
    { id:"dynamic-resource-allocation", label:"Dynamic resource allocation", desc:"Lets Spark scale executors up and down at runtime based on pending task backlog, releasing idle capacity back to the cluster.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#dynamic-resource-allocation" },
    { id:"node-heartbeats-and-health-checks", label:"Node heartbeats and health checks", desc:"Periodic signals executors send the driver to report liveness and block status; missed heartbeats trigger executor loss handling.", link:"/level-3-technologies/batch-processing/spark-distributed-computing-fundamentals/#node-heartbeats-and-health-checks" },
  ]},
  { id:"execution-lifecycle", label:"Cluster Architecture & Execution Lifecycle", desc:"How a Spark application is broken down, scheduled, and executed.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/", subs:[
    { id:"job-stage-task-hierarchy", label:"Job, stage, and task hierarchy", desc:"An action triggers a job, which the DAG scheduler splits into stages at shuffle boundaries, each stage made up of parallel tasks.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#job-stage-and-task-hierarchy" },
    { id:"dag-scheduler-flow", label:"DAG scheduler flow", desc:"Translates the logical execution plan into a physical DAG of stages, tracking dependencies and resubmitting failed stages as needed.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#dag-scheduler-flow" },
    { id:"narrow-vs-wide-dependencies", label:"Narrow versus wide dependencies", desc:"Narrow dependencies (map, filter) require no shuffle and can pipeline within a stage; wide dependencies (groupBy, join) force a shuffle and new stage.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#narrow-versus-wide-dependencies" },
    { id:"task-scheduling-and-parallelism", label:"Task scheduling and parallelism", desc:"The task scheduler assigns tasks to executor cores based on locality preferences, queueing tasks when slots aren't yet available.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#task-scheduling-and-parallelism" },
    { id:"data-locality-awareness", label:"Data locality awareness", desc:"Prefers scheduling tasks on nodes that already hold the relevant data (PROCESS_LOCAL to NO_PREF/ANY) to minimize network I/O.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#data-locality-awareness" },
    { id:"threading-models-within-executors", label:"Threading models within executors", desc:"Executors run multiple tasks concurrently as threads within a single JVM, sharing memory but isolated per-task via thread-local state.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#threading-models-within-executors" },
    { id:"shuffle-phases-and-mechanics", label:"Shuffle phases and mechanics", desc:"Splits into a map (write) side that partitions and spills output, and a reduce (read) side that fetches and merges shuffle blocks.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#shuffle-phases-and-mechanics" },
    { id:"data-serialization-during-shuffle", label:"Data serialization during shuffle", desc:"Data written to shuffle files must be serialized (Java or Kryo) and deserialized on read, making format choice a major performance lever.", link:"/level-3-technologies/batch-processing/spark-execution-lifecycle/#data-serialization-during-shuffle" },
  ]},
  { id:"spark-core-fundamentals", label:"Spark Core Fundamentals", desc:"Getting a Spark application up, configured, and observable.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/", subs:[
    { id:"sparksession-sparkcontext-sqlcontext", label:"SparkSession, SparkContext, and legacy SQLContext/HiveContext", desc:"SparkSession is the unified entry point since 2.0, wrapping the lower-level SparkContext and superseding the legacy SQLContext/HiveContext APIs.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#sparksession-sparkcontext-and-legacy-sqlcontexthivecontext" },
    { id:"spark-submit-flags-master-url", label:"spark-submit flags and master URL formats", desc:"The CLI for launching applications — flags for driver/executor memory and cores, deploy mode, and master URLs (local, yarn, k8s://, spark://).", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#spark-submit-flags-and-master-url-formats" },
    { id:"spark-configuration-env-variables", label:"Spark configuration and environment variables", desc:"Settings layered via SparkConf, spark-defaults.conf, spark-submit flags, and environment variables like SPARK_HOME and JAVA_HOME, in increasing precedence.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#spark-configuration-and-environment-variables" },
    { id:"logging-level-configuration", label:"Logging level configuration", desc:"Controlled via log4j2 properties files to tune verbosity per package, separating driver and executor log output for debugging.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#logging-level-configuration" },
    { id:"spark-ui-monitoring-basics", label:"Spark UI monitoring basics", desc:"The web UI (default port 4040) exposing Jobs, Stages, Storage, Environment, Executors, and SQL tabs for live application inspection.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#spark-ui-monitoring-basics" },
    { id:"spark-connect-client-server", label:"Spark Connect client-server architecture", desc:"Decouples client applications from the cluster via a gRPC protocol, letting thin clients submit DataFrame plans without a local Spark install.", link:"/level-3-technologies/batch-processing/spark-core-fundamentals/#spark-connect-client-server-architecture" },
  ]},

  // ── Phase 2: Core & Structured APIs ──────────────────────────────────────
  { id:"rdd-api", label:"Resilient Distributed Datasets (RDDs)", desc:"The low-level, fault-tolerant distributed collection API underlying all of Spark.", link:"/level-3-technologies/batch-processing/spark-rdd-api/", subs:[
    { id:"rdd-creation-methods", label:"RDD creation methods", desc:"RDDs are created by parallelizing a driver-side collection, reading external storage, or transforming an existing RDD.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#rdd-creation-methods" },
    { id:"transformation-operations", label:"Transformation operations", desc:"Lazy operations like map, filter, and flatMap that return a new RDD without triggering computation until an action runs.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#transformation-operations" },
    { id:"action-operations", label:"Action operations", desc:"Operations like collect, count, and reduce that trigger execution of the RDD's lineage and return a result to the driver.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#action-operations" },
    { id:"lazy-evaluation-model", label:"Lazy evaluation model", desc:"Transformations build up a lineage graph without executing; Spark only computes when an action forces evaluation, enabling optimization.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#lazy-evaluation-model" },
    { id:"dependency-graphs-and-lineage", label:"Dependency graphs and lineage", desc:"Each RDD tracks its parent RDDs and the transformation that produced it, forming the lineage graph used for fault recovery.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#dependency-graphs-and-lineage" },
    { id:"persistence-and-storage-levels", label:"Persistence and storage levels", desc:"cache()/persist() with storage levels (MEMORY_ONLY, MEMORY_AND_DISK, off-heap, replicated) that trade memory pressure against recomputation cost.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#persistence-and-storage-levels" },
    { id:"rdd-checkpointing-and-lineage-truncation", label:"RDD checkpointing and lineage truncation", desc:"Writes an RDD to reliable storage and truncates its lineage, preventing stack overflows and excessive recomputation on very long chains.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#rdd-checkpointing-and-lineage-truncation" },
    { id:"recovering-failed-tasks-executor-loss", label:"Recovering failed tasks and executor loss mitigation", desc:"Lost partitions are recomputed from lineage on healthy executors; a lost executor triggers reassignment of its in-flight and cached tasks.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#recovering-failed-tasks-and-executor-loss-mitigation" },
    { id:"broadcast-variables", label:"Broadcast variables", desc:"Read-only variables cached once per executor rather than shipped with every task, used to efficiently share lookup tables or join keys.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#broadcast-variables" },
    { id:"accumulator-usage-patterns", label:"Accumulator usage patterns", desc:"Write-only variables that aggregate values across tasks back to the driver, commonly used for counters and debugging metrics.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#accumulator-usage-patterns" },
    { id:"custom-partitioning-hash-range", label:"Custom partitioning (hash and range)", desc:"HashPartitioner distributes keys by hash for even spread; RangePartitioner sorts keys into ordered ranges, both usable via custom subclasses.", link:"/level-3-technologies/batch-processing/spark-rdd-api/#custom-partitioning-hash-and-range" },
  ]},
  { id:"structured-apis", label:"DataFrame & Dataset APIs", desc:"The structured, higher-level APIs used for most modern Spark development.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/", subs:[
    { id:"dataframe-creation-patterns", label:"DataFrame creation patterns", desc:"DataFrames are built from RDDs, structured files, JDBC sources, Hive tables, or in-memory collections via createDataFrame.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#dataframe-creation-patterns" },
    { id:"column-expressions-and-operations", label:"Column expressions and operations", desc:"The Column API (col(), expr(), withColumn) for building typed transformations and arithmetic, string, and conditional expressions.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#column-expressions-and-operations" },
    { id:"row-manipulation-functions", label:"Row manipulation functions", desc:"Functions like withColumn, drop, select, and struct-building operations for reshaping individual Row values within a DataFrame.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#row-manipulation-functions" },
    { id:"schema-definition-and-inference", label:"Schema definition and inference", desc:"Schemas can be inferred from data (at a scan cost) or defined explicitly via StructType/StructField for stability and performance.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#schema-definition-and-inference" },
    { id:"null-handling-strategies", label:"Null handling strategies", desc:"na.drop, na.fill, coalesce, and isNull/isNotNull predicates for detecting and resolving missing values in a DataFrame.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#null-handling-strategies" },
    { id:"column-type-casting", label:"Column type casting", desc:"Explicit type conversion via cast() or astype(), important for avoiding silent precision loss or failed comparisons across mismatched types.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#column-type-casting" },
    { id:"dataset-api-type-safety", label:"Dataset API and type safety (Scala/Java)", desc:"Scala/Java-only typed API layered over DataFrames, catching schema mismatches at compile time instead of at runtime.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#dataset-api-and-type-safety" },
    { id:"encoders-and-compile-time-checks", label:"Encoders and compile-time checks", desc:"Encoders convert between JVM objects and Spark's internal binary row format, enabling Dataset type safety and efficient serialization.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#encoders-and-compile-time-checks" },
    { id:"filtering-sorting-selection-logic", label:"Filtering, sorting, and selection logic", desc:"filter/where, orderBy/sort, and select/selectExpr — the core relational operators for narrowing and reordering DataFrame rows and columns.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#filtering-sorting-and-selection-logic" },
    { id:"pandas-api-on-spark", label:"Pandas API on Spark (formerly Koalas)", desc:"A pandas-compatible API (formerly Koalas) that runs on distributed Spark DataFrames, easing migration of single-node pandas code.", link:"/level-3-technologies/batch-processing/spark-dataframe-dataset-apis/#pandas-api-on-spark" },
  ]},
  { id:"window-functions", label:"Window Functions", desc:"Ranking, aggregate, and analytic functions computed over row windows.", subs:[
    { id:"window-specification-definitions", label:"Window specification definitions", desc:"WindowSpec defines the partitioning, ordering, and frame boundaries a window function is evaluated over, built via Window.partitionBy/orderBy." },
    { id:"ranking-functions", label:"Ranking functions (rank, dense_rank, row_number)", desc:"rank() leaves gaps after ties, dense_rank() doesn't, and row_number() assigns a strictly unique sequential number within each partition." },
    { id:"aggregate-window-functions", label:"Aggregate window functions", desc:"Standard aggregates like sum, avg, and max computed over a window frame instead of collapsing rows, preserving row-level granularity." },
    { id:"lead-and-lag-operations", label:"Lead and lag operations", desc:"Access a column's value from a following (lead) or preceding (lag) row within the same partition, for period-over-period comparisons." },
    { id:"range-vs-row-frames", label:"Range versus row frames", desc:"ROWS frames count physical rows before/after the current row; RANGE frames include all rows with the same order-by value." },
    { id:"partitioning-within-windows", label:"Partitioning within windows", desc:"partitionBy splits rows into independent groups the window function is computed separately within, analogous to GROUP BY without collapsing rows." },
    { id:"cumulative-and-running-calculations", label:"Cumulative and running calculations", desc:"Running totals and moving averages built with an unbounded preceding-to-current-row frame combined with sum/avg window functions." },
  ]},
  { id:"joins", label:"Joins & Relational Operations", desc:"How Spark combines datasets, and the strategies it picks between.", subs:[
    { id:"inner-outer-semi-anti-joins", label:"Inner, outer, semi, and anti joins", desc:"Inner keeps matching rows only; outer variants keep unmatched rows from one or both sides; semi/anti filter one side by match existence without duplicating columns." },
    { id:"cross-joins-cartesian-products", label:"Cross joins and Cartesian products", desc:"Every row of one DataFrame paired with every row of the other; expensive and usually accidental unless explicitly required." },
    { id:"shuffle-hash-join", label:"Shuffle hash join", desc:"Both sides are shuffled and hash-partitioned by join key, then joined by building an in-memory hash table on the smaller partition." },
    { id:"sort-merge-join", label:"Sort-merge join", desc:"Both sides are shuffled and sorted by join key, then merged in a single linear pass — Spark SQL's default strategy for large-large joins." },
    { id:"broadcast-hash-join", label:"Broadcast hash join", desc:"Ships an entire small table to every executor to avoid shuffling the large table, controlled by spark.sql.autoBroadcastJoinThreshold." },
    { id:"join-strategy-selection-and-hints", label:"Join strategy selection and hints", desc:"The optimizer picks a join strategy from size estimates and config thresholds, overridable with hints like broadcast(), merge(), or shuffle_hash()." },
    { id:"handling-data-skew-in-joins", label:"Handling data skew in joins", desc:"Skewed key distributions overload a few tasks; mitigated with salting, AQE's automatic skew join optimization, or isolating hot keys." },
  ]},
  { id:"advanced-transformations", label:"Advanced RDD & DataFrame Transformations", desc:"Less common but important transformation patterns.", subs:[
    { id:"mappartitions-and-mappartitionswithindex", label:"mapPartitions and mapPartitionsWithIndex", desc:"Apply a function once per partition rather than per row, amortizing expensive setup (e.g. connection creation) across all rows in that partition." },
    { id:"filter-and-predicate-pushdown", label:"Filter and predicate pushdown", desc:"Filter conditions pushed down into the data source scan (e.g. Parquet row groups) so unmatched data is never read into Spark at all." },
    { id:"set-based-operations", label:"Set-based operations (union, intersect, except)", desc:"union combines rows from two DataFrames with matching schemas; intersect keeps common rows; except returns rows in one but not the other." },
    { id:"pivoting-and-unpivoting-data", label:"Pivoting and unpivoting data", desc:"pivot() turns distinct row values into columns for cross-tab style aggregation; the reverse (unpivot/stack) turns columns back into rows." },
    { id:"sampling-and-data-splitting", label:"Sampling and data splitting", desc:"sample() draws a random fraction of rows with or without replacement; randomSplit() partitions a DataFrame into weighted subsets (e.g. train/test)." },
    { id:"exploding-flattening-nested-arrays", label:"Exploding and flattening nested/array structures", desc:"explode()/explode_outer() turn array or map column elements into separate rows; flattening nested structs unpacks them into top-level columns." },
  ]},
  { id:"udfs", label:"User Defined Functions (UDFs)", desc:"Extending Spark SQL with custom logic, and its performance implications.", subs:[
    { id:"scalar-udf-implementation", label:"Scalar UDF implementation", desc:"Row-at-a-time custom functions registered via udf() or spark.udf.register, applied to columns like any built-in Spark SQL function." },
    { id:"user-defined-aggregate-functions", label:"User-defined aggregate functions (UDAFs)", desc:"Custom aggregations implemented via the Aggregator API (typed) or legacy UserDefinedAggregateFunction, extending groupBy beyond built-in aggregates." },
    { id:"pandas-vectorized-udfs", label:"Pandas (vectorized) UDFs", desc:"Operate on pandas Series/DataFrame batches instead of single rows, using Arrow to avoid per-row Python serialization overhead." },
    { id:"arrow-based-data-transfer-udfs", label:"Arrow-based data transfer for UDFs", desc:"Apache Arrow's columnar in-memory format moves batches between the JVM and Python process for vectorized UDFs, cutting serialization cost sharply." },
    { id:"python-vs-jvm-execution-overhead", label:"Python versus JVM execution overhead", desc:"Python UDFs pay a serialization and process-boundary tax per row that native Scala/Java or Pandas UDFs largely avoid." },
    { id:"builtin-vs-custom-udf-performance", label:"Built-in functions versus custom UDFs (performance tradeoffs)", desc:"Built-in functions run inside Catalyst's optimized, whole-stage-codegen path; UDFs are opaque black boxes the optimizer can't see into or push down through." },
    { id:"higher-order-functions-array-map", label:"Higher-order functions for array/map columns", desc:"transform, filter, exists, and aggregate operate on array/map columns directly in SQL, avoiding a UDF or explode/collect round-trip." },
    { id:"dependency-isolation-udf-environments", label:"Dependency isolation for UDF environments", desc:"Python UDF environments are isolated via virtualenv/conda archives or container images shipped with the job to avoid version conflicts across executors." },
  ]},

  // ── Phase 3: Spark SQL Engine & Optimization ─────────────────────────────
  { id:"spark-sql-catalyst", label:"Spark SQL Engine & Catalyst Optimizer", desc:"The query planner and optimizer at the heart of Spark SQL.", subs:[
    { id:"logical-plan-analysis-validation", label:"Logical plan analysis and validation", desc:"The Analyzer resolves column and table references against the catalog and checks types, turning an unresolved plan into a validated logical plan." },
    { id:"rule-based-logical-plan-optimization", label:"Rule-based logical plan optimization", desc:"Catalyst applies a fixed set of rules — predicate pushdown, constant folding, column pruning — to rewrite the logical plan into an equivalent, cheaper one." },
    { id:"physical-plan-generation-and-selection", label:"Physical plan generation and selection", desc:"The optimized logical plan is turned into one or more physical plans (e.g. join strategies), and the planner picks the cheapest by cost." },
    { id:"cost-based-optimization-cbo", label:"Cost-based optimization (CBO)", desc:"Uses collected table and column statistics to estimate operator costs and choose better join orders and strategies than rule-based heuristics alone." },
    { id:"whole-stage-code-generation", label:"Whole-stage code generation", desc:"Fuses multiple physical operators into a single generated Java function per stage, eliminating virtual function call overhead row by row." },
    { id:"vectorized-execution", label:"Vectorized execution", desc:"Processes columnar batches of rows at once (e.g. for Parquet scans) instead of row-at-a-time, exploiting CPU cache and SIMD better." },
    { id:"adaptive-query-execution-aqe", label:"Adaptive Query Execution (AQE)", desc:"Re-optimizes the physical plan at runtime using actual shuffle statistics — switching join strategies, coalescing partitions, and handling skew after seeing real data sizes." },
    { id:"dynamic-partition-coalescing", label:"Dynamic partition coalescing", desc:"AQE merges small post-shuffle partitions into larger ones at runtime, avoiding the overhead of many tiny tasks from a static partition count." },
    { id:"dynamic-join-strategy-switching", label:"Dynamic join strategy switching", desc:"AQE can downgrade a sort-merge join to a broadcast join at runtime once actual shuffle output size is known to be small enough." },
    { id:"skew-join-optimization", label:"Skew join optimization", desc:"AQE detects disproportionately large shuffle partitions and splits them into smaller sub-partitions joined separately, avoiding a single straggler task." },
    { id:"plan-caching", label:"Plan caching", desc:"Spark caches parsed and analyzed logical plans for repeated query shapes to avoid re-running the parser and analyzer on every execution." },
    { id:"reading-interpreting-explain-plans", label:"Reading and interpreting explain plans", desc:"explain() and its formatted/cost variants show parsed, analyzed, optimized, and physical plans — essential for diagnosing join strategy and shuffle behavior." },
    { id:"spark-thrift-server", label:"Spark Thrift Server (JDBC/ODBC access for BI tools)", desc:"A long-running JDBC/ODBC server exposing Spark SQL to BI tools like Tableau, sharing a SparkContext across concurrent client connections." },
  ]},

  // ── Phase 4: Data & Storage ───────────────────────────────────────────────
  { id:"file-formats", label:"File Formats & Storage Optimization", desc:"Choosing and tuning the on-disk formats Spark reads and writes.", subs:[
    { id:"parquet-storage-format-optimization", label:"Parquet storage format and optimization", desc:"Columnar, self-describing binary format with per-column encoding and stats — Spark's default and best-optimized format for analytical scans." },
    { id:"orc-file-structure-and-benefits", label:"ORC file structure and benefits", desc:"Columnar format with built-in indexes and lightweight compression, popular in the Hive ecosystem, with strong predicate pushdown support." },
    { id:"avro-serialization-and-schema", label:"Avro serialization and schema", desc:"Row-based format with schema embedded in every file, favored for streaming and schema-registry-driven pipelines over columnar analytics." },
    { id:"schema-evolution-across-formats", label:"Schema evolution across formats", desc:"Parquet and Avro support adding/removing/renaming columns across file versions differently — Avro via writer/reader schema resolution, Parquet via schema merging." },
    { id:"columnar-projection-and-column-pruning", label:"Columnar projection and column pruning", desc:"Only the columns referenced by the query are read off disk, skipping unused column chunks entirely in columnar formats like Parquet and ORC." },
    { id:"dictionary-encoding-mechanics", label:"Dictionary encoding mechanics", desc:"Low-cardinality columns are stored as small integer codes plus a lookup dictionary, shrinking file size and speeding up filters and joins." },
    { id:"compression-codec-selection", label:"Compression codec selection (Snappy, Zstd, GZIP)", desc:"Snappy favors decompression speed for interactive queries; Zstd offers better ratios at moderate CPU cost; GZIP maximizes compression at the cost of speed." },
    { id:"small-file-problem-and-compaction", label:"Small file problem and compaction strategies", desc:"Many tiny files overload the driver's file-listing and task-scheduling overhead; fixed by coalescing/repartitioning writes or periodic compaction jobs." },
