---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "GCP Services Roadmap",
    description: "A complete, interactive map of every Google Cloud service across all categories — compute, storage, databases, networking, security, data & analytics, and more — with progress tracking.",
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">GCP Services</h1>
        <p class="rm-subtitle">Complete map of every Google Cloud service across all categories — track what you've learned or used in production</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-filter-row">
          <div class="rm-filter-toggle" id="rm-filter-toggle">
            <button type="button" class="rm-filter-btn" data-mode="de">Data Engineering</button>
            <button type="button" class="rm-filter-btn" data-mode="all">All services</button>
          </div>
          <span class="rm-filter-count" id="rm-filter-count"></span>
        </div>
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"overview", label:"GCP Overview", desc:"Foundational Google Cloud concepts, global footprint, and pricing basics every cloud practitioner should know before diving into individual services.", subs:[
    { id:"gcp-global-infrastructure", label:"Google Cloud Global Infrastructure", desc:"Regions, zones, and Google's private global network backbone that connects them for low-latency, high-throughput data transfer." },
    { id:"gcp-platform-overview",   label:"Google Cloud Platform Overview",     desc:"High-level overview of Google Cloud's service catalog spanning compute, storage, data analytics, and AI/ML." },
    { id:"gcp-pricing",             label:"Google Cloud Pricing",               desc:"Pay-as-you-go pricing with sustained-use and committed-use discounts, plus the Google Cloud Pricing Calculator for cost estimation." },
  ]},
  { id:"compute", label:"GCP Compute Services", desc:"Services for running application code and containers — from fully managed serverless platforms to full control over virtual machines.", subs:[
    { id:"cloud-run",               label:"Cloud Run",                         desc:"Fully managed serverless platform for running stateless containers, automatically scaling to zero when idle.", de:true },
    { id:"google-app-engine",       label:"Google App Engine",                 desc:"Fully managed PaaS for building and deploying web applications and APIs without managing the underlying infrastructure." },
    { id:"google-cloud-functions",  label:"Google Cloud Functions",            desc:"Event-driven, serverless compute for running single-purpose functions in response to cloud events.", de:true },
    { id:"gce",                     label:"Google Compute Engine (GCE)",       desc:"Customizable, scalable IaaS virtual machines with per-second billing and custom machine types.", de:true },
    { id:"gke",                     label:"Google Kubernetes Engine (GKE)",    desc:"Managed, production-ready Kubernetes environment with Autopilot mode for hands-off node management.", de:true },
  ]},
  { id:"storage", label:"GCP Storage Services", desc:"Object, block, and file storage services covering every durability, access-pattern, and cost tier.", subs:[
    { id:"gcp-filestore",           label:"Google Cloud Filestore",            desc:"Fully managed NFS file storage for applications that require a shared, POSIX-compliant file system.", de:true },
    { id:"gcs",                     label:"Google Cloud Storage (GCS)",        desc:"Unified object storage with Standard, Nearline, Coldline, and Archive classes trading access frequency for cost.", de:true },
    { id:"local-ssd",               label:"Local SSD",                         desc:"High-performance, physically attached SSD storage for VM instances, offering the lowest latency but no data persistence beyond the VM's life.", de:true },
    { id:"persistent-disks",        label:"Persistent Disks",                  desc:"Durable, network-attached block storage for VM instances, available in Standard, Balanced, SSD, and Extreme performance tiers.", de:true },
  ]},
  { id:"database", label:"GCP Database Services", desc:"Purpose-built managed database engines spanning relational, wide-column, and globally distributed workloads.", subs:[
    { id:"google-bigquery",         label:"Google BigQuery",                   desc:"Serverless, highly scalable data warehouse for running fast SQL analytics over petabyte-scale datasets.", de:true },
    { id:"google-cloud-bigtable",   label:"Google Cloud Bigtable",             desc:"Fully managed, wide-column NoSQL database built for low-latency, high-throughput workloads like time series and IoT data.", de:true },
    { id:"google-cloud-sql",        label:"Google Cloud SQL",                  desc:"Fully managed relational database service supporting MySQL, PostgreSQL, and SQL Server with automated backups and replication.", de:true },
    { id:"google-cloud-spanner",    label:"Google Cloud Spanner",              desc:"Globally distributed, horizontally scalable relational database offering strong consistency and SQL with virtually unlimited scale.", de:true },
  ]},
  { id:"networking", label:"GCP Networking & Content Delivery", desc:"Services for connecting, routing, and delivering content across virtual networks, on-premises networks, and the public internet.", subs:[
    { id:"gcp-cdn",                 label:"Google Cloud CDN",                  desc:"Content delivery network that caches content at Google's globally distributed edge points of presence." },
    { id:"gcp-dns",                 label:"Google Cloud DNS",                  desc:"Scalable, reliable, and managed authoritative DNS service running on the same infrastructure as Google's own DNS." },
    { id:"gcp-hybrid-connectivity", label:"Google Cloud Hybrid Connectivity",  desc:"Cloud VPN and Cloud Interconnect options for securely connecting on-premises networks to Google Cloud VPCs." },
    { id:"gcp-cloud-router",        label:"Google Cloud Router",               desc:"Dynamically exchanges routes between a VPC network and on-premises networks using BGP over VPN or Interconnect." },
    { id:"gcp-load-balancing",      label:"Google Cloud Load Balancing",       desc:"Fully distributed, software-defined load balancing across global and regional layers for HTTP(S), TCP/UDP, and internal traffic." },
    { id:"gcp-vpc",                 label:"Google Virtual Private Cloud",      desc:"Global, software-defined network providing isolated, customizable networking with subnets that can span multiple regions." },
  ]},
  { id:"security", label:"GCP Security and Identity Services", desc:"Identity, threat protection, and encryption key management services for securing projects and data.", subs:[
    { id:"gcp-cloud-armor",         label:"Google Cloud Armor",                desc:"Web application firewall and DDoS protection service that filters traffic at the edge of Google's network." },
    { id:"gcp-cloud-identity",      label:"Google Cloud Identity",             desc:"Identity-as-a-service platform for managing users, devices, and apps independent of, or alongside, Google Workspace." },
    { id:"gcp-iam",                 label:"Google Cloud IAM",                  desc:"Fine-grained access control assigning roles and permissions to members across projects, folders, and organizations." },
    { id:"gcp-kms",                 label:"Google Cloud Key Management",       desc:"Centralized service for creating, managing, and rotating cryptographic keys used to encrypt data across Google Cloud." },
    { id:"gcp-secret-manager",      label:"Google Cloud Secret Manager",       desc:"Securely stores, manages, and audits access to API keys, passwords, certificates, and other sensitive configuration data." },
  ]},
  { id:"analytics", label:"GCP Data and Analytics", desc:"Services for querying, processing, and streaming data at scale — the core of Google Cloud's data engineering toolkit.", subs:[
    { id:"gcp-dataflow",            label:"Google Cloud Dataflow",             desc:"Fully managed service for executing Apache Beam batch and streaming data processing pipelines with autoscaling.", de:true },
    { id:"gcp-dataprep",            label:"Google Cloud Dataprep",             desc:"Serverless, visual data preparation service (built on Trifacta) for cleaning and transforming raw data for analysis.", de:true },
    { id:"gcp-dataproc",            label:"Google Cloud Dataproc",             desc:"Fully managed Spark and Hadoop service for running big data processing, ML, and analytics workloads with per-second billing.", de:true },
    { id:"gcp-pubsub",              label:"Google Cloud Pub/Sub",              desc:"Globally scalable, asynchronous messaging service for building event-driven systems and streaming analytics pipelines.", de:true },
  ]},
  { id:"management", label:"GCP Management Tools", desc:"Tools for provisioning infrastructure as code, monitoring, billing, and operating Google Cloud environments.", subs:[
    { id:"gcp-billing",             label:"Google Cloud Billing",              desc:"Tools for tracking, budgeting, and analyzing Google Cloud spend, including budgets, alerts, and detailed cost reports." },
    { id:"gcp-console",             label:"Google Cloud Console",              desc:"Web-based graphical interface for managing, monitoring, and configuring all Google Cloud resources and services." },
    { id:"gcp-deployment-manager",  label:"Google Cloud Deployment Manager",   desc:"Infrastructure-as-code service for creating and managing Google Cloud resources using declarative YAML or Python/Jinja templates." },
    { id:"gcp-logging",             label:"Google Cloud Logging",              desc:"Centralized, real-time log management and analysis service that ingests logs from Google Cloud, on-prem, and other clouds." },
    { id:"gcp-monitoring",          label:"Google Cloud Monitoring",           desc:"Collects metrics, uptime checks, and dashboards to provide visibility into the performance and health of applications and infrastructure." },
  ]},
  { id:"developer-tools", label:"GCP Developer Tools", desc:"Services for building, testing, and deploying application code and CI/CD pipelines on Google Cloud.", subs:[
    { id:"gcp-cloud-build",         label:"Google Cloud Build",                desc:"Fully managed CI/CD platform that builds, tests, and deploys code across multiple environments and languages." },
    { id:"gcp-source-repositories", label:"Google Cloud Source Repositories",  desc:"Fully featured, private Git repositories hosted on Google Cloud with integrated code search and Cloud Build triggers." },
    { id:"gcp-container-registry",  label:"Google Container Registry",         desc:"Private Docker image storage (being succeeded by Artifact Registry) integrated with Cloud Build and GKE deployments." },
  ]},
  { id:"comparisons", label:"Comparison of Google Cloud Services", desc:"Head-to-head breakdowns of similar GCP services — the decisions that come up most often in interviews and architecture reviews.", subs:[
    { id:"bigquery-vs-bigtable",    label:"Google BigQuery vs BigTable",       desc:"BigQuery is a SQL-based analytical data warehouse for OLAP queries; Bigtable is a wide-column NoSQL store for high-throughput, low-latency operational workloads.", de:true },
    { id:"gcs-vs-persistent-disk-vs-local-ssd-vs-filestore", label:"GCS vs Persistent Disks vs Local SSD vs Filestore", desc:"GCS is global object storage; Persistent Disks are durable VM-attached block storage; Local SSD is ephemeral, ultra-fast VM storage; Filestore is a shared NFS file system.", de:true },
    { id:"cloud-functions-vs-app-engine-vs-cloud-run-vs-gke", label:"Cloud Functions vs App Engine vs Cloud Run vs GKE", desc:"Ordered roughly by control vs simplicity — Cloud Functions for single-purpose events, App Engine for managed apps, Cloud Run for containers with serverless scaling, GKE for full Kubernetes control." },
    { id:"gce-vs-app-engine",       label:"Google Compute Engine vs App Engine", desc:"Compute Engine gives full VM-level control over the OS and runtime; App Engine abstracts infrastructure entirely so you deploy just code." },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "gcp_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

const FILTER_KEY = "gcp_roadmap_filter_v1";
let filterMode = localStorage.getItem(FILTER_KEY) || "de";
function visibleTopics() {
  if (filterMode === "all") return ROADMAP;
  return ROADMAP
    .map(t => ({ ...t, subs: t.subs.filter((s: any) => s.de) }))
    .filter(t => t.subs.length > 0);
}

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  const topics = visibleTopics();
  topics.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < topics.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

function updateFilterUI() {
  document.querySelectorAll<HTMLButtonElement>(".rm-filter-btn").forEach(btn => {
    btn.classList.toggle("is-active", btn.dataset.mode === filterMode);
  });
  const total = allIds().length;
  const shown = visibleTopics().reduce((n, t) => n + 1 + t.subs.length, 0);
  const countEl = document.getElementById("rm-filter-count");
  if (countEl) countEl.textContent = `${shown} / ${total} shown`;
}

function setFilterMode(mode: string) {
  if (mode === filterMode) return;
  filterMode = mode;
  localStorage.setItem(FILTER_KEY, mode);
  buildFlow();
  updateFilterUI();
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress(); updateFilterUI();
document.querySelectorAll<HTMLButtonElement>(".rm-filter-btn").forEach(btn => {
  btn.addEventListener("click", () => setFilterMode(btn.dataset.mode!));
});
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
