---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/sql.json";
---

<StarlightPage
  frontmatter={{
    title: "SQL Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root" class="not-content">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">SQL</h1>
        <p class="rm-subtitle">Step-by-step guide to mastering SQL for data engineering</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index not-content" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading">Learn the Basics</h3>
        <p class="rm-index-desc">Core concepts of relational databases and the SQL language — where every journey starts.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/relational-databases/">What are Relational Databases?</a></span> <span class="rm-index-sub-desc">Tables, rows, columns, and the relational model introduced by Edgar Codd.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/rdbms-benefits-and-limitations/">RDBMS Benefits &amp; Limitations</a></span> <span class="rm-index-sub-desc">ACID properties, scalability trade-offs, and when to choose a relational DB.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/sql-keywords/">SQL Keywords</a></span> <span class="rm-index-sub-desc">Reserved words: SELECT, FROM, WHERE, JOIN, GROUP BY, ORDER BY, HAVING, etc.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/sql-vs-nosql/">SQL vs NoSQL Databases</a></span> <span class="rm-index-sub-desc">When to use relational vs document, key-value, column, or graph databases.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/sql-data-types/">Data Types</a></span> <span class="rm-index-sub-desc">INT, VARCHAR, TEXT, DATE, TIMESTAMP, BOOLEAN, DECIMAL, and vendor-specific types.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/sql-operators/">Operators</a></span> <span class="rm-index-sub-desc">Arithmetic, comparison, logical (AND/OR/NOT), BETWEEN, IN, LIKE, IS NULL.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/basic-syntax/">Basic SQL Syntax</a></h3>
        <p class="rm-index-desc">The fundamental SELECT statement and its clauses — how to read data from tables.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#select">SELECT</a></span> <span class="rm-index-sub-desc">Retrieving columns, using aliases, DISTINCT, and selecting all with *.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#from">FROM</a></span> <span class="rm-index-sub-desc">Specifying source tables, table aliases, and schema-qualified names.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#where">WHERE</a></span> <span class="rm-index-sub-desc">Filtering rows with conditions — combining predicates with AND/OR.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#order-by">ORDER BY</a></span> <span class="rm-index-sub-desc">Sorting results ASC/DESC, sorting by multiple columns and expressions.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#group-by">GROUP BY</a></span> <span class="rm-index-sub-desc">Grouping rows that have the same values in specified columns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#having">HAVING</a></span> <span class="rm-index-sub-desc">Filtering grouped results — the WHERE clause for aggregated data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/basic-syntax/#joins">JOINs</a></span> <span class="rm-index-sub-desc">Combining rows from two or more tables based on related columns.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/ddl/">Data Definition Language (DDL)</a></h3>
        <p class="rm-index-desc">Commands that define and modify the database schema — structure, not data.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/ddl/#create-table">CREATE TABLE</a></span> <span class="rm-index-sub-desc">Defining columns, data types, constraints, and default values.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/ddl/#alter-table">ALTER TABLE</a></span> <span class="rm-index-sub-desc">Adding, dropping, and modifying columns; renaming tables.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/ddl/#drop-table">DROP TABLE</a></span> <span class="rm-index-sub-desc">Permanently removing a table and all its data from the database.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/ddl/#truncate-table">TRUNCATE TABLE</a></span> <span class="rm-index-sub-desc">Removing all rows quickly without logging individual row deletions.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/dml/">Data Manipulation Language (DML)</a></h3>
        <p class="rm-index-desc">Commands for inserting, updating, and deleting data in tables.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/dml/#insert">INSERT</a></span> <span class="rm-index-sub-desc">Adding new rows — single row, multi-row, and INSERT … SELECT patterns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/dml/#update">UPDATE</a></span> <span class="rm-index-sub-desc">Modifying existing rows — always use WHERE to avoid full-table updates.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/dml/#delete">DELETE</a></span> <span class="rm-index-sub-desc">Removing rows — differences between DELETE, TRUNCATE, and DROP.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/aggregate-queries/">Aggregate Queries</a></h3>
        <p class="rm-index-desc">Computing summary statistics across groups of rows.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/aggregate-queries/#count">COUNT</a></span> <span class="rm-index-sub-desc">COUNT(*) vs COUNT(col) — handling NULLs in aggregation.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/aggregate-queries/#sum">SUM</a></span> <span class="rm-index-sub-desc">Summing numeric columns, using with COALESCE for NULL safety.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/aggregate-queries/#avg">AVG</a></span> <span class="rm-index-sub-desc">Arithmetic mean — note that AVG ignores NULLs automatically.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/aggregate-queries/#min">MIN</a></span> <span class="rm-index-sub-desc">Finding the smallest value in a column or expression.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/aggregate-queries/#max">MAX</a></span> <span class="rm-index-sub-desc">Finding the largest value in a column or expression.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/data-constraints/">Data Constraints</a></h3>
        <p class="rm-index-desc">Rules enforced by the database engine to maintain data integrity.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-constraints/#primary-key">Primary Key</a></span> <span class="rm-index-sub-desc">Uniquely identifies each row — auto-increment, composite keys.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-constraints/#foreign-key">Foreign Key</a></span> <span class="rm-index-sub-desc">Referential integrity — CASCADE, SET NULL, RESTRICT actions.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-constraints/#unique">UNIQUE</a></span> <span class="rm-index-sub-desc">Ensures no duplicate values in a column or column combination.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-constraints/#not-null">NOT NULL</a></span> <span class="rm-index-sub-desc">Prevents NULL values from being stored in a column.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-constraints/#check">CHECK</a></span> <span class="rm-index-sub-desc">Validates column values against a boolean expression.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/join-queries/">JOIN Queries</a></h3>
        <p class="rm-index-desc">Combining data from multiple tables using different join strategies.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#inner-join">INNER JOIN</a></span> <span class="rm-index-sub-desc">Returns rows where there is a match in both tables.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#left-join">LEFT JOIN</a></span> <span class="rm-index-sub-desc">All rows from the left table, matched rows from the right (NULL if no match).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#right-join">RIGHT JOIN</a></span> <span class="rm-index-sub-desc">All rows from the right table, matched rows from the left.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#full-outer-join">FULL OUTER JOIN</a></span> <span class="rm-index-sub-desc">All rows from both tables — NULLs where there is no match on either side.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#self-join">Self Join</a></span> <span class="rm-index-sub-desc">Joining a table to itself — useful for hierarchical or comparison queries.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/join-queries/#cross-join">Cross Join</a></span> <span class="rm-index-sub-desc">Cartesian product of two tables — every row paired with every other row.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/subqueries/">Subqueries</a></h3>
        <p class="rm-index-desc">Queries nested inside other queries — scalar, correlated, and derived tables.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/subqueries/#nested-subqueries">Nested Subqueries</a></span> <span class="rm-index-sub-desc">Subqueries in WHERE, HAVING, or SELECT clauses — IN, EXISTS, ANY, ALL.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/subqueries/#correlated-subqueries">Correlated Subqueries</a></span> <span class="rm-index-sub-desc">Subqueries that reference columns from the outer query — evaluated per row.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/subqueries/#scalar-subquery">Scalar Subquery</a></span> <span class="rm-index-sub-desc">Returns a single value — used in SELECT list or WHERE conditions.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/advanced-functions/">Advanced Functions</a></h3>
        <p class="rm-index-desc">Built-in functions for string manipulation, math, dates, and conditional logic.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-functions/#string-functions">String Functions</a></span> <span class="rm-index-sub-desc">CONCAT, LENGTH, SUBSTRING, REPLACE, UPPER, LOWER, TRIM, LIKE.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-functions/#math-functions">Math Functions</a></span> <span class="rm-index-sub-desc">FLOOR, CEILING, ROUND, ABS, MOD — rounding and numeric operations.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-functions/#date--time-functions">Date &amp; Time Functions</a></span> <span class="rm-index-sub-desc">DATE, TIME, TIMESTAMP, DATEPART, DATEADD — date arithmetic and formatting.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-functions/#case">CASE</a></span> <span class="rm-index-sub-desc">Conditional logic inside SQL — simple CASE vs searched CASE.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-functions/#coalesce--nullif">COALESCE / NULLIF</a></span> <span class="rm-index-sub-desc">COALESCE returns the first non-NULL value; NULLIF returns NULL when two values are equal.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/views/">Views</a></h3>
        <p class="rm-index-desc">Virtual tables based on saved queries — simplifying complex queries and access control.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/views/#creating-views">Creating Views</a></span> <span class="rm-index-sub-desc">CREATE VIEW — wrapping complex joins and logic into a reusable object.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/views/#modifying-views">Modifying Views</a></span> <span class="rm-index-sub-desc">CREATE OR REPLACE VIEW and ALTER VIEW depending on the database.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/views/#dropping-views">Dropping Views</a></span> <span class="rm-index-sub-desc">DROP VIEW — removing views without affecting the underlying tables.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/indexes/">Indexes</a></h3>
        <p class="rm-index-desc">Data structures that speed up queries at the cost of write overhead and storage.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/indexes/#managing-indexes">Managing Indexes</a></span> <span class="rm-index-sub-desc">CREATE INDEX, DROP INDEX, partial indexes, and covering indexes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/indexes/#query-optimization-with-indexes">Query Optimization with Indexes</a></span> <span class="rm-index-sub-desc">How the query planner uses indexes — EXPLAIN / ANALYZE output.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/transactions/">Transactions</a></h3>
        <p class="rm-index-desc">Grouping SQL statements into atomic units of work that succeed or fail together.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#begin">BEGIN</a></span> <span class="rm-index-sub-desc">Starting a transaction — implicit vs explicit transaction management.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#commit">COMMIT</a></span> <span class="rm-index-sub-desc">Permanently saving all changes made in the current transaction.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#rollback">ROLLBACK</a></span> <span class="rm-index-sub-desc">Undoing all changes since the last COMMIT or SAVEPOINT.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#savepoint">SAVEPOINT</a></span> <span class="rm-index-sub-desc">Creating a partial rollback point within a transaction.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#acid">ACID</a></span> <span class="rm-index-sub-desc">Atomicity, Consistency, Isolation, Durability — the four transaction guarantees.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/transactions/#transaction-isolation-levels">Transaction Isolation Levels</a></span> <span class="rm-index-sub-desc">READ UNCOMMITTED, READ COMMITTED, REPEATABLE READ, SERIALIZABLE.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/data-integrity-security/">Data Integrity &amp; Security</a></h3>
        <p class="rm-index-desc">Protecting data correctness and controlling who can access what.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-integrity-security/#data-integrity-constraints">Data Integrity Constraints</a></span> <span class="rm-index-sub-desc">Entity, referential, and domain integrity — enforced at the DB level.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-integrity-security/#grant-and-revoke">GRANT and REVOKE</a></span> <span class="rm-index-sub-desc">Managing user privileges — SELECT, INSERT, UPDATE, DELETE, EXECUTE.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/data-integrity-security/#db-security-best-practices">DB Security Best Practices</a></span> <span class="rm-index-sub-desc">Least privilege, parameterised queries, auditing, encryption at rest.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/stored-procedures-functions/">Stored Procedures &amp; Functions</a></h3>
        <p class="rm-index-desc">Reusable server-side logic stored in the database.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/stored-procedures-functions/#scalar-functions">Scalar Functions</a></span> <span class="rm-index-sub-desc">Return a single value — used in SELECT lists and WHERE clauses.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/stored-procedures-functions/#table-valued-functions">Table-valued Functions</a></span> <span class="rm-index-sub-desc">Return a result set — inline and multi-statement variants.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/stored-procedures-functions/#row--column-functions">Row &amp; Column Functions</a></span> <span class="rm-index-sub-desc">Functions that operate per-row — window function foundations.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/performance-optimization/">Performance Optimization</a></h3>
        <p class="rm-index-desc">Techniques to make SQL queries run faster at scale.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/performance-optimization/#query-analysis-techniques">Query Analysis Techniques</a></span> <span class="rm-index-sub-desc">EXPLAIN / EXPLAIN ANALYZE — reading query plans, identifying bottlenecks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/performance-optimization/#using-indexes-effectively">Using Indexes Effectively</a></span> <span class="rm-index-sub-desc">Index selectivity, covering indexes, avoiding index scans on low-cardinality columns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/performance-optimization/#optimizing-joins">Optimizing Joins</a></span> <span class="rm-index-sub-desc">Join order, hash joins vs nested loop vs merge join.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/performance-optimization/#reducing-subqueries">Reducing Subqueries</a></span> <span class="rm-index-sub-desc">Rewriting correlated subqueries as joins or CTEs for better performance.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/performance-optimization/#selective-projection">Selective Projection</a></span> <span class="rm-index-sub-desc">Selecting only needed columns — avoiding SELECT * in production queries.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/sql/advanced-sql/">Advanced SQL</a></h3>
        <p class="rm-index-desc">Power features for complex analytical and programmatic SQL work.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#window-functions">Window Functions</a></span> <span class="rm-index-sub-desc">OVER(), PARTITION BY, ROWS/RANGE — running totals, moving averages.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#rank--dense_rank--row_number">RANK / DENSE_RANK / ROW_NUMBER</a></span> <span class="rm-index-sub-desc">Ranking rows within partitions — differences and use cases.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#lead--lag">LEAD / LAG</a></span> <span class="rm-index-sub-desc">Accessing values from the next or previous row within a partition.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#common-table-expressions-ctes">Common Table Expressions (CTEs)</a></span> <span class="rm-index-sub-desc">WITH clause — making complex queries readable and enabling recursion.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#recursive-queries">Recursive Queries</a></span> <span class="rm-index-sub-desc">Recursive CTEs for hierarchical data — org charts, bill of materials.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#pivot--unpivot-operations">Pivot / Unpivot Operations</a></span> <span class="rm-index-sub-desc">Transforming rows to columns and back — PIVOT, UNPIVOT, conditional aggregation.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/sql/advanced-sql/#dynamic-sql">Dynamic SQL</a></span> <span class="rm-index-sub-desc">Building and executing SQL strings at runtime — sp_executesql, EXECUTE.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "sql_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
