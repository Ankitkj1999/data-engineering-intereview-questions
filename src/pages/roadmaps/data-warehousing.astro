---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/data-warehousing.json";
---

<StarlightPage
  frontmatter={{
    title: "Data Warehousing Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Data Warehousing</h1>
        <p class="rm-subtitle">Step-by-step guide to warehouse architecture, modelling and administration</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
