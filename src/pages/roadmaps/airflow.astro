---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/airflow.json";
---

<StarlightPage
  frontmatter={{
    title: "Apache Airflow Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Airflow</h1>
        <p class="rm-subtitle">Step-by-step guide to orchestrating data pipelines</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Core Concepts</a></h3>
        <p class="rm-index-desc">17 interview questions covering Fundamentals, DAGs, Architecture, Executors and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Fundamentals</a></span> <span class="rm-index-sub-desc">What is Airflow? What issues does Airflow resolve compared to cron?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">DAGs</a></span> <span class="rm-index-sub-desc">Explain how a workflow is designed in Airflow.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Architecture</a></span> <span class="rm-index-sub-desc">Explain Airflow's architecture and its components.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Executors</a></span> <span class="rm-index-sub-desc">The executors are the components that actually execute tasks, while the scheduler orchestrates them.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">DAG Definition</a></span> <span class="rm-index-sub-desc">How do you define a workflow in Airflow?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Scheduling</a></span> <span class="rm-index-sub-desc">A cron expression is composed of 5 fields separated by spaces: Breaking down schedule_interval='30 8 * * 1-5': 1.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Docker</a></span> <span class="rm-index-sub-desc">If you're using Docker Compose, you need to build a custom image with your own additional dependencies in order to make the module available to Airflow.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">XCom</a></span> <span class="rm-index-sub-desc">XCom (short for &quot;cross-communication&quot;) are messages that allow data to be passed between tasks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#interview-questions">Templating</a></span> <span class="rm-index-sub-desc">What are Jinja templates? How do you use Airflow XComs in Jinja templates?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#operators-hooks--connections">Operators, Hooks &amp; Connections</a></h3>
        <p class="rm-index-desc">5 interview questions covering Operators, Hooks, Connections, Variables.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operators-hooks--connections">Operators</a></span> <span class="rm-index-sub-desc">An operator is a template for a single task — it defines what* work gets done (run a Python function, execute a bash command, run a SQL query, copy a file to S3).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operators-hooks--connections">Hooks</a></span> <span class="rm-index-sub-desc">A connection stores the credentials and connection details for an external system (host, login, password, extra config) in Airflow's metadata database, referenced by a conn_id string rather than hardcoded values.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operators-hooks--connections">Connections</a></span> <span class="rm-index-sub-desc">Connections are created through the Airflow UI (Admin → Connections), the CLI (airflow connections add), or environment variables (AIRFLOW_CONN_*) — never hardcoded in DAG files.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operators-hooks--connections">Variables</a></span> <span class="rm-index-sub-desc">Variables are key-value settings stored in Airflow's metadata database, meant for configuration that's the same across runs — an environment name, a feature flag, a file path prefix.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api">Modern DAG Authoring: TaskFlow API</a></h3>
        <p class="rm-index-desc">5 interview questions covering TaskFlow, TaskGroups, Dynamic Tasks.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api">TaskFlow</a></span> <span class="rm-index-sub-desc">TaskFlow lets you write DAGs as plain Python functions with a @task decorator — dependencies and XCom passing are inferred from how you call the functions, instead of manually instantiating operators and wiring &gt;&gt;/xcom_pull by hand.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api">TaskGroups</a></span> <span class="rm-index-sub-desc">What are TaskGroups, and why would you use one?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api">Dynamic Tasks</a></span> <span class="rm-index-sub-desc">Dynamic task mapping creates a variable number of task instances at runtime, based on data that isn't known until the DAG actually runs — one file discovered in S3, one partition per date range, one API page.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules">Control Flow: Branching &amp; Trigger Rules</a></h3>
        <p class="rm-index-desc">4 interview questions covering Dependencies, Branching, Trigger Rules.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules">Dependencies</a></span> <span class="rm-index-sub-desc">How do you set task dependencies in Airflow?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules">Branching</a></span> <span class="rm-index-sub-desc">The branching function returns the task_id (or list of ids) that should run next; every other downstream task in that branch point is automatically skipped, not just left unscheduled.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules">Trigger Rules</a></span> <span class="rm-index-sub-desc">A trigger rule decides when a task is eligible to run based on the state of its upstream tasks.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency">Scheduling, Backfills &amp; Idempotency</a></h3>
        <p class="rm-index-desc">4 interview questions covering Scheduling, Backfills, SLAs, Resource Management.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency">Scheduling</a></span> <span class="rm-index-sub-desc">What's the difference between execution_date and data_interval in Airflow scheduling?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency">Backfills</a></span> <span class="rm-index-sub-desc">What's the difference between catchup and backfill?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency">SLAs</a></span> <span class="rm-index-sub-desc">What is an SLA in Airflow, and what happens when one is missed?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency">Resource Management</a></span> <span class="rm-index-sub-desc">What are pools and priority weights used for?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Operations, Testing &amp; Ecosystem</a></h3>
        <p class="rm-index-desc">5 interview questions covering Testing, Monitoring, Performance, Ecosystem and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Testing</a></span> <span class="rm-index-sub-desc">How do you unit test an Airflow DAG?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Monitoring</a></span> <span class="rm-index-sub-desc">How do you set up alerting when a task fails?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Performance</a></span> <span class="rm-index-sub-desc">Why does DAG file parsing performance matter, and what's a common mistake that hurts it?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Ecosystem</a></span> <span class="rm-index-sub-desc">Airflow is the most established and widely adopted, with the largest ecosystem of providers/integrations, but its DAG model is comparatively low-level about data (tasks pass small XComs, not first-class typed data assets).</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem">Operations</a></span> <span class="rm-index-sub-desc">What can you do with the Airflow REST API or CLI that you can't easily do from the UI?</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "airflow_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
