---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Apache Airflow Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Apache Airflow</h1>
        <p class="rm-subtitle">Step-by-step guide to orchestrating data pipelines</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"core-concepts", label:"Core Concepts", desc:"17 interview questions covering Fundamentals, DAGs, Architecture, Executors and more.", link:"/level-3-technologies/orchestration/airflow/#interview-questions", subs:[
    { id:"core-concepts-fundamentals", label:"Fundamentals", desc:"What is Airflow? What issues does Airflow resolve compared to cron?", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-dags", label:"DAGs", desc:"Explain how a workflow is designed in Airflow.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-architecture", label:"Architecture", desc:"Explain Airflow's architecture and its components.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-executors", label:"Executors", desc:"The executors are the components that actually execute tasks, while the scheduler orchestrates them.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-dag-definition", label:"DAG Definition", desc:"How do you define a workflow in Airflow?", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-scheduling", label:"Scheduling", desc:"A cron expression is composed of 5 fields separated by spaces: Breaking down schedule_interval='30 8 * * 1-5': 1.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-docker", label:"Docker", desc:"If you're using Docker Compose, you need to build a custom image with your own additional dependencies in order to make the module available to Airflow.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-xcom", label:"XCom", desc:"XCom (short for \"cross-communication\") are messages that allow data to be passed between tasks.", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
    { id:"core-concepts-templating", label:"Templating", desc:"What are Jinja templates? How do you use Airflow XComs in Jinja templates?", link:"/level-3-technologies/orchestration/airflow/#interview-questions" },
  ]},
  { id:"operators-hooks-connections", label:"Operators, Hooks & Connections", desc:"5 interview questions covering Operators, Hooks, Connections, Variables.", link:"/level-3-technologies/orchestration/airflow/#operators-hooks--connections", subs:[
    { id:"operators-hooks-connections-operators", label:"Operators", desc:"An operator is a template for a single task — it defines what* work gets done (run a Python function, execute a bash command, run a SQL query, copy a file to S3).", link:"/level-3-technologies/orchestration/airflow/#operators-hooks--connections" },
    { id:"operators-hooks-connections-hooks", label:"Hooks", desc:"A connection stores the credentials and connection details for an external system (host, login, password, extra config) in Airflow's metadata database, referenced by a conn_id string rather than hardcoded values.", link:"/level-3-technologies/orchestration/airflow/#operators-hooks--connections" },
    { id:"operators-hooks-connections-connections", label:"Connections", desc:"Connections are created through the Airflow UI (Admin → Connections), the CLI (airflow connections add), or environment variables (AIRFLOW_CONN_*) — never hardcoded in DAG files.", link:"/level-3-technologies/orchestration/airflow/#operators-hooks--connections" },
    { id:"operators-hooks-connections-variables", label:"Variables", desc:"Variables are key-value settings stored in Airflow's metadata database, meant for configuration that's the same across runs — an environment name, a feature flag, a file path prefix.", link:"/level-3-technologies/orchestration/airflow/#operators-hooks--connections" },
  ]},
  { id:"modern-dag-authoring-taskflow-api", label:"Modern DAG Authoring: TaskFlow API", desc:"5 interview questions covering TaskFlow, TaskGroups, Dynamic Tasks.", link:"/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api", subs:[
    { id:"modern-dag-authoring-taskflow-api-taskflow", label:"TaskFlow", desc:"TaskFlow lets you write DAGs as plain Python functions with a @task decorator — dependencies and XCom passing are inferred from how you call the functions, instead of manually instantiating operators and wiring >>/xcom_pull by hand.", link:"/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api" },
    { id:"modern-dag-authoring-taskflow-api-taskgroups", label:"TaskGroups", desc:"What are TaskGroups, and why would you use one?", link:"/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api" },
    { id:"modern-dag-authoring-taskflow-api-dynamic-tasks", label:"Dynamic Tasks", desc:"Dynamic task mapping creates a variable number of task instances at runtime, based on data that isn't known until the DAG actually runs — one file discovered in S3, one partition per date range, one API page.", link:"/level-3-technologies/orchestration/airflow/#modern-dag-authoring-taskflow-api" },
  ]},
  { id:"control-flow-branching-trigger-rules", label:"Control Flow: Branching & Trigger Rules", desc:"4 interview questions covering Dependencies, Branching, Trigger Rules.", link:"/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules", subs:[
    { id:"control-flow-branching-trigger-rules-dependencies", label:"Dependencies", desc:"How do you set task dependencies in Airflow?", link:"/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules" },
    { id:"control-flow-branching-trigger-rules-branching", label:"Branching", desc:"The branching function returns the task_id (or list of ids) that should run next; every other downstream task in that branch point is automatically skipped, not just left unscheduled.", link:"/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules" },
    { id:"control-flow-branching-trigger-rules-trigger-rules", label:"Trigger Rules", desc:"A trigger rule decides when a task is eligible to run based on the state of its upstream tasks.", link:"/level-3-technologies/orchestration/airflow/#control-flow-branching--trigger-rules" },
  ]},
  { id:"scheduling-backfills-idempotency", label:"Scheduling, Backfills & Idempotency", desc:"4 interview questions covering Scheduling, Backfills, SLAs, Resource Management.", link:"/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency", subs:[
    { id:"scheduling-backfills-idempotency-scheduling", label:"Scheduling", desc:"What's the difference between execution_date and data_interval in Airflow scheduling?", link:"/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency" },
    { id:"scheduling-backfills-idempotency-backfills", label:"Backfills", desc:"What's the difference between catchup and backfill?", link:"/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency" },
    { id:"scheduling-backfills-idempotency-slas", label:"SLAs", desc:"What is an SLA in Airflow, and what happens when one is missed?", link:"/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency" },
    { id:"scheduling-backfills-idempotency-resource-management", label:"Resource Management", desc:"What are pools and priority weights used for?", link:"/level-3-technologies/orchestration/airflow/#scheduling-backfills--idempotency" },
  ]},
  { id:"operations-testing-ecosystem", label:"Operations, Testing & Ecosystem", desc:"5 interview questions covering Testing, Monitoring, Performance, Ecosystem and more.", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem", subs:[
    { id:"operations-testing-ecosystem-testing", label:"Testing", desc:"How do you unit test an Airflow DAG?", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem" },
    { id:"operations-testing-ecosystem-monitoring", label:"Monitoring", desc:"How do you set up alerting when a task fails?", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem" },
    { id:"operations-testing-ecosystem-performance", label:"Performance", desc:"Why does DAG file parsing performance matter, and what's a common mistake that hurts it?", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem" },
    { id:"operations-testing-ecosystem-ecosystem", label:"Ecosystem", desc:"Airflow is the most established and widely adopted, with the largest ecosystem of providers/integrations, but its DAG model is comparatively low-level about data (tasks pass small XComs, not first-class typed data assets).", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem" },
    { id:"operations-testing-ecosystem-operations", label:"Operations", desc:"What can you do with the Airflow REST API or CLI that you can't easily do from the UI?", link:"/level-3-technologies/orchestration/airflow/#operations-testing--ecosystem" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "airflow_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
