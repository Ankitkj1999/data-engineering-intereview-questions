---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Hadoop Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Hadoop</h1>
        <p class="rm-subtitle">Step-by-step guide to HDFS, MapReduce and the Hadoop ecosystem</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"hdfs-fundamentals-architecture", label:"HDFS Fundamentals & Architecture", desc:"29 interview questions covering HDFS, Storage, Blocks, HDFS I/O and more.", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture", subs:[
    { id:"hdfs-fundamentals-architecture-hdfs", label:"HDFS", desc:"A Hadoop application has four core components: - HDFS — the distributed file system in which Hadoop data is stored, offering very high bandwidth.", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture" },
    { id:"hdfs-fundamentals-architecture-storage", label:"Storage", desc:"NAS (Network Attached Storage) — compute and storage are separated; storage is distributed over servers on a network.", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture" },
    { id:"hdfs-fundamentals-architecture-blocks", label:"Blocks", desc:"HDFS stores all data in blocks, and the block size is configurable.", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture" },
    { id:"hdfs-fundamentals-architecture-hdfs-i-o", label:"HDFS I/O", desc:"Reading is done in parallel because it lets Hadoop access data faster — the whole point of distributing storage.", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture" },
    { id:"hdfs-fundamentals-architecture-big-data", label:"Big Data", desc:"Real-world examples include: Facebook generating 500+ terabytes of data per day, the New York Stock Exchange generating about 1 terabyte of new trade data per…", link:"/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture" },
  ]},
  { id:"namenode-datanode-checkpointing", label:"NameNode, DataNode & Checkpointing", desc:"19 interview questions covering NameNode, DataNode.", link:"/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing", subs:[
    { id:"namenode-datanode-checkpointing-namenode", label:"NameNode", desc:"NameNode — the heart of HDFS; it manages metadata.", link:"/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing" },
    { id:"namenode-datanode-checkpointing-datanode", label:"DataNode", desc:"When data is stored on a DataNode, the corresponding metadata is reported to the NameNode.", link:"/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing" },
  ]},
  { id:"replication-rack-awareness-fault-tolerance", label:"Replication, Rack Awareness & Fault Tolerance", desc:"15 interview questions covering Rack Awareness, Replication, Fault Tolerance.", link:"/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance", subs:[
    { id:"replication-rack-awareness-fault-tolerance-rack-awareness", label:"Rack Awareness", desc:"Apache Hadoop provides NetworkTopology.getDistance() to get the distance between two nodes.", link:"/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance" },
    { id:"replication-rack-awareness-fault-tolerance-replication", label:"Replication", desc:"Replication factor is the number of copies of a file HDFS maintains.", link:"/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance" },
    { id:"replication-rack-awareness-fault-tolerance-fault-tolerance", label:"Fault Tolerance", desc:"HDFS has a master/slave architecture: a single NameNode manages the file system namespace and regulates client access, while multiple DataNodes (usually one…", link:"/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance" },
  ]},
  { id:"mapreduce-fundamentals", label:"MapReduce Fundamentals", desc:"29 interview questions covering MapReduce, Data Locality, InputSplit, Blocks.", link:"/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals", subs:[
    { id:"mapreduce-fundamentals-mapreduce", label:"MapReduce", desc:"Apache Hadoop is built on the MapReduce algorithm, in which Map and Reduce operations process very large data sets: the Map method filters and sorts data, and…", link:"/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals" },
    { id:"mapreduce-fundamentals-data-locality", label:"Data Locality", desc:"Since Big Data volumes are huge, it doesn't make sense to move the data across the network.", link:"/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals" },
    { id:"mapreduce-fundamentals-inputsplit", label:"InputSplit", desc:"InputSplit is the chunk of data processed by a single mapper — in other words, the logical chunk of data assigned to one mapper.", link:"/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals" },
    { id:"mapreduce-fundamentals-blocks", label:"Blocks", desc:"Block — how much data is physically stored together in HDFS.", link:"/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals" },
  ]},
  { id:"mapper-reducer-internals", label:"Mapper & Reducer Internals", desc:"19 interview questions covering Reducer, Mapper, MapReduce.", link:"/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals", subs:[
    { id:"mapper-reducer-internals-reducer", label:"Reducer", desc:"The main task of a Reducer is to reduce a larger set of data sharing a key down to a smaller set.", link:"/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals" },
    { id:"mapper-reducer-internals-mapper", label:"Mapper", desc:"The map() method is called separately for each input key/value pair — it processes an input pair and emits intermediate key/value pairs.", link:"/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals" },
    { id:"mapper-reducer-internals-mapreduce", label:"MapReduce", desc:"Hadoop can only compare at the key level — it does not support value-level comparison natively.", link:"/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals" },
  ]},
  { id:"combiners-partitioners-shuffle", label:"Combiners, Partitioners & Shuffle", desc:"19 interview questions covering Partitioner, Combiner, Reducer.", link:"/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle", subs:[
    { id:"combiners-partitioners-shuffle-partitioner", label:"Partitioner", desc:"5 interview questions on partitioner, in the Combiners, Partitioners & Shuffle section.", link:"/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle" },
    { id:"combiners-partitioners-shuffle-combiner", label:"Combiner", desc:"A Combiner is an optional step between Map and Reduce, also called a Semi-Reducer.", link:"/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle" },
    { id:"combiners-partitioners-shuffle-reducer", label:"Reducer", desc:"Setting the number of reducers to 0 is a valid configuration.", link:"/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle" },
  ]},
  { id:"jobtracker-tasktracker-job-execution", label:"JobTracker, TaskTracker & Job Execution", desc:"25 interview questions covering JobTracker, TaskTracker.", link:"/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution", subs:[
    { id:"jobtracker-tasktracker-job-execution-jobtracker", label:"JobTracker", desc:"Scheduling a job's tasks onto the slave nodes, which execute them as directed.", link:"/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution" },
    { id:"jobtracker-tasktracker-job-execution-tasktracker", label:"TaskTracker", desc:"Hadoop developers sometimes submit buggy or incorrect jobs.", link:"/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution" },
  ]},
  { id:"hadoop-ecosystem-deployment-configuration", label:"Hadoop Ecosystem, Deployment & Configuration", desc:"27 interview questions covering Ecosystem, Cluster Hardware, Config, Hadoop Modes.", link:"/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration", subs:[
    { id:"hadoop-ecosystem-deployment-configuration-ecosystem", label:"Ecosystem", desc:"Hadoop Streaming is a Java utility, packaged as a JAR, that ships with the Hadoop distribution.", link:"/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration" },
    { id:"hadoop-ecosystem-deployment-configuration-cluster-hardware", label:"Cluster Hardware", desc:"Recommended baseline: dual-core or dual-processor machines with 4GB or 8GB RAM using ECC (Error-Correcting Code) memory — without ECC, checksum errors become much more likely.", link:"/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration" },
    { id:"hadoop-ecosystem-deployment-configuration-config", label:"Config", desc:"NameNode runs on port 50070 - Task Tracker runs on port 50060 - Job Tracker runs on port 50030", link:"/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration" },
    { id:"hadoop-ecosystem-deployment-configuration-hadoop-modes", label:"Hadoop Modes", desc:"Standalone (local) mode — no Hadoop daemons running; everything runs in a single JVM.", link:"/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration" },
  ]},
  { id:"performance-tuning-troubleshooting", label:"Performance, Tuning & Troubleshooting", desc:"19 interview questions covering Troubleshooting, Admin, Performance, Networking.", link:"/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting", subs:[
    { id:"performance-tuning-troubleshooting-troubleshooting", label:"Troubleshooting", desc:"2 interview questions on troubleshooting, in the Performance, Tuning & Troubleshooting section.", link:"/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting" },
    { id:"performance-tuning-troubleshooting-admin", label:"Admin", desc:"HDFS DataNodes support hot-swappable drives, which let you add or replace data volumes while the DataNode keeps running: - Format and mount the new drive.", link:"/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting" },
    { id:"performance-tuning-troubleshooting-performance", label:"Performance", desc:"TaskTracker is the process most likely to consume high memory while running a task.", link:"/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting" },
    { id:"performance-tuning-troubleshooting-networking", label:"Networking", desc:"SSH is the mode of communication used between the client and the NameNode/DataNode.", link:"/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "hadoop_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
