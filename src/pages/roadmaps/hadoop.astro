---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/hadoop.json";
---

<StarlightPage
  frontmatter={{
    title: "Hadoop Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Hadoop</h1>
        <p class="rm-subtitle">Step-by-step guide to HDFS, MapReduce and the Hadoop ecosystem</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">HDFS Fundamentals &amp; Architecture</a></h3>
        <p class="rm-index-desc">29 interview questions covering HDFS, Storage, Blocks, HDFS I/O and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">HDFS</a></span> <span class="rm-index-sub-desc">HDFS is responsible for storing huge volumes of data across a cluster and is designed to run on commodity hardware.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">Storage</a></span> <span class="rm-index-sub-desc">NAS (Network Attached Storage) — compute and storage are separated; storage is distributed over servers on a network.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">Blocks</a></span> <span class="rm-index-sub-desc">In HDFS, data is split into blocks (typically 64MB or 128MB) distributed across the cluster, and each block is replicated multiple times (three, by default) across different nodes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">HDFS I/O</a></span> <span class="rm-index-sub-desc">Reading is done in parallel because it lets Hadoop access data faster — the whole point of distributing storage.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hdfs-fundamentals--architecture">Big Data</a></span> <span class="rm-index-sub-desc">Traditional RDBMS is built for transactional systems — reporting and archiving data, and is useful when you want to look up a single record from a large data set.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing">NameNode, DataNode &amp; Checkpointing</a></h3>
        <p class="rm-index-desc">19 interview questions covering NameNode, DataNode.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing">NameNode</a></span> <span class="rm-index-sub-desc">Heartbeat — signals that the DataNode is still alive; the NameNode relies on periodic heartbeats to decide whether to keep using a DataNode.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#namenode-datanode--checkpointing">DataNode</a></span> <span class="rm-index-sub-desc">When data is stored on a DataNode, the corresponding metadata is reported to the NameNode.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance">Replication, Rack Awareness &amp; Fault Tolerance</a></h3>
        <p class="rm-index-desc">15 interview questions covering Rack Awareness, Replication, Fault Tolerance.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance">Rack Awareness</a></span> <span class="rm-index-sub-desc">Most Hadoop components — NameNode, DataNode, and others — are &quot;rack-aware,&quot; meaning they know which rack they're physically on.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance">Replication</a></span> <span class="rm-index-sub-desc">Replication factor is the number of copies of a file HDFS maintains.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#replication-rack-awareness--fault-tolerance">Fault Tolerance</a></span> <span class="rm-index-sub-desc">A heartbeat is a signal indicating that a process is alive — a DataNode sends heartbeats to the NameNode, and a TaskTracker sends heartbeats to the JobTracker.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals">MapReduce Fundamentals</a></h3>
        <p class="rm-index-desc">29 interview questions covering MapReduce, Data Locality, InputSplit, Blocks.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals">MapReduce</a></span> <span class="rm-index-sub-desc">Apache Hadoop is built on the MapReduce algorithm, in which Map and Reduce operations process very large data sets: the Map method filters and sorts data, and the Reduce method summarizes it — a concept borrowed from functional programming.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals">Data Locality</a></span> <span class="rm-index-sub-desc">Data locality means processing data wherever it already resides, rather than moving it — &quot;moving computation is cheaper than moving data.&quot; This is only possible when the data is splittable, which it is by default.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals">InputSplit</a></span> <span class="rm-index-sub-desc">InputSplit is the chunk of data processed by a single mapper — in other words, the logical chunk of data assigned to one mapper.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapreduce-fundamentals">Blocks</a></span> <span class="rm-index-sub-desc">What is the difference between block and split?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals">Mapper &amp; Reducer Internals</a></h3>
        <p class="rm-index-desc">19 interview questions covering Reducer, Mapper, MapReduce.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals">Reducer</a></span> <span class="rm-index-sub-desc">The main task of a Reducer is to reduce a larger set of data sharing a key down to a smaller set.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals">Mapper</a></span> <span class="rm-index-sub-desc">A ChainMapper is a special class that lets multiple mapper classes run in a chained fashion within a single map task — one mapper's output feeds directly into the next mapper's input, letting you chain any number of mappers together.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#mapper--reducer-internals">MapReduce</a></span> <span class="rm-index-sub-desc">How do you do value-level comparison?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle">Combiners, Partitioners &amp; Shuffle</a></h3>
        <p class="rm-index-desc">19 interview questions covering Partitioner, Combiner, Reducer.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle">Partitioner</a></span> <span class="rm-index-sub-desc">After the combiner and intermediate map output, the Partitioner controls the keys after sort and shuffle.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle">Combiner</a></span> <span class="rm-index-sub-desc">A Combiner is an optional class, specified via Job.setCombinerClass(ClassName), that performs local aggregation of intermediate outputs — cutting down the amount of data transferred from the Mapper to the Reducer.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#combiners-partitioners--shuffle">Reducer</a></span> <span class="rm-index-sub-desc">The mapper's intermediate output is stored on the local file system (not HDFS) of each individual mapper node — typically a temporary directory location configured by the Hadoop administrator.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution">JobTracker, TaskTracker &amp; Job Execution</a></h3>
        <p class="rm-index-desc">25 interview questions covering JobTracker, TaskTracker.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution">JobTracker</a></span> <span class="rm-index-sub-desc">JobTracker is a daemon service that submits and tracks MapReduce tasks across the Hadoop cluster.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#jobtracker-tasktracker--job-execution">TaskTracker</a></span> <span class="rm-index-sub-desc">A TaskTracker is a slave-node daemon that accepts tasks — Map, Reduce, and Shuffle operations — from a JobTracker.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration">Hadoop Ecosystem, Deployment &amp; Configuration</a></h3>
        <p class="rm-index-desc">27 interview questions covering Ecosystem, Cluster Hardware, Config, Hadoop Modes.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration">Ecosystem</a></span> <span class="rm-index-sub-desc">Hadoop provides DistCP (Distributed Copy), a MapReduce-based utility for large inter- or intra-cluster copies of data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration">Cluster Hardware</a></span> <span class="rm-index-sub-desc">Commodity hardware is an inexpensive system that isn't high-quality or high-availability — Hadoop can run on any average commodity hardware and doesn't need supercomputers or high-end machines.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration">Config</a></span> <span class="rm-index-sub-desc">What are the default port numbers on which Nodes run in Hadoop? What are the important configuration files in Hadoop?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#hadoop-ecosystem-deployment--configuration">Hadoop Modes</a></span> <span class="rm-index-sub-desc">No Hadoop daemons run, and everything runs in a single Java process — so you don't get the benefit of distributing code across a cluster.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting">Performance, Tuning &amp; Troubleshooting</a></h3>
        <p class="rm-index-desc">19 interview questions covering Troubleshooting, Admin, Performance, Networking.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting">Troubleshooting</a></span> <span class="rm-index-sub-desc">Why do we use the fsck command in HDFS? Why might you get a connection-refused Java exception running Hadoop fsck?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting">Admin</a></span> <span class="rm-index-sub-desc">Similar to formatting a drive in Windows, formatting the DFS structures data properly — but it also formats the NameNode in the process, which is generally not something you want to do casually.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting">Performance</a></span> <span class="rm-index-sub-desc">Assuming a 64MB block size with 2 mappers and 2 reducers: 64 * 4 = 256MB of memory, and the OS needs at least 30% extra headroom, so 256 + 80 = 326MB of RAM is roughly required to process that chunk of data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/batch-processing/hadoop/#performance-tuning--troubleshooting">Networking</a></span> <span class="rm-index-sub-desc">SSH (Secure Shell) is a secure protocol and the most common way to administer remote servers safely — relatively simple and inexpensive to implement.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "hadoop_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
