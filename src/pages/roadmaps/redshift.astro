---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/redshift.json";
---

<StarlightPage
  frontmatter={{
    title: "Amazon Redshift Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Amazon Redshift</h1>
        <p class="rm-subtitle">Step-by-step guide to Redshift architecture, loading and tuning</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#fundamentals--architecture">Fundamentals &amp; Architecture</a></h3>
        <p class="rm-index-desc">18 interview questions covering Fundamentals, Clustering.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#fundamentals--architecture">Fundamentals</a></span> <span class="rm-index-sub-desc">Data in Amazon Redshift is distributed across multiple slices, with each slice residing on a different node in a cluster.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#fundamentals--architecture">Clustering</a></span> <span class="rm-index-sub-desc">The maximum size of a single Amazon Redshift cluster is 128 compute nodes for the RA3 node type as of September 2021.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#distribution-sort-keys--maintenance">Distribution, Sort Keys &amp; Maintenance</a></h3>
        <p class="rm-index-desc">18 interview questions covering Keys, Maintenance, Storage, Clustering.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#distribution-sort-keys--maintenance">Keys</a></span> <span class="rm-index-sub-desc">What is a sort key in Amazon Redshift? What is a distribution key in Amazon Redshift?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#distribution-sort-keys--maintenance">Maintenance</a></span> <span class="rm-index-sub-desc">The VACUUM command reclaims disk space and resorts rows, while the ANALYZE command updates statistics that are used by the query optimizer to generate efficient query plans.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#distribution-sort-keys--maintenance">Storage</a></span> <span class="rm-index-sub-desc">You can optimize storage in Amazon Redshift by choosing appropriate compression encodings for columns, using the ANALYZE command to update statistics, and using the VACUUM command to reclaim disk space.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#distribution-sort-keys--maintenance">Clustering</a></span> <span class="rm-index-sub-desc">When a new node is added to the Redshift cluster, the data is redistributed across the existing and new nodes based on the distribution style and distribution key defined for each table.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#query-performance--optimization">Query Performance &amp; Optimization</a></h3>
        <p class="rm-index-desc">16 interview questions covering Performance, Schema.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#query-performance--optimization">Performance</a></span> <span class="rm-index-sub-desc">Amazon Redshift provides various monitoring tools, including CloudWatch metrics, system tables, query logging, and performance analysis reports to monitor and optimize cluster performance.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#query-performance--optimization">Schema</a></span> <span class="rm-index-sub-desc">Redshift's query optimizer is specifically designed to optimize queries on star schema data models, leveraging sort keys, distribution keys, and zone maps to accelerate query performance.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#data-loading--export">Data Loading &amp; Export</a></h3>
        <p class="rm-index-desc">16 interview questions covering Data Loading, Encryption.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#data-loading--export">Data Loading</a></span> <span class="rm-index-sub-desc">The recommended way to load large amounts of data into Redshift is by using the COPY command, which efficiently loads data in parallel from Amazon S3 or other supported sources.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#data-loading--export">Encryption</a></span> <span class="rm-index-sub-desc">The ENCRYPTED option in the COPY command allows you to specify that the data being loaded into Redshift is already encrypted, ensuring secure data transfer and storage.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Security, Backup &amp; Compliance</a></h3>
        <p class="rm-index-desc">14 interview questions covering Security, Encryption, Backup &amp; Recovery, Replication and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Security</a></span> <span class="rm-index-sub-desc">When a compute node fails in Amazon Redshift, the data and queries on that node are automatically redistributed to other nodes in the cluster, and the failed node is replaced.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Encryption</a></span> <span class="rm-index-sub-desc">Yes, you can use AWS Key Management Service (KMS) to manage encryption keys for data-at-rest encryption in Redshift, providing an additional layer of security for your data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Backup &amp; Recovery</a></span> <span class="rm-index-sub-desc">A Redshift snapshot is a point-in-time copy of your cluster's data, while a Redshift cluster backup includes both the data and the cluster's metadata.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Replication</a></span> <span class="rm-index-sub-desc">Yes, Redshift cross-region replication allows you to replicate your cluster to a different AWS region for disaster recovery purposes, ensuring data availability in the event of a region-level failure.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">Access Control</a></span> <span class="rm-index-sub-desc">Yes, you can use IAM roles to control access to Redshift clusters, allowing you to define fine-grained permissions for managing clusters, accessing data, and executing queries.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#security-backup--compliance">AWS Integration</a></span> <span class="rm-index-sub-desc">Can you use Redshift with AWS CloudTrail for audit trail and compliance?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">AWS Ecosystem Integrations</a></h3>
        <p class="rm-index-desc">18 interview questions covering Spectrum, AWS Integration, Views, Federated Queries and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">Spectrum</a></span> <span class="rm-index-sub-desc">Redshift Spectrum is a feature that allows you to run SQL queries directly against data stored in Amazon S3, without the need to load the data into Redshift.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">AWS Integration</a></span> <span class="rm-index-sub-desc">Yes, Redshift supports industry-standard SQL, which allows you to run queries from various third-party business intelligence (BI) tools such as Tableau, Power BI, or Looker.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">Views</a></span> <span class="rm-index-sub-desc">Can you create materialized views in Amazon Redshift?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">Federated Queries</a></span> <span class="rm-index-sub-desc">Yes, Redshift Federated Query allows you to query data in other AWS data sources like Amazon RDS, Amazon Aurora, and Amazon DocumentDB using SQL.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/redshift/#aws-ecosystem-integrations">Access Control</a></span> <span class="rm-index-sub-desc">Yes, you can integrate Redshift with AWS Lake Formation to manage data lakes, define fine-grained access control policies, and govern access to data stored in Redshift and other data sources.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "redshift_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
