---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/databricks.json";
---

<StarlightPage
  frontmatter={{
    title: "Databricks Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Databricks</h1>
        <p class="rm-subtitle">Step-by-step guide to the lakehouse platform</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Lakehouse &amp; Delta Lake</a></h3>
        <p class="rm-index-desc">16 interview questions covering Fundamentals, Lakehouse, Delta Lake, Tables and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Fundamentals</a></span> <span class="rm-index-sub-desc">Databricks is a unified analytics platform that combines data warehousing, data engineering, and machine learning capabilities on top of Apache Spark, offered as a managed service across AWS, Azure, and GCP.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Lakehouse</a></span> <span class="rm-index-sub-desc">What is the Databricks Lakehouse?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Delta Lake</a></span> <span class="rm-index-sub-desc">Delta Lake is an open-source storage format that brings ACID transactions to Apache Spark, enabling reliable and efficient data storage and processing on top of Parquet files plus a transaction log.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Tables</a></span> <span class="rm-index-sub-desc">Tables can be created using SQL CREATE TABLE statements, the Python DataFrame API (df.write.saveAsTable(...)), or by reading external data sources and registering them in the metastore/Unity Catalog.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Data Formats</a></span> <span class="rm-index-sub-desc">Supported formats include Parquet, CSV, JSON, ORC, Delta Lake, and various other formats through connectors and Spark's pluggable data source API.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Storage</a></span> <span class="rm-index-sub-desc">How does Databricks integrate with cloud storage?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">Maintenance</a></span> <span class="rm-index-sub-desc">What is table optimization in Databricks? What is the VACUUM command in Delta Lake?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#lakehouse--delta-lake">CDC</a></span> <span class="rm-index-sub-desc">How do you enable change data capture in Databricks?</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Clusters, Jobs &amp; Performance</a></h3>
        <p class="rm-index-desc">16 interview questions covering Clusters, SQL Warehouses, Jobs, Integration and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Clusters</a></span> <span class="rm-index-sub-desc">A Databricks cluster is a set of computational resources and configurations on which you run data engineering, analytics, and machine learning workloads — essentially a managed Spark cluster.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">SQL Warehouses</a></span> <span class="rm-index-sub-desc">Databricks SQL is a serverless SQL analytics engine that allows you to query your data lake using standard SQL without managing clusters directly — it runs on SQL warehouses, purpose-built for BI-style query patterns.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Jobs</a></span> <span class="rm-index-sub-desc">Databricks Jobs lets you orchestrate and schedule automated workflows, including Spark jobs, notebooks, and Python scripts, running on ephemeral job clusters by default.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Integration</a></span> <span class="rm-index-sub-desc">The Databricks REST API allows you to programmatically interact with Databricks services, including cluster management, job execution, and workspace operations — the basis for most CI/CD and infrastructure-as-code integrations.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Performance</a></span> <span class="rm-index-sub-desc">Databricks Photon is a high-performance, vectorized execution engine (written in C++) that accelerates Spark SQL and DataFrame queries, reducing query latency compared to the standard JVM-based Spark execution engine.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Monitoring</a></span> <span class="rm-index-sub-desc">Job monitoring can be done through the Databricks UI (job run history, task-level logs), the REST API, cluster logging, and cloud-native monitoring integrations like CloudWatch (AWS) or Azure Monitor.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#clusters-jobs--performance">Workspace</a></span> <span class="rm-index-sub-desc">The Databricks Workspace is a collaborative environment where teams can share notebooks, collaborate on projects, browse data via the catalog, and manage clusters and jobs — the main UI surface for the platform.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Governance, Security &amp; Advanced Features</a></h3>
        <p class="rm-index-desc">12 interview questions covering Security, Unity Catalog, Data Quality, Notebooks and more.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Security</a></span> <span class="rm-index-sub-desc">Databricks provides encryption at rest and in transit, role-based access control, network security (VPC/VNet injection, private link), audit logging, and integration with cloud IAM systems for identity and credential management.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Unity Catalog</a></span> <span class="rm-index-sub-desc">Unity Catalog is a unified data governance solution that provides centralized access control, data discovery, and lineage tracking across Databricks workspaces — a single governance layer instead of per-workspace metastores.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Data Quality</a></span> <span class="rm-index-sub-desc">Data quality can be managed using Delta Lake constraints (CHECK, NOT NULL), Delta Live Tables expectations, third-party frameworks like Great Expectations, and general data profiling/validation pipelines.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Notebooks</a></span> <span class="rm-index-sub-desc">Databricks notebooks provide an interactive environment for data analysis, visualization, and collaboration, combining code, text, and visualizations in a single shareable document.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Languages</a></span> <span class="rm-index-sub-desc">Databricks supports Python, Scala, SQL, and R within the same notebook environment, allowing polyglot data engineering and analysis — including mixing languages across cells in a single notebook.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Governance</a></span> <span class="rm-index-sub-desc">How do you handle data lineage in Databricks?</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">ML</a></span> <span class="rm-index-sub-desc">The Feature Store provides centralized management of ML features, enabling version control, feature reuse across teams/models, and consistent feature engineering between training and serving.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-3-technologies/data-warehouses/databricks/#governance-security--advanced-features">Streaming</a></span> <span class="rm-index-sub-desc">Databricks supports streaming data through Structured Streaming, enabling real-time processing and continuous data pipelines that use the same DataFrame API as batch jobs.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "databricks_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
