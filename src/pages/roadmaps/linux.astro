---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/linux.json";
---

<StarlightPage
  frontmatter={{
    title: "Linux Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Linux</h1>
        <p class="rm-subtitle">Step-by-step guide to the operating system every pipeline runs on</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#filesystem--navigation">Filesystem &amp; Navigation</a></h3>
        <p class="rm-index-desc">Where things live on a Linux box, and how to find them when a job fails at 3am.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#filesystem--navigation">Directory Layout</a></span> <span class="rm-index-sub-desc">What /etc, /var, /tmp, /proc and /opt are for — and which ones fill up first.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#filesystem--navigation">Hard vs Symbolic Links</a></span> <span class="rm-index-sub-desc">Two names for one inode versus a path pointer, and why deploys use symlinks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#filesystem--navigation">Finding Files</a></span> <span class="rm-index-sub-desc">find, locate and which — walking the tree versus querying a prebuilt index.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#filesystem--navigation">Disk Usage &amp; Inodes</a></span> <span class="rm-index-sub-desc">df vs du, why they disagree, and running out of inodes rather than bytes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#filesystem--navigation">Reading Large Logs</a></span> <span class="rm-index-sub-desc">tail -f, less and zcat — inspecting a 40 GB file without loading it.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#permissions--ownership">Permissions &amp; Ownership</a></h3>
        <p class="rm-index-desc">Who can read, write and execute what — and why a shared pipeline directory needs setgid.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">Permission Bits</a></span> <span class="rm-index-sub-desc">rwx for owner, group and others — and what those bits mean on a directory.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">chmod 755 &amp; 644</a></span> <span class="rm-index-sub-desc">Numeric and symbolic modes, and why SSH refuses a group-readable key.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">chown &amp; chgrp</a></span> <span class="rm-index-sub-desc">Changing the owning user and group, and why it usually needs sudo.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">umask</a></span> <span class="rm-index-sub-desc">The bits withheld from new files, and how it breaks cross-account pipeline handoffs.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">setuid, setgid &amp; Sticky Bit</a></span> <span class="rm-index-sub-desc">Privilege escalation risk, group inheritance for shared directories, and /tmp.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#permissions--ownership">sudo</a></span> <span class="rm-index-sub-desc">Per-command privilege with an audit trail, versus a shared root login.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#processes--signals">Processes &amp; Signals</a></h3>
        <p class="rm-index-desc">Inspecting what's running, and stopping it cleanly rather than with kill -9.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">Inspecting Processes</a></span> <span class="rm-index-sub-desc">ps, top, htop and pgrep — and which columns matter when triaging.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">SIGTERM vs SIGKILL</a></span> <span class="rm-index-sub-desc">The polite request the process can handle, versus the one it cannot.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">Other Signals</a></span> <span class="rm-index-sub-desc">SIGHUP, SIGINT, SIGSTOP, SIGQUIT for JVM thread dumps, and SIGPIPE.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">Zombie Processes</a></span> <span class="rm-index-sub-desc">Why you can't kill something already dead, and why containers need an init.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">Surviving a Disconnect</a></span> <span class="rm-index-sub-desc">nohup and tmux — and why production should use a supervisor instead.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#processes--signals">nice &amp; ionice</a></span> <span class="rm-index-sub-desc">Deprioritising a backfill so it doesn't starve interactive queries.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#text-processing">Text Processing</a></h3>
        <p class="rm-index-desc">grep, awk and sed — inspecting and transforming data from the shell before you write any code.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">grep</a></span> <span class="rm-index-sub-desc">Options that matter in production, especially -A/-B/-C for stack traces.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">awk</a></span> <span class="rm-index-sub-desc">Columns plus logic — filtering, aggregating and sampling a multi-gigabyte CSV.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">sed</a></span> <span class="rm-index-sub-desc">Stream substitution, in-place edits with a backup, and printing line ranges.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">sort, uniq &amp; cut</a></span> <span class="rm-index-sub-desc">The canonical frequency-count idiom, and why uniq needs sorted input.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">Inspecting a Large CSV</a></span> <span class="rm-index-sub-desc">Row counts, column names, malformed rows and null counts from the shell.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#text-processing">Pipes &amp; Redirection</a></span> <span class="rm-index-sub-desc">stdin/stdout/stderr, and why the order of &gt; out.txt 2&gt;&amp;1 matters.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#shell-scripting">Shell Scripting</a></h3>
        <p class="rm-index-desc">Writing scripts that fail loudly, clean up after themselves, and are safe to schedule.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">Shebang</a></span> <span class="rm-index-sub-desc">Choosing the interpreter, and why /usr/bin/env python3 respects a virtualenv.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">set -euo pipefail</a></span> <span class="rm-index-sub-desc">The four-word line that turns silent failure into a visible one.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">Quoting Variables</a></span> <span class="rm-index-sub-desc">Word splitting and glob expansion — the bug class ShellCheck exists to catch.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">Exit Codes</a></span> <span class="rm-index-sub-desc">How schedulers decide success, and why exiting 0 after an error hides breakage.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">trap &amp; Cleanup</a></span> <span class="rm-index-sub-desc">Removing temp files on exit, error or SIGTERM — however the script ends.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#shell-scripting">flock &amp; Concurrency</a></span> <span class="rm-index-sub-desc">Stopping an overrunning cron job from overlapping itself and duplicating output.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#cron--scheduling">Cron &amp; Scheduling</a></h3>
        <p class="rm-index-desc">Time-based scheduling on a single host, its limits, and when to move to a real orchestrator.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#cron--scheduling">Cron Syntax</a></span> <span class="rm-index-sub-desc">The five fields, common expressions, and the day-of-month/day-of-week trap.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#cron--scheduling">The Cron Environment Problem</a></span> <span class="rm-index-sub-desc">Why a script that works in your shell fails under cron — and how to fix it.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#cron--scheduling">Managing Crontabs</a></span> <span class="rm-index-sub-desc">crontab -l/-e, system-wide cron directories, and where the logs are.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#cron--scheduling">Cron's Limits for Pipelines</a></span> <span class="rm-index-sub-desc">No dependencies, retries, backfills, alerting or visibility — hence Airflow.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#cron--scheduling">systemd Timers</a></span> <span class="rm-index-sub-desc">Journald logging, Persistent=true for missed runs, and resource limits.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/linux/#troubleshooting--performance">Troubleshooting &amp; Performance</a></h3>
        <p class="rm-index-desc">Diagnosing a slow or broken box — CPU, memory, disk and the process that's stuck.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">Diagnosing a Slow Server</a></span> <span class="rm-index-sub-desc">Working through load, memory, disk and network in a repeatable order.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">Load Average</a></span> <span class="rm-index-sub-desc">Reading the three numbers against core count, and why I/O wait counts on Linux.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">Reading free -h</a></span> <span class="rm-index-sub-desc">Why 'free' is misleadingly small, what 'available' means, and when swap matters.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">The OOM Killer</a></span> <span class="rm-index-sub-desc">A job killed with no error in its logs, and how to confirm it from dmesg.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">lsof &amp; ss</a></span> <span class="rm-index-sub-desc">Finding what holds a port, a deleted file, or a busy mount point.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/linux/#troubleshooting--performance">Finding a Stuck Process</a></span> <span class="rm-index-sub-desc">strace, jstack and py-spy — locating where a hung job is actually blocked.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "linux_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
