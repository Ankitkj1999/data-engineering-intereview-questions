---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Linux Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Linux</h1>
        <p class="rm-subtitle">Step-by-step guide to the operating system every pipeline runs on</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"lnx-filesystem", label:"Filesystem & Navigation", desc:"Where things live on a Linux box, and how to find them when a job fails at 3am.", link:"/level-1-foundations/linux/#filesystem--navigation", subs:[
    { id:"lnx-fhs", label:"Directory Layout", desc:"What /etc, /var, /tmp, /proc and /opt are for — and which ones fill up first.", link:"/level-1-foundations/linux/#filesystem--navigation" },
    { id:"lnx-links", label:"Hard vs Symbolic Links", desc:"Two names for one inode versus a path pointer, and why deploys use symlinks.", link:"/level-1-foundations/linux/#filesystem--navigation" },
    { id:"lnx-find", label:"Finding Files", desc:"find, locate and which — walking the tree versus querying a prebuilt index.", link:"/level-1-foundations/linux/#filesystem--navigation" },
    { id:"lnx-disk", label:"Disk Usage & Inodes", desc:"df vs du, why they disagree, and running out of inodes rather than bytes.", link:"/level-1-foundations/linux/#filesystem--navigation" },
    { id:"lnx-logs", label:"Reading Large Logs", desc:"tail -f, less and zcat — inspecting a 40 GB file without loading it.", link:"/level-1-foundations/linux/#filesystem--navigation" },
  ]},
  { id:"lnx-permissions", label:"Permissions & Ownership", desc:"Who can read, write and execute what — and why a shared pipeline directory needs setgid.", link:"/level-1-foundations/linux/#permissions--ownership", subs:[
    { id:"lnx-bits", label:"Permission Bits", desc:"rwx for owner, group and others — and what those bits mean on a directory.", link:"/level-1-foundations/linux/#permissions--ownership" },
    { id:"lnx-chmod", label:"chmod 755 & 644", desc:"Numeric and symbolic modes, and why SSH refuses a group-readable key.", link:"/level-1-foundations/linux/#permissions--ownership" },
    { id:"lnx-chown", label:"chown & chgrp", desc:"Changing the owning user and group, and why it usually needs sudo.", link:"/level-1-foundations/linux/#permissions--ownership" },
    { id:"lnx-umask", label:"umask", desc:"The bits withheld from new files, and how it breaks cross-account pipeline handoffs.", link:"/level-1-foundations/linux/#permissions--ownership" },
    { id:"lnx-special-bits", label:"setuid, setgid & Sticky Bit", desc:"Privilege escalation risk, group inheritance for shared directories, and /tmp.", link:"/level-1-foundations/linux/#permissions--ownership" },
    { id:"lnx-sudo", label:"sudo", desc:"Per-command privilege with an audit trail, versus a shared root login.", link:"/level-1-foundations/linux/#permissions--ownership" },
  ]},
  { id:"lnx-processes", label:"Processes & Signals", desc:"Inspecting what's running, and stopping it cleanly rather than with kill -9.", link:"/level-1-foundations/linux/#processes--signals", subs:[
    { id:"lnx-ps", label:"Inspecting Processes", desc:"ps, top, htop and pgrep — and which columns matter when triaging.", link:"/level-1-foundations/linux/#processes--signals" },
    { id:"lnx-signals-term", label:"SIGTERM vs SIGKILL", desc:"The polite request the process can handle, versus the one it cannot.", link:"/level-1-foundations/linux/#processes--signals" },
    { id:"lnx-signals-other", label:"Other Signals", desc:"SIGHUP, SIGINT, SIGSTOP, SIGQUIT for JVM thread dumps, and SIGPIPE.", link:"/level-1-foundations/linux/#processes--signals" },
    { id:"lnx-zombie", label:"Zombie Processes", desc:"Why you can't kill something already dead, and why containers need an init.", link:"/level-1-foundations/linux/#processes--signals" },
    { id:"lnx-nohup", label:"Surviving a Disconnect", desc:"nohup and tmux — and why production should use a supervisor instead.", link:"/level-1-foundations/linux/#processes--signals" },
    { id:"lnx-nice", label:"nice & ionice", desc:"Deprioritising a backfill so it doesn't starve interactive queries.", link:"/level-1-foundations/linux/#processes--signals" },
  ]},
  { id:"lnx-text", label:"Text Processing", desc:"grep, awk and sed — inspecting and transforming data from the shell before you write any code.", link:"/level-1-foundations/linux/#text-processing", subs:[
    { id:"lnx-grep", label:"grep", desc:"Options that matter in production, especially -A/-B/-C for stack traces.", link:"/level-1-foundations/linux/#text-processing" },
    { id:"lnx-awk", label:"awk", desc:"Columns plus logic — filtering, aggregating and sampling a multi-gigabyte CSV.", link:"/level-1-foundations/linux/#text-processing" },
    { id:"lnx-sed", label:"sed", desc:"Stream substitution, in-place edits with a backup, and printing line ranges.", link:"/level-1-foundations/linux/#text-processing" },
    { id:"lnx-sort-uniq", label:"sort, uniq & cut", desc:"The canonical frequency-count idiom, and why uniq needs sorted input.", link:"/level-1-foundations/linux/#text-processing" },
    { id:"lnx-csv", label:"Inspecting a Large CSV", desc:"Row counts, column names, malformed rows and null counts from the shell.", link:"/level-1-foundations/linux/#text-processing" },
    { id:"lnx-redirection", label:"Pipes & Redirection", desc:"stdin/stdout/stderr, and why the order of > out.txt 2>&1 matters.", link:"/level-1-foundations/linux/#text-processing" },
  ]},
  { id:"lnx-shell", label:"Shell Scripting", desc:"Writing scripts that fail loudly, clean up after themselves, and are safe to schedule.", link:"/level-1-foundations/linux/#shell-scripting", subs:[
    { id:"lnx-shebang", label:"Shebang", desc:"Choosing the interpreter, and why /usr/bin/env python3 respects a virtualenv.", link:"/level-1-foundations/linux/#shell-scripting" },
    { id:"lnx-strict", label:"set -euo pipefail", desc:"The four-word line that turns silent failure into a visible one.", link:"/level-1-foundations/linux/#shell-scripting" },
    { id:"lnx-quoting", label:"Quoting Variables", desc:"Word splitting and glob expansion — the bug class ShellCheck exists to catch.", link:"/level-1-foundations/linux/#shell-scripting" },
    { id:"lnx-exit-codes", label:"Exit Codes", desc:"How schedulers decide success, and why exiting 0 after an error hides breakage.", link:"/level-1-foundations/linux/#shell-scripting" },
    { id:"lnx-trap", label:"trap & Cleanup", desc:"Removing temp files on exit, error or SIGTERM — however the script ends.", link:"/level-1-foundations/linux/#shell-scripting" },
    { id:"lnx-flock", label:"flock & Concurrency", desc:"Stopping an overrunning cron job from overlapping itself and duplicating output.", link:"/level-1-foundations/linux/#shell-scripting" },
  ]},
  { id:"lnx-cron", label:"Cron & Scheduling", desc:"Time-based scheduling on a single host, its limits, and when to move to a real orchestrator.", link:"/level-1-foundations/linux/#cron--scheduling", subs:[
    { id:"lnx-cron-syntax", label:"Cron Syntax", desc:"The five fields, common expressions, and the day-of-month/day-of-week trap.", link:"/level-1-foundations/linux/#cron--scheduling" },
    { id:"lnx-cron-env", label:"The Cron Environment Problem", desc:"Why a script that works in your shell fails under cron — and how to fix it.", link:"/level-1-foundations/linux/#cron--scheduling" },
    { id:"lnx-crontab", label:"Managing Crontabs", desc:"crontab -l/-e, system-wide cron directories, and where the logs are.", link:"/level-1-foundations/linux/#cron--scheduling" },
    { id:"lnx-cron-limits", label:"Cron's Limits for Pipelines", desc:"No dependencies, retries, backfills, alerting or visibility — hence Airflow.", link:"/level-1-foundations/linux/#cron--scheduling" },
    { id:"lnx-systemd", label:"systemd Timers", desc:"Journald logging, Persistent=true for missed runs, and resource limits.", link:"/level-1-foundations/linux/#cron--scheduling" },
  ]},
  { id:"lnx-diag", label:"Troubleshooting & Performance", desc:"Diagnosing a slow or broken box — CPU, memory, disk and the process that's stuck.", link:"/level-1-foundations/linux/#troubleshooting--performance", subs:[
    { id:"lnx-slow-server", label:"Diagnosing a Slow Server", desc:"Working through load, memory, disk and network in a repeatable order.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
    { id:"lnx-load", label:"Load Average", desc:"Reading the three numbers against core count, and why I/O wait counts on Linux.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
    { id:"lnx-memory", label:"Reading free -h", desc:"Why 'free' is misleadingly small, what 'available' means, and when swap matters.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
    { id:"lnx-oom", label:"The OOM Killer", desc:"A job killed with no error in its logs, and how to confirm it from dmesg.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
    { id:"lnx-lsof", label:"lsof & ss", desc:"Finding what holds a port, a deleted file, or a busy mount point.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
    { id:"lnx-stuck", label:"Finding a Stuck Process", desc:"strace, jstack and py-spy — locating where a hung job is actually blocked.", link:"/level-1-foundations/linux/#troubleshooting--performance" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "linux_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
