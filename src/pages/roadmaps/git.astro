---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/git.json";
---

<StarlightPage
  frontmatter={{
    title: "Git & GitHub Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Git &amp; GitHub</h1>
        <p class="rm-subtitle">Step-by-step guide to version control for data engineering</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#git-fundamentals">Git Fundamentals</a></h3>
        <p class="rm-index-desc">How Git actually stores history — the object model, the three areas, and what a branch really is.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">Distributed vs Centralised VCS</a></span> <span class="rm-index-sub-desc">Why every clone holds the full history, and what that buys you over SVN-style tools.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">Working Directory, Staging, Repository</a></span> <span class="rm-index-sub-desc">The three places your work lives, and why the staging area lets you commit part of it.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">The Object Model</a></span> <span class="rm-index-sub-desc">Blobs, trees, commits and tags — content-addressed storage under the version control interface.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">Snapshots vs Diffs</a></span> <span class="rm-index-sub-desc">Git stores full snapshots with shared blobs; diffs are computed on demand.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">Branches as Pointers</a></span> <span class="rm-index-sub-desc">A branch is a file containing a commit hash — which is why branching is instant.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">HEAD &amp; Detached HEAD</a></span> <span class="rm-index-sub-desc">Where you currently are, and what happens when you check out a commit instead of a branch.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">fetch vs pull</a></span> <span class="rm-index-sub-desc">Fetch updates remote-tracking branches safely; pull also integrates and can conflict.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">switch, checkout &amp; restore</a></span> <span class="rm-index-sub-desc">The modern split of checkout's two unrelated jobs into switch and restore.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-fundamentals">.gitignore</a></span> <span class="rm-index-sub-desc">Ignoring untracked files, and why it has no effect on something already committed.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#branching--merging">Branching &amp; Merging</a></h3>
        <p class="rm-index-desc">Combining work from multiple branches, resolving conflicts, and choosing a team workflow.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Fast-Forward Merge</a></span> <span class="rm-index-sub-desc">When history is a straight line and Git just moves the pointer forward.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Three-Way Merge</a></span> <span class="rm-index-sub-desc">Merge base, your tip and theirs — how Git decides what conflicts.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Resolving Merge Conflicts</a></span> <span class="rm-index-sub-desc">Reading conflict markers, resolving deliberately, and re-running the tests.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Branching Strategies</a></span> <span class="rm-index-sub-desc">Git Flow vs GitHub Flow vs trunk-based development, and which suits data pipelines.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Cherry-Pick</a></span> <span class="rm-index-sub-desc">Applying a single commit elsewhere — legitimate for hotfixes, an anti-pattern as routine.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Merge vs Squash vs Rebase Merge</a></span> <span class="rm-index-sub-desc">Three ways to land a pull request, and the history each one leaves behind.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#branching--merging">Finding Bugs with git bisect</a></span> <span class="rm-index-sub-desc">Binary search over history to find the commit that introduced a regression.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#rewriting-history">Rewriting History</a></h3>
        <p class="rm-index-desc">Rebasing, amending and force-pushing — powerful, and the fastest way to ruin a colleague's afternoon.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">git rebase</a></span> <span class="rm-index-sub-desc">Replaying commits onto a new base to produce linear history — with new hashes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">The Golden Rule of Rebasing</a></span> <span class="rm-index-sub-desc">Never rebase commits others have already pulled, and why it breaks their history.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">Interactive Rebase</a></span> <span class="rm-index-sub-desc">Squash, reword, reorder and drop commits before opening a pull request.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">commit --amend</a></span> <span class="rm-index-sub-desc">Replacing the last commit — safe locally, a force-push problem once pushed.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">force-with-lease</a></span> <span class="rm-index-sub-desc">The safe force-push that refuses when someone else has pushed in the meantime.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#rewriting-history">Removing Leaked Secrets</a></span> <span class="rm-index-sub-desc">Rotate first, then purge with filter-repo — why rewriting history alone is not enough.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#remotes--collaboration">Remotes &amp; Collaboration</a></h3>
        <p class="rm-index-desc">Pull requests, forks, remote-tracking branches and the guardrails that keep main safe.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">Pull Requests</a></span> <span class="rm-index-sub-desc">A host feature, not a Git one — the gate where review and CI attach to the workflow.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">What Makes a Good PR</a></span> <span class="rm-index-sub-desc">Small, single-purpose, explains why, green CI — and what to include for data changes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">Fork vs Branch</a></span> <span class="rm-index-sub-desc">The open-source contribution model versus the normal in-team model.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">Remote-Tracking Branches</a></span> <span class="rm-index-sub-desc">What origin/main actually is, and how it powers Git's offline story.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">Protected Branches</a></span> <span class="rm-index-sub-desc">Required reviews, status checks and force-push blocks — quality and audit control.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#remotes--collaboration">Submodules</a></span> <span class="rm-index-sub-desc">Pinning one repo inside another, the pain it causes, and better alternatives.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#undoing-mistakes">Undoing Mistakes</a></h3>
        <p class="rm-index-desc">Reset, revert, stash and the reflog — how to get out of trouble without losing work.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#undoing-mistakes">reset --soft, --mixed, --hard</a></span> <span class="rm-index-sub-desc">Three levels of undo, and which one actually destroys uncommitted work.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#undoing-mistakes">revert vs reset</a></span> <span class="rm-index-sub-desc">Revert for public history, reset for private — the rule that avoids breaking teammates.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#undoing-mistakes">The Reflog</a></span> <span class="rm-index-sub-desc">Every HEAD movement recorded locally — the undo button for a destructive reset or rebase.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#undoing-mistakes">git stash</a></span> <span class="rm-index-sub-desc">Setting work aside temporarily, and the untracked-files gotcha.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#undoing-mistakes">Moving Commits Between Branches</a></span> <span class="rm-index-sub-desc">Committed to main by mistake — creating a branch there and rewinding.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/git/#git-for-data-engineering">Git for Data Engineering</a></h3>
        <p class="rm-index-desc">The version control problems specific to pipelines: large files, notebooks, secrets and repo structure.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">Large Data Files</a></span> <span class="rm-index-sub-desc">Why data doesn't belong in Git, and what LFS, DVC and lakeFS do instead.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">Secrets &amp; Environment Config</a></span> <span class="rm-index-sub-desc">gitignored .env files, secrets managers, workload identity and pre-commit scanning.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">Notebooks in Version Control</a></span> <span class="rm-index-sub-desc">Why .ipynb diffs are unreadable, and how nbstripout and jupytext fix it.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">dbt &amp; SQL Workflows</a></span> <span class="rm-index-sub-desc">Transformations as reviewed code, with CI schemas and traceable metric changes.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">CI Checks for Data Repos</a></span> <span class="rm-index-sub-desc">DAG parsing, data quality tests, schema-change detection and secret scanning.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/git/#git-for-data-engineering">Monorepo vs Polyrepo</a></span> <span class="rm-index-sub-desc">Structuring multiple pipelines and shared libraries, and the trade-off each way.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "git_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
