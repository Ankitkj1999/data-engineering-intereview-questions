---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Change Data Capture Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Change Data Capture</h1>
        <p class="rm-subtitle">Step-by-step guide to capturing database changes</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"core-concepts", label:"Core Concepts", desc:"15 interview questions covering Fundamentals, Sources, Snapshotting, Semantics and more.", link:"/level-3-technologies/ingestion/cdc/#interview-questions", subs:[
    { id:"core-concepts-fundamentals", label:"Fundamentals", desc:"CDC is a technique to capture row-level changes (inserts, updates, deletes) from a source system and stream them downstream.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-sources", label:"Sources", desc:"Common sources are: - Database logs (WAL/binlog) — low overhead and high fidelity, but requires elevated privileges and careful offset handling - Triggers —…", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-snapshotting", label:"Snapshotting", desc:"A snapshot reads an initial consistent baseline of existing rows.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-semantics", label:"Semantics", desc:"At-most-once can lose messages but avoids duplicates.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-idempotency", label:"Idempotency", desc:"You make downstream writes idempotent by using stable keys (primary key + source LSN/transaction id) and applying deterministic upsert/merge logic.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-deletes", label:"Deletes", desc:"Deletes may appear as explicit delete events, tombstones, or a \"before image\" without an \"after image.\" Downstream you can: - apply hard deletes (remove the…", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-updates", label:"Updates", desc:"If updates are partial (only changed columns), you often need to reconstruct the full row by joining against previous state.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-ordering", label:"Ordering", desc:"Ordering means applying changes in the same order they happened in the source.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-offsets", label:"Offsets", desc:"An offset (watermark) is the position in the source log (or stream) up to which changes have been processed.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-schema-evolution", label:"Schema Evolution", desc:"You need a strategy for compatible changes (additive columns) and breaking changes (renames, type changes).", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-patterns", label:"Patterns", desc:"The outbox pattern writes business events into an \"outbox\" table in the same transaction as the application write.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-monitoring", label:"Monitoring", desc:"Lag can come from several layers: - source — heavy write load, log retention limits - connector — slow polling, backpressure, failures - broker/stream —…", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-backfill", label:"Backfill", desc:"A safe strategy usually separates raw change storage from derived tables.", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
    { id:"core-concepts-reliability", label:"Reliability", desc:"Common issues include: - duplicates due to retries/rebalances - missed events due to offset mismanagement or log retention - schema drift/breaking changes -…", link:"/level-3-technologies/ingestion/cdc/#interview-questions" },
  ]},
  { id:"cdc-tools-in-practice", label:"CDC Tools in Practice", desc:"5 interview questions covering Tooling, Snapshotting, Reliability, Schema Evolution.", link:"/level-3-technologies/ingestion/cdc/#cdc-tools-in-practice", subs:[
    { id:"cdc-tools-in-practice-tooling", label:"Tooling", desc:"Debezium is the most widely-used open-source CDC tool — it ships as a set of Kafka Connect source connectors, one per database engine (Postgres, MySQL,…", link:"/level-3-technologies/ingestion/cdc/#cdc-tools-in-practice" },
    { id:"cdc-tools-in-practice-snapshotting", label:"Snapshotting", desc:"Older snapshot modes held a lock (at least briefly) to establish a consistent starting point before streaming incremental changes.", link:"/level-3-technologies/ingestion/cdc/#cdc-tools-in-practice" },
    { id:"cdc-tools-in-practice-reliability", label:"Reliability", desc:"A heartbeat is a synthetic, periodic write the connector makes (or asks to be made) purely so its position in the log keeps advancing even when the actual…", link:"/level-3-technologies/ingestion/cdc/#cdc-tools-in-practice" },
    { id:"cdc-tools-in-practice-schema-evolution", label:"Schema Evolution", desc:"Log-based CDC tools typically parse DDL statements from the log alongside row changes and can emit schema-change events (often to a separate schema history…", link:"/level-3-technologies/ingestion/cdc/#cdc-tools-in-practice" },
  ]},
  { id:"cdc-beyond-relational-databases", label:"CDC Beyond Relational Databases", desc:"3 interview questions covering NoSQL CDC.", link:"/level-3-technologies/ingestion/cdc/#cdc-beyond-relational-databases", subs:[
    { id:"cdc-beyond-relational-databases-nosql-cdc", label:"NoSQL CDC", desc:"MongoDB's change streams API lets an application subscribe directly to insert/update/delete/replace events on a collection, backed internally by MongoDB's own…", link:"/level-3-technologies/ingestion/cdc/#cdc-beyond-relational-databases" },
  ]},
  { id:"operational-patterns-trade-offs", label:"Operational Patterns & Trade-offs", desc:"4 interview questions covering Consistency, Reliability, Compaction, Trade-offs.", link:"/level-3-technologies/ingestion/cdc/#operational-patterns--trade-offs", subs:[
    { id:"operational-patterns-trade-offs-consistency", label:"Consistency", desc:"Log-based CDC preserves the source's original commit order across tables (since it reads one linear transaction log), so as long as downstream processing…", link:"/level-3-technologies/ingestion/cdc/#operational-patterns--trade-offs" },
    { id:"operational-patterns-trade-offs-reliability", label:"Reliability", desc:"Run the connector on a framework that supports distributed, fault-tolerant execution (Kafka Connect in distributed mode) so a worker failing gets its tasks…", link:"/level-3-technologies/ingestion/cdc/#operational-patterns--trade-offs" },
    { id:"operational-patterns-trade-offs-compaction", label:"Compaction", desc:"Rather than applying every single event as an individual write (expensive at high change volume), batch events by primary key over a short window and keep only…", link:"/level-3-technologies/ingestion/cdc/#operational-patterns--trade-offs" },
    { id:"operational-patterns-trade-offs-trade-offs", label:"Trade-offs", desc:"Reach for CDC when freshness genuinely matters (minutes, not hours), the source is too large or too write-heavy for repeated full/incremental batch scans to be…", link:"/level-3-technologies/ingestion/cdc/#operational-patterns--trade-offs" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "cdc_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
