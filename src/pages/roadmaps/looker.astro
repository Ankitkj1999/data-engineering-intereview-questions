---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Looker Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">Looker</h1>
        <p class="rm-subtitle">Step-by-step guide to LookML and the semantic layer</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = [
  { id:"fundamentals-core-concepts", label:"Fundamentals & Core Concepts", desc:"16 interview questions covering Fundamentals, LookML, Explores, Dashboards and more.", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts", subs:[
    { id:"fundamentals-core-concepts-fundamentals", label:"Fundamentals", desc:"Looker is a business intelligence (BI) and data visualization platform that lets users explore, analyze, and share data insights, built around a modeling layer (LookML) rather than its own data engine.", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts" },
    { id:"fundamentals-core-concepts-lookml", label:"LookML", desc:"LookML's flexibility handles complex data structures by letting you explicitly define relationships, joins, and transformations across files — so even deeply nested or multi-table structures can be modeled as a coherent set of Explores.", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts" },
    { id:"fundamentals-core-concepts-explores", label:"Explores", desc:"A Looker Explore is the interface that lets users interactively explore and analyze data through a graphical, point-and-click UI, built on top of the relationships and fields defined in LookML.", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts" },
    { id:"fundamentals-core-concepts-dashboards", label:"Dashboards", desc:"A Looker dashboard is a customizable collection of visualizations and reports that gives a consolidated view of key metrics and data insights, typically built from one or more Explores.", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts" },
    { id:"fundamentals-core-concepts-ecosystem", label:"Ecosystem", desc:"Can Looker be integrated with other BI tools or data visualization platforms?", link:"/level-3-technologies/bi/looker/#fundamentals--core-concepts" },
  ]},
  { id:"lookml-pdts-development-workflow", label:"LookML, PDTs & Development Workflow", desc:"13 interview questions covering PDTs, LookML, Administration, Visualization and more.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow", subs:[
    { id:"lookml-pdts-development-workflow-pdts", label:"PDTs", desc:"PDTs are precomputed tables that Looker builds back into the connected database to improve query performance.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-lookml", label:"LookML", desc:"What is the purpose of Looker's Liquid syntax in LookML?", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-administration", label:"Administration", desc:"Development Mode lets developers change LookML models without affecting the production environment, giving them a safe space to test changes before deploying them live.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-visualization", label:"Visualization", desc:"Looker supports custom visualizations built with custom JavaScript or HTML — you can build your own from scratch or adapt third-party visualization libraries for cases the built-in chart types don't cover.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-sql-runner", label:"SQL Runner", desc:"SQL Runner provides a SQL interface directly inside Looker, letting users write and execute custom SQL queries against connected data sources without going through LookML or an Explore.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-explores", label:"Explores", desc:"Dynamic time frame filters let users select relative, time-based periods — such as \"last month\" or \"last year\" — that are evaluated dynamically based on the current date, rather than a fixed date range.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-version-control", label:"Version Control", desc:"Looker integrates with Git (or other version control systems) so LookML models can be version-controlled like any other codebase.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-api", label:"API", desc:"The Explore API lets developers programmatically query and retrieve data from Looker Explores, enabling integration with external applications that need Looker-modeled data without going through the UI.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
    { id:"lookml-pdts-development-workflow-embedding", label:"Embedding", desc:"Explore Embed lets developers embed Looker's Explore functionality directly into external applications, giving end users a full data-exploration experience inside a product they're already using rather than a separate Looker login.", link:"/level-3-technologies/bi/looker/#lookml-pdts--development-workflow" },
  ]},
  { id:"performance-scale-data-integration", label:"Performance, Scale & Data Integration", desc:"21 interview questions covering Performance, Scalability, Data Integration, Real-Time and more.", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration", subs:[
    { id:"performance-scale-data-integration-performance", label:"Performance", desc:"Looker intelligently caches query results to improve performance, and the caching strategy can be customized based on how frequently and how much the underlying data actually changes.", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
    { id:"performance-scale-data-integration-scalability", label:"Scalability", desc:"Yes — Looker is designed to handle large-scale data processing by leveraging the computing power and scalability of the modern data warehouse or database it's connected to, rather than processing data itself.", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
    { id:"performance-scale-data-integration-data-integration", label:"Data Integration", desc:"Looker relies on the underlying data infrastructure to handle incremental data loads — proper configuration and modeling on the warehouse side is required to support incremental updates cleanly.", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
    { id:"performance-scale-data-integration-real-time", label:"Real-Time", desc:"Looker is primarily designed for batch data processing, so it may not be well suited to strictly real-time dashboards.", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
    { id:"performance-scale-data-integration-etl", label:"ETL", desc:"Can Looker be used for data transformation and ETL processes? How can Looker integrate with data orchestration tools like Apache Airflow?", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
    { id:"performance-scale-data-integration-data-quality", label:"Data Quality", desc:"How does Looker handle data quality and cleansing?", link:"/level-3-technologies/bi/looker/#performance-scale--data-integration" },
  ]},
  { id:"governance-security-access-control", label:"Governance, Security & Access Control", desc:"13 interview questions covering Security, Compliance, Governance, Access Control and more.", link:"/level-3-technologies/bi/looker/#governance-security--access-control", subs:[
    { id:"governance-security-access-control-security", label:"Security", desc:"Looker offers user access controls, data encryption, and integration with identity providers for authentication and authorization — layering its own permission model on top of whatever security the underlying warehouse already provides.", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
    { id:"governance-security-access-control-compliance", label:"Compliance", desc:"Looker provides data encryption, access controls, and features supporting compliance with regulations like GDPR and HIPAA, helping organizations meet industry-specific privacy requirements.", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
    { id:"governance-security-access-control-governance", label:"Governance", desc:"Looker can integrate with external data governance tools through custom scripts, APIs, or data connectors, to enforce governance policies and support compliance beyond what Looker's own controls cover.", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
    { id:"governance-security-access-control-access-control", label:"Access Control", desc:"Looker's data permissions and access controls let administrators control which users or groups can access specific data sources, tables, or fields within Looker, down to a fairly granular level.", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
    { id:"governance-security-access-control-authentication", label:"Authentication", desc:"Yes — Looker can integrate with external authentication providers such as LDAP, SAML, or OAuth to enable single sign-on (SSO) and centralized user management.", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
    { id:"governance-security-access-control-deployment", label:"Deployment", desc:"Can Looker be deployed on-premises or is it only available as a cloud-based solution?", link:"/level-3-technologies/bi/looker/#governance-security--access-control" },
  ]},
  { id:"lineage-collaboration-platform-administration", label:"Lineage, Collaboration & Platform Administration", desc:"17 interview questions covering Lineage, Administration, Collaboration, Data Actions and more.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration", subs:[
    { id:"lineage-collaboration-platform-administration-lineage", label:"Lineage", desc:"Looker lets you document the logic and definitions of your data models directly in LookML, and provides options to track data lineage and maintain documentation within the platform itself.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-administration", label:"Administration", desc:"Content validation lets users validate the accuracy of data displayed across dashboards, reports, and visualizations — catching broken references (like a renamed field) before they silently break a report.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-collaboration", label:"Collaboration", desc:"Looker provides features for sharing, commenting, and collaborating on reports, dashboards, and data models, and integrates with communication tools like Slack and email to keep teams in the loop.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-data-actions", label:"Data Actions", desc:"Data Actions let users take action directly from their data — updating records, creating tasks, or triggering external processes — without leaving the Looker interface.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-alerting", label:"Alerting", desc:"Yes — Looker can generate alerts or notifications based on predefined conditions through its scheduling and alerting features, so users are proactively notified when a metric crosses a threshold.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-visualization", label:"Visualization", desc:"Yes — Looker supports geospatial data analysis through visualization options including maps and geographic charts.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-fundamentals", label:"Fundamentals", desc:"Can Looker handle data anomaly detection?", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
    { id:"lineage-collaboration-platform-administration-governance", label:"Governance", desc:"Yes — Looker can integrate with data cataloging tools through APIs or connectors, enabling data discovery and cataloging across the organization alongside whatever catalog system is already in use.", link:"/level-3-technologies/bi/looker/#lineage-collaboration--platform-administration" },
  ]},
];

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "looker_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
