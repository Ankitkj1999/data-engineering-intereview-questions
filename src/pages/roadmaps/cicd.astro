---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ROADMAP_DATA from "../../data/roadmaps/cicd.json";
---

<StarlightPage
  frontmatter={{
    title: "CI/CD Roadmap",
    description: "",
  
  }}
>
  <div id="rm-root">
    <div class="rm-header">
      <div class="rm-header-left">
        <span class="rm-badge">Roadmap</span>
        <h1 class="rm-title">CI/CD</h1>
        <p class="rm-subtitle">Step-by-step guide to shipping pipeline changes safely</p>
      </div>
      <div class="rm-header-right">
        <div class="rm-legend">
          <span class="rm-legend-item" data-status="pending"><span class="rm-dot"></span>Pending</span>
          <span class="rm-legend-item" data-status="inprogress"><span class="rm-dot"></span>In Progress</span>
          <span class="rm-legend-item" data-status="done"><span class="rm-dot"></span>Done</span>
        </div>
        <div class="rm-progress-summary">
          <span class="rm-prog-label">Progress</span>
          <div class="rm-prog-bar-wrap"><div class="rm-prog-bar" id="rm-prog-bar"></div></div>
          <span class="rm-prog-pct" id="rm-prog-pct">0%</span>
        </div>
      </div>
    </div>
    <div class="rm-flow" id="rm-flow"></div>
    <div class="rm-drawer" id="rm-drawer">
      <div class="rm-backdrop" id="rm-backdrop"></div>
      <div class="rm-panel">
        <div class="rm-panel-header">
          <div>
            <span id="rm-panel-badge" class="rm-panel-badge"></span>
            <h2 id="rm-panel-title" class="rm-panel-title"></h2>
          </div>
          <button id="rm-panel-close" class="rm-panel-close" aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        </div>
        <div class="rm-panel-status-row">
          <span class="rm-panel-status-label">Status</span>
          <div class="rm-status-select-wrap">
            <span class="rm-status-dot" id="rm-status-dot"></span>
            <select class="rm-status-select" id="rm-status-select" aria-label="Set status">
              <option value="pending">⬜ Pending</option>
              <option value="inprogress">🟡 In Progress</option>
              <option value="done">✅ Done</option>
            </select>
          </div>
        </div>
        <div class="rm-panel-body" id="rm-panel-body"></div>
      </div>
    </div>
  </div>

  <section class="rm-index" aria-label="All topics on this roadmap">
    <h2 class="rm-index-title">All topics</h2>
    <p class="rm-index-lede">Every node on the roadmap above, as text. Each links to the page section that covers it.</p>
    <ul class="rm-index-list">
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/cicd/#cicd-fundamentals">CI/CD Fundamentals</a></h3>
        <p class="rm-index-desc">The vocabulary and the practices — what CI actually buys you, and what makes a pipeline trusted.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">CI vs Delivery vs Deployment</a></span> <span class="rm-index-sub-desc">The two CDs, and the human approval gate that separates them.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">CI Pipeline Stages</a></span> <span class="rm-index-sub-desc">Checkout through publish, ordered fastest-and-most-likely-to-fail first.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">What Makes a Good Pipeline</a></span> <span class="rm-index-sub-desc">Fast, reliable, deterministic, isolated — and why flakiness kills trust.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">Secrets Management</a></span> <span class="rm-index-sub-desc">Scoped encrypted stores, log masking, and short-lived credentials via OIDC.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">Deployment Strategies</a></span> <span class="rm-index-sub-desc">Recreate, rolling, blue-green, canary and feature flags — plus the data analogue.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">Build Once &amp; Promote</a></span> <span class="rm-index-sub-desc">Why rebuilding per environment loses the guarantee that you tested what you shipped.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-fundamentals">Flaky Tests</a></span> <span class="rm-index-sub-desc">Common causes, and why quarantining beats an automatic retry.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/cicd/#github-actions">GitHub Actions</a></h3>
        <p class="rm-index-desc">Workflows, jobs and steps — triggers, caching, runners, environments and matrix builds.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Workflow Structure</a></span> <span class="rm-index-sub-desc">workflow to jobs to steps, parallel by default, with needs and artifacts to connect them.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Triggers &amp; Events</a></span> <span class="rm-index-sub-desc">push, pull_request, schedule, workflow_dispatch — plus path filters for monorepos.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Speeding Up Workflows</a></span> <span class="rm-index-sub-desc">Dependency and layer caching, matrices, path filters and concurrency groups.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Hosted vs Self-Hosted Runners</a></span> <span class="rm-index-sub-desc">When you need VPC access or big machines — and why never on a public repo.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Secrets, Environments &amp; OIDC</a></span> <span class="rm-index-sub-desc">Environment gates, required approvals, and assuming a cloud role without stored keys.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#github-actions">Matrix Strategy</a></span> <span class="rm-index-sub-desc">Testing across Python and Spark versions, and why fail-fast: false is usually right.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/cicd/#gitlab-ci">GitLab CI</a></h3>
        <p class="rm-index-desc">Stages and jobs in .gitlab-ci.yml, with runners, caching and conditional execution.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#gitlab-ci">.gitlab-ci.yml Structure</a></span> <span class="rm-index-sub-desc">Stages run in order, jobs within a stage in parallel, each in its own image.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#gitlab-ci">Cache vs Artifacts</a></span> <span class="rm-index-sub-desc">Regenerable speed-ups versus outputs that later stages actually depend on.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#gitlab-ci">Rules</a></span> <span class="rm-index-sub-desc">Conditional inclusion with if/changes/when — and why it replaced only/except.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#gitlab-ci">Runners &amp; Executors</a></span> <span class="rm-index-sub-desc">docker, kubernetes and shell executors, and tag-based job routing.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/cicd/#argocd--gitops">ArgoCD &amp; GitOps</a></h3>
        <p class="rm-index-desc">Git as the source of truth for what's running, with an in-cluster agent reconciling continuously.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#argocd--gitops">GitOps Principles</a></span> <span class="rm-index-sub-desc">Declarative, versioned, pulled automatically, continuously reconciled.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#argocd--gitops">How ArgoCD Works</a></span> <span class="rm-index-sub-desc">Applications, sync status, drift detection and rollback to any previous sync.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#argocd--gitops">Push vs Pull Deployment</a></span> <span class="rm-index-sub-desc">Why an in-cluster agent means CI never needs production credentials.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#argocd--gitops">App Repo vs Config Repo</a></span> <span class="rm-index-sub-desc">Separating source from manifests, and how the image tag bump triggers a deploy.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#argocd--gitops">Secrets in GitOps</a></span> <span class="rm-index-sub-desc">Sealed Secrets, External Secrets Operator and SOPS — keeping values out of Git.</span></li>
        </ul>
      </li>
      <li class="rm-index-group">
        <h3 class="rm-index-heading"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">CI/CD for Data Pipelines</a></h3>
        <p class="rm-index-desc">The part that's genuinely different: external state, data-dependent correctness and delayed feedback.</p>
        <ul class="rm-index-subs">
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">How Data CI/CD Differs</a></span> <span class="rm-index-sub-desc">Reverting code doesn't undo rows — plus data-dependent correctness and slow feedback.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Tests for Data Pipelines</a></span> <span class="rm-index-sub-desc">Unit, DAG validation, integration, data quality, schema contracts and idempotency.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Deploying dbt</a></span> <span class="rm-index-sub-desc">PR schemas, state:modified+ with --defer, and source freshness checks.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Deploying Airflow DAGs</a></span> <span class="rm-index-sub-desc">git-sync, baked images or object storage — and why DAG validation is mandatory.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Testing at Production Scale</a></span> <span class="rm-index-sub-desc">Representative sampling, zero-copy clones, deferred builds and synthetic data.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Recovering from Bad Data</a></span> <span class="rm-index-sub-desc">Stop, revert, assess blast radius, communicate, restore or backfill, then cascade.</span></li>
          <li><span class="rm-index-sub-label"><a href="/level-1-foundations/cicd/#cicd-for-data-pipelines">Environment Strategy</a></span> <span class="rm-index-sub-desc">Separate databases or accounts, per-developer schemas, and promotion by re-tagging.</span></li>
        </ul>
      </li>
    </ul>
  </section>
  <script type="application/json" id="rm-data" set:html={JSON.stringify(ROADMAP_DATA)}></script>
</StarlightPage>

<style is:global>
  @import "/src/styles/roadmap.css";
</style>

<script>
const ROADMAP = JSON.parse(document.getElementById("rm-data").textContent);

const ICON_PENDING    = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/></svg>`;
const ICON_INPROGRESS = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="8 5 8 8 10 10"/></svg>`;
const ICON_DONE       = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><polyline points="5.5 8.5 7 10 10.5 6"/></svg>`;
const ICON_ARROW      = `<svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="10" y1="0" x2="10" y2="20"/><polyline points="5 15 10 22 15 15"/></svg>`;
const ICON_CHEVRON    = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 5 7 9 11 5"/></svg>`;
function iconFor(s: string) { return s==="done"?ICON_DONE:s==="inprogress"?ICON_INPROGRESS:ICON_PENDING; }

const KEY = "cicd_roadmap_v1";
function load(): Record<string,string> { try { return JSON.parse(localStorage.getItem(KEY)||"{}"); } catch { return {}; } }
function save(s: Record<string,string>) { localStorage.setItem(KEY, JSON.stringify(s)); }
let state = load();
let collapsedIds = new Set();
function getS(id: string) { return state[id]||"pending"; }

function allIds() {
  const ids: string[] = [];
  for (const t of ROADMAP) { ids.push(t.id); for (const s of t.subs) ids.push(s.id); }
  return ids;
}

function refreshProgress() {
  const ids = allIds();
  const done = ids.filter(id => getS(id)==="done").length;
  const pct = ids.length ? Math.round((done/ids.length)*100) : 0;
  const bar = document.getElementById("rm-prog-bar");
  const pctEl = document.getElementById("rm-prog-pct");
  if (bar) bar.style.width = `${pct}%`;
  if (pctEl) pctEl.textContent = `${pct}%`;
}

function buildFlow() {
  const flow = document.getElementById("rm-flow");
  if (!flow) return;
  flow.innerHTML = "";
  ROADMAP.forEach((topic, ti) => {
    const s = getS(topic.id);
    const isCollapsed = collapsedIds.has(topic.id);
    const topicEl = document.createElement("div");
    topicEl.className = `rm-topic-node${s!=="pending"?` is-${s}`:""}${isCollapsed?" is-collapsed":""}`;
    topicEl.dataset.id = topic.id;
    topicEl.innerHTML = `<span class="rm-topic-icon">${iconFor(s)}</span><span class="rm-topic-label">${topic.label}</span>${topic.subs.length?`<span class="rm-count-badge">${topic.subs.length}</span>`:""}<span class="rm-chevron">${ICON_CHEVRON}</span>`;
    topicEl.addEventListener("click", () => openPanel(topic.id, "topic"));
    if (topic.subs.length > 0) {
      const chevronEl = topicEl.querySelector(".rm-chevron");
      chevronEl?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (collapsedIds.has(topic.id)) collapsedIds.delete(topic.id); else collapsedIds.add(topic.id);
        buildFlow();
      });
    }
    flow.appendChild(topicEl);
    if (topic.subs.length > 0 && !isCollapsed) {
      const group = document.createElement("div");
      group.className = "rm-sub-group";
      for (const sub of topic.subs) {
        const ss = getS(sub.id);
        const subEl = document.createElement("div");
        subEl.className = `rm-sub-node${ss!=="pending"?` is-${ss}`:""}`;
        subEl.dataset.id = sub.id;
        subEl.innerHTML = `<span class="rm-sub-icon">${iconFor(ss)}</span><span class="rm-sub-label">${sub.label}</span>`;
        subEl.addEventListener("click", () => openPanel(sub.id, "subtopic", topic.id));
        group.appendChild(subEl);
      }
      flow.appendChild(group);
    }
    if (ti < ROADMAP.length-1) {
      const arrow = document.createElement("div");
      arrow.className = "rm-arrow";
      arrow.innerHTML = ICON_ARROW;
      flow.appendChild(arrow);
    }
  });
}

let activeId: string|null = null, activeParent: string|null = null;
function findItem(id: string): any {
  for (const t of ROADMAP) { if (t.id===id) return {...t,type:"topic"}; for (const s of t.subs) { if (s.id===id) return {...s,type:"subtopic"}; } }
  return null;
}

function openPanel(id: string, type: string, parentId?: string) {
  activeId = id; activeParent = parentId??null;
  const item = findItem(id); if (!item) return;
  const badge = document.getElementById("rm-panel-badge")!;
  const title = document.getElementById("rm-panel-title")!;
  const body  = document.getElementById("rm-panel-body")!;
  badge.textContent = type==="topic"?"Topic":"Subtopic";
  badge.className   = `rm-panel-badge is-${type}`;
  title.textContent = item.label;
  body.innerHTML    = `<p class="rm-panel-desc">${item.desc}</p>` + (item.link ? `<a href="${item.link}" class="rm-read-more">Read more →</a>` : "");
  if (type==="topic" && item.subs?.length>0) {
    const sublist = document.createElement("div");
    sublist.className = "rm-panel-sublist";
    sublist.innerHTML = `<p class="rm-panel-sublist-title">Subtopics (${item.subs.length})</p>`;
    for (const sub of item.subs) {
      const ss = getS(sub.id);
      const row = document.createElement("div");
      row.className = `rm-panel-subitem${ss!=="pending"?` is-${ss}`:""}`;
      row.dataset.subId = sub.id;
      row.innerHTML = `<span class="rm-panel-subitem-icon">${iconFor(ss)}</span><span class="rm-panel-subitem-label">${sub.label}</span><span class="rm-panel-subitem-tag">${ss}</span>`;
      row.addEventListener("click", e => { e.stopPropagation(); openPanel(sub.id,"subtopic",id); });
      sublist.appendChild(row);
    }
    body.appendChild(sublist);
  }
  syncBtns();
  document.getElementById("rm-drawer")!.classList.add("is-open");
  if (document.body.classList.contains("page-chat-open")) {
    document.body.classList.remove("page-chat-open");
    try { sessionStorage.setItem("page-chat-open", "0"); } catch (_) {}
    document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
  }
  document.body.style.overflow = "hidden";
}

function closePanel() {
  document.getElementById("rm-drawer")!.classList.remove("is-open");
  document.body.style.overflow = "";
  activeId = activeParent = null;
}

function syncBtns() {
  if (!activeId) return;
  const s = getS(activeId);
  const sel = document.getElementById("rm-status-select") as HTMLSelectElement;
  const dot = document.getElementById("rm-status-dot");
  if (sel) { sel.value = s; sel.className = `rm-status-select${s !== "pending" ? ` is-${s}` : ""}`; }
  if (dot) dot.className = `rm-status-dot${s !== "pending" ? ` is-${s}` : ""}`;
}

function setStatus(id: string, s: string) {
  state[id] = s; save(state); buildFlow(); refreshProgress(); syncBtns();
  const row = document.querySelector<HTMLElement>(`.rm-panel-subitem[data-sub-id="${id}"]`);
  if (row) {
    row.className = `rm-panel-subitem${s!=="pending"?` is-${s}`:""}`;
    row.dataset.subId = id;
    const icon = row.querySelector(".rm-panel-subitem-icon"); const tag = row.querySelector(".rm-panel-subitem-tag");
    if (icon) icon.innerHTML = iconFor(s); if (tag) tag.textContent = s;
  }
}

buildFlow(); refreshProgress();
document.body.appendChild(document.getElementById("rm-drawer")!);
document.getElementById("rm-panel-close")?.addEventListener("click", closePanel);
document.getElementById("rm-backdrop")?.addEventListener("click", closePanel);
document.addEventListener("keydown", e => { if (e.key==="Escape") closePanel(); });
document.body.addEventListener("page-chat-toggle", () => {
  if (document.body.classList.contains("page-chat-open")) closePanel();
});
document.getElementById("rm-status-select")?.addEventListener("change", (e) => {
  if (activeId) setStatus(activeId, (e.target as HTMLSelectElement).value);
});
</script>
